{
  "name": "careerhound-backend",
  "version": "1.0.0",
  "description": "Career Hound API Backend with Fastify, Dodo Payments, Gemini AI & Playwright Auto-Apply",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "better-auth migrate --yes",
    "db:generate": "better-auth generate",
    "db:seed": "node src/db/seedJobs.js",
    "db:setup-neon": "node src/scripts/setupNeon.js"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.5",
    "@better-auth/mcp": "^1.7.5",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/sensible": "^6.0.1",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.5",
    "bullmq": "^5.34.4",
    "dodopayments": "^1.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.50.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
