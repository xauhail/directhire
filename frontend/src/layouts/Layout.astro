---
import SEOHead from "../components/seo/SEOHead.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import StickyCTA from "../components/common/StickyCTA.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  headerVariant?: "light" | "transparent";
  hideStickyCTA?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  jsonLd,
  headerVariant = "light",
  hideStickyCTA = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-canvas">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      jsonLd={jsonLd}
    />
  </head>
  <body
    class="min-h-screen flex flex-col antialiased text-slate-900 bg-canvas selection:bg-blue-600 selection:text-white"
  >
    <!-- Global Sticky Top Conversion Banner -->
    {!hideStickyCTA && <StickyCTA />}

    <!-- Header Navigation -->
    <Header variant={headerVariant} />

    <!-- Main Content Body -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Direct Secure Checkout Redirection (No Popup Modal) -->
    <script>
      function resetCheckoutButtons() {
        document.querySelectorAll("[data-trigger-checkout]").forEach((el) => {
          const btn = el as HTMLButtonElement;
          const orig = btn.getAttribute("data-original-html");
          if (orig) {
            btn.innerHTML = orig;
            btn.removeAttribute("disabled");
          }
        });
      }

      // Restore button state whenever the user navigates back from checkout
      window.addEventListener("pageshow", () => resetCheckoutButtons());
      window.addEventListener("focus", () => resetCheckoutButtons());
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") resetCheckoutButtons();
      });

      // Save initial button HTML on load
      document.querySelectorAll("[data-trigger-checkout]").forEach((el) => {
        const btn = el as HTMLButtonElement;
        if (!btn.getAttribute("data-original-html")) {
          btn.setAttribute("data-original-html", btn.innerHTML);
        }
      });

      let isCheckoutInFlight = false;

      (window as any).triggerCheckout = async function (
        planTier = "monthly",
        clickedBtn?: HTMLButtonElement | null,
      ) {
        if (isCheckoutInFlight) return; // Prevent duplicate race-condition clicks
        isCheckoutInFlight = true;

        const activeBtn =
          clickedBtn || (document.activeElement as HTMLButtonElement | null);
        const originalContent = activeBtn
          ? activeBtn.getAttribute("data-original-html") || activeBtn.innerHTML
          : "";
        if (activeBtn) {
          activeBtn.setAttribute("disabled", "true");
          activeBtn.innerHTML =
            '<span class="inline-flex items-center justify-center gap-2"><svg class="animate-spin h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span>Loading Secure Checkout...</span></span>';
        }

        try {
          let email = "";
          try {
            const userStr =
              localStorage.getItem("jn_user") ||
              localStorage.getItem("ch_user");
            if (userStr) {
              const u = JSON.parse(userStr);
              if (u?.email) email = u.email;
            }
          } catch (_) {}

          // Generate unique client-side idempotency token
          const idempotencyKey =
            typeof crypto !== "undefined" && crypto.randomUUID
              ? crypto.randomUUID()
              : `idemp_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;

          const checkoutEndpoint =
            typeof window !== "undefined" &&
            (window.location.hostname === "localhost" ||
              window.location.hostname === "127.0.0.1")
              ? "http://localhost:4000/api/checkout"
              : "/api/checkout";

          const res = await fetch(checkoutEndpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Idempotency-Key": idempotencyKey,
            },
            body: JSON.stringify({ planTier, email, idempotencyKey }),
          });

          let data: any = null;
          try {
            const rawText = await res.text();
            data = rawText ? JSON.parse(rawText) : null;
          } catch (_) {
            data = null;
          }

          if (data?.checkoutUrl) {
            // Brief delay before redirect; reset flag if user navigates back
            setTimeout(() => {
              isCheckoutInFlight = false;
              resetCheckoutButtons();
            }, 1500);
            window.location.href = data.checkoutUrl;
          } else {
            throw new Error(
              data?.message ||
                data?.error ||
                `Failed to initialize checkout session (Server status ${res.status}).`,
            );
          }
        } catch (err: any) {
          isCheckoutInFlight = false;
          resetCheckoutButtons();
          alert(err.message || "Unable to open secure checkout.");
        }
      };

      document.querySelectorAll("[data-trigger-checkout]").forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault();
          const tier = el.getAttribute("data-tier") || "monthly";
          (window as any).triggerCheckout(tier, el as HTMLButtonElement);
        });
      });
    </script>
  </body>
</html>
