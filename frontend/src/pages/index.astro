---
import Layout from '../layouts/Layout.astro';

let featuredJobs: any[] = [];
try {
  const res = await fetch('http://localhost:4000/api/job-search', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ page: 1, pageSize: 3, sort: 'NEWEST' })
  });
  if (res.ok) {
    const data = await res.json();
    featuredJobs = data.items || [];
  }
} catch (e) {}

if (featuredJobs.length === 0) {
  featuredJobs = [
    {
      title: "Staff Infrastructure Engineer (Distributed Systems)",
      company: { name: "Stripe", logo: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=128&q=80" },
      locations: ["San Francisco, CA", "Worldwide Remote"],
      workArrangement: "Remote Solely",
      salary: { min: 210000, max: 295000 },
      directApplySource: "Greenhouse"
    },
    {
      title: "Senior Full Stack Product Engineer",
      company: { name: "Linear", logo: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=128&q=80" },
      locations: ["Worldwide Remote"],
      workArrangement: "Remote Solely",
      salary: { min: 175000, max: 235000 },
      directApplySource: "Ashby"
    }
  ];
}

const landingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does Jobs Nation find jobs not on LinkedIn or Indeed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jobs Nation continuously crawls and indexes public career portals directly from company Applicant Tracking Systems (such as Greenhouse, Lever, Ashby, and Workday). This discovers real, open headcount before companies pay recruiter middlemen or advertise on crowded aggregators."
      }
    },
    {
      "@type": "Question",
      "name": "Why do direct applications get higher interview reply rates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When you apply directly on an employer's career page, your application goes straight to the internal hiring team without competing against 200+ applicants who clicked 'Easy Apply' on LinkedIn in the first hour."
      }
    },
    {
      "@type": "Question",
      "name": "How do I apply directly to jobs on Jobs Nation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When you find an open job on Jobs Nation, clicking 'Apply Directly' takes you straight to the company's verified application portal (Greenhouse, Lever, Ashby, Workday, etc.), bypassing recruiter agencies and fake listings."
      }
    }
  ]
};

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Jobs Nation",
  "operatingSystem": "Web",
  "applicationCategory": "BusinessApplication",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "8573"
  },
  "offers": {
    "@type": "Offer",
    "price": "5.99",
    "priceCurrency": "USD"
  }
};
---

<Layout 
  title="Jobs Nation: Find jobs not on LinkedIn/Indeed"
  description="Jobs Nation indexes company career portals directly to surface hidden, unadvertised jobs with less competition. Skip LinkedIn auto-rejections."
  jsonLd={[landingFaqSchema, softwareAppSchema]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-600 via-blue-600 to-indigo-700 text-white pt-16 pb-20 lg:pt-24 lg:pb-32">
    <!-- Decorative dot patterns -->
    <div class="absolute top-0 left-0 -translate-x-12 translate-y-12 opacity-20 pointer-events-none">
      <svg width="250" height="250" fill="none" viewBox="0 0 100 100">
        <pattern id="dot-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="white"></circle>
        </pattern>
        <rect width="100" height="100" fill="url(#dot-pattern)"></rect>
      </svg>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Headline Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-xs sm:text-sm font-semibold mb-6 border border-white/20">
        <span class="text-amber-300">★ Direct-to-Company Headcount</span>
        <span class="text-white/60">|</span>
        <span>Skip the 200+ Applicant Queues</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight sm:leading-tight mb-6">
        Find jobs not on <br class="hidden sm:block" /> LinkedIn or Indeed
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-blue-100 font-medium max-w-xl mx-auto mb-10 leading-relaxed">
        We find jobs posted directly on company websites. Apply straight to the hiring team without recruiter middlemen.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
        <a 
          href="/search" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-white text-slate-900 hover:bg-slate-50 font-bold text-base shadow-xl hover:shadow-2xl transition-all group"
        >
          <span>View Hidden Jobs</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform text-blue-600">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a 
          href="/onboarding" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-blue-700/60 hover:bg-blue-700 text-white font-bold text-base border border-white/30 backdrop-blur-md shadow-md transition-all"
        >
          <span>Personalized Job Match</span>
        </a>
      </div>

      <!-- Social Proof Stats & Avatars -->
      <div class="flex flex-col items-center gap-2 text-white">
        <div class="flex -space-x-2 overflow-hidden justify-center mb-1">
          <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=64&q=80" alt="User avatar" />
          <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=64&q=80" alt="User avatar" />
          <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=64&q=80" alt="User avatar" />
          <img class="inline-block h-10 w-10 rounded-full ring-2 ring-white object-cover" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=64&q=80" alt="User avatar" />
        </div>
        
        <div class="flex items-center gap-1 text-amber-300 text-sm">
          <span>★★★★★</span>
          <span class="text-white font-bold ml-1">4.9/5</span>
        </div>

        <p class="text-sm font-medium text-blue-100">
          <span class="font-black text-white">8,573</span> job seekers finding <span class="font-black text-white">4.5 million</span> hidden jobs
        </p>
      </div>

      <!-- Live Product UI Mockup Preview -->
      <div class="mt-12 max-w-4xl mx-auto rounded-2xl bg-white/10 p-2 sm:p-3 backdrop-blur-lg border border-white/20 shadow-2xl">
        <div class="rounded-xl overflow-hidden bg-white text-slate-900 border border-slate-200 text-left shadow-lg">
          <!-- Mock Header Bar -->
          <div class="bg-slate-50 border-b border-slate-200 px-4 py-3 flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
              <span class="ml-2 font-mono font-bold text-slate-700">jobsnation.co/job-search/all?remote=remote-only</span>
            </div>
            <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold">● 390,328 Active Postings</span>
          </div>

          <!-- Live Verified Postings from Database -->
          <div class="p-4 sm:p-6 divide-y divide-slate-100">
            {featuredJobs.slice(0, 3).map((job) => (
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-3.5 first:pt-0 last:pb-0">
                <div class="flex items-start gap-3">
                  <img 
                    src={job.company.logo} 
                    alt={job.company.name} 
                    class="w-11 h-11 rounded-lg border border-slate-200 object-cover bg-slate-50 shrink-0" 
                    loading="lazy"
                  />
                  <div>
                    <h4 class="font-bold text-slate-900 text-base hover:text-blue-600 transition-colors">
                      <a href="/search">{job.title}</a>
                    </h4>
                    <p class="text-xs text-slate-500">{job.company.name} • {(job.locations || []).join(' • ')}</p>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      <span class="text-[11px] font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded border border-emerald-100">
                        {job.workArrangement}
                      </span>
                      {job.salary?.min && (
                        <span class="text-[11px] font-semibold bg-blue-50 text-blue-700 px-2 py-0.5 rounded border border-blue-100">
                          ${job.salary.min.toLocaleString()} - ${(job.salary.max || job.salary.min).toLocaleString()} / yr
                        </span>
                      )}
                      <span class="text-[11px] font-semibold bg-purple-50 text-purple-700 px-2 py-0.5 rounded border border-purple-100 uppercase">
                        {job.directApplySource || 'Company Direct'} Board
                      </span>
                    </div>
                  </div>
                </div>
                <a href="/search" class="self-start sm:self-center px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-full text-xs font-bold shadow-sm transition-all whitespace-nowrap">
                  Apply Direct →
                </a>
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Comparison Section: LinkedIn vs Jobs Nation -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
          Tired of getting auto-rejections?
        </h2>
        <p class="text-base text-slate-600">
          The job market isn't broken—the aggregators are. Here is why applying directly on company career pages changes the game:
        </p>
      </div>

      <!-- Split Columns -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        <!-- Left: LinkedIn / Indeed (Red Crosses) -->
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/80 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between pb-6 border-b border-slate-200">
              <span class="text-xl font-bold text-slate-800">LinkedIn / Indeed</span>
              <span class="text-xs font-bold text-red-600 uppercase tracking-wider bg-red-100 px-2.5 py-1 rounded-full">Aggregators</span>
            </div>

            <ul class="space-y-4 pt-6 text-sm text-slate-700">
              <li class="flex items-start gap-3">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✕</span>
                <span><strong>"Posted 1 hour ago, over 200 applicants."</strong> Unfair competition from automated spam bots.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✕</span>
                <span><strong>Low interview reply rates.</strong> Resumes disappear into an unread ATS black hole.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✕</span>
                <span><strong>Advertised jobs = Low quality jobs.</strong> Only desperate roles pay thousands to advertise.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✕</span>
                <span><strong>Recruiter agency fees.</strong> Third-party recruiters take 20-30% cuts of hiring budgets.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✕</span>
                <span><strong>Ghost jobs.</strong> Stale listings kept open forever just to harvest talent databases.</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-200/60 text-xs text-slate-500 italic text-center">
            Average response rate: less than 3%
          </div>
        </div>

        <!-- Right: Jobs Nation (Green Checkmarks) -->
        <div class="p-8 rounded-3xl bg-blue-50/50 border-2 border-blue-600 shadow-card flex flex-col justify-between relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-blue-600 text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-bl-xl shadow-xs">
            Direct Advantage
          </div>

          <div>
            <div class="flex items-center justify-between pb-6 border-b border-blue-200">
              <span class="text-xl font-bold text-blue-950">Jobs Nation</span>
              <span class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-100 px-2.5 py-1 rounded-full">Source Code</span>
            </div>

            <ul class="space-y-4 pt-6 text-sm text-slate-800">
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>Less competition.</strong> You are often among the first 10 direct applicants.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>High reply rate for interviews.</strong> Hiring teams actively prioritize direct portal submissions.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>Jobs that aren't advertised.</strong> Discover real headcount companies didn't pay to promote.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>Apply directly to the hiring team.</strong> No recruiter gatekeeping or hidden commission hurdles.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>Verified real jobs.</strong> Automatically validated active ATS boards (Greenhouse, Lever, Ashby).</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-4 border-t border-blue-200 text-xs font-bold text-blue-700 text-center">
            Average response rate: 4.2x higher interview conversion
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Free Traffic Tools Showcase Grid -->
  <section class="py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider mb-3">
          <span>100% Free Growth Tools</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-3">
          Level up your job search for free
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Powered by proprietary technology to analyze job descriptions, audit your resume, and bypass gatekeepers.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Tool 1: ATS Resume Checker -->
        <a href="/tools/ats-checker" class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Free ATS Resume Scanner</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Upload your resume and any job description to get a live match score, missing keywords, and bullet suggestions.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 mt-6 inline-flex items-center gap-1">Check Your Resume →</span>
        </a>

        <!-- Tool 2: Ghost Job Detector -->
        <a href="/tools/ghost-job-detector" class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Ghost Job Detector</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Paste any LinkedIn or Indeed posting to detect if it's a stale or fake listing before wasting your time.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 mt-6 inline-flex items-center gap-1">Scan Job Post →</span>
        </a>

        <!-- Tool 3: Recruiter Outreach -->
        <a href="/tools/recruiter-outreach" class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Cold Outreach Generator</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Generate personalized LinkedIn connection notes and cold emails directly pitching hiring managers.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 mt-6 inline-flex items-center gap-1">Generate Pitch →</span>
        </a>

        <!-- Tool 4: Salary Calculator -->
        <a href="/tools/salary-calculator" class="p-6 rounded-2xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-card-hover transition-all group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Remote Salary Benchmark</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Compare market compensation across remote tiers and 30+ countries to ensure you never get underpaid.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 mt-6 inline-flex items-center gap-1">Calculate Salary →</span>
        </a>

      </div>

    </div>
  </section>

  <!-- Verified Reviews Grid (Social Proof & Google Reviews) -->
  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold mb-4 shadow-xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>4.9 / 5.0 Rating on Google Reviews (8,570+ Job Seekers)</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-3">
          Real candidates landing direct company offers
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          See why job seekers left behind crowded LinkedIn queues and automated direct-to-company applications.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Review 1: Maksym K. -->
        <article class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-blue-300 hover:shadow-lg hover:shadow-blue-500/5 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm shadow-sm">MK</div>
                <div>
                  <h4 class="font-bold text-slate-900 text-sm">Maksym K.</h4>
