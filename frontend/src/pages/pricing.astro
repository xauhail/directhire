---
import Layout from '../layouts/Layout.astro';

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Career Hound Job Search Platform",
  "description": "Direct company job search and verified ATS application platform.",
  "offers": [
    {
      "@type": "Offer",
      "name": "Weekly Sprint Pass",
      "price": "9.99",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "priceValidUntil": "2027-12-31"
    },
    {
      "@type": "Offer",
      "name": "Monthly Pro Membership",
      "price": "29.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "priceValidUntil": "2027-12-31"
    },
    {
      "@type": "Offer",
      "name": "1-Year Unlimited Pass",
      "price": "99.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "priceValidUntil": "2027-12-31"
    }
  ]
};
---

<Layout
  title="Pricing & Plans | Career Hound"
  description="Transparent, zero-commitment pricing. Choose between Weekly Pass, Monthly Pro, or an annual 1-Year Pass to unlock direct company jobs and unlimited direct ATS application links."
  jsonLd={pricingSchema}
>
  <!-- Hero Section -->
  <section class="relative pt-16 pb-16 md:pt-24 md:pb-24 overflow-hidden bg-gradient-to-b from-blue-50/70 via-white to-slate-50 border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-pattern opacity-50 pointer-events-none"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold uppercase tracking-wider shadow-xs">
        <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Transparent, High-ROI Career Plans
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
        Land Interviews <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 bg-clip-text text-transparent">4.2x Faster</span>.<br class="hidden sm:inline" />
        Stop Applying into the Void.
      </h1>

      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Apply directly on company Greenhouse, Lever & Ashby career pages before roles get flooded by 200+ LinkedIn easy-applies. Zero hidden fees. 7-day money-back guarantee.
      </p>

      <!-- Trust Badges Bar -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500">
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          7-Day 100% Money-Back Guarantee
        </span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Encrypted Dodo Payments Billing
        </span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center gap-1.5 text-slate-700">
          <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          Rated 4.9/5 by 8,570+ Job Seekers
        </span>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Section -->
  <section class="py-16 md:py-24 bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Interactive Account Status Banner (matches account#subscription) -->
      <div id="pricing-user-banner" class="max-w-6xl mx-auto mb-10">
        <!-- Default: Visitor Free Plan Callout -->
        <div id="pricing-banner-visitor" class="bg-gradient-to-r from-blue-50 via-indigo-50/50 to-slate-50 border border-blue-200/80 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-blue-700">Free Explorer Plan Included</p>
              <h4 class="text-sm font-extrabold text-slate-900 mt-0.5">Looking to explore verified jobs first?</h4>
              <p class="text-xs text-slate-500 mt-0.5">Get 10 searches/day, free ATS resume scanner & Ghost Job Detector — no credit card needed.</p>
            </div>
          </div>
          <a
            href="/onboarding"
            class="px-5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-bold text-xs border border-slate-300 shadow-xs transition-all flex items-center justify-center gap-1.5 shrink-0"
          >
            <span>Start Free Forever</span>
            <span>→</span>
          </a>
        </div>

        <!-- Logged-in Free User Banner (revealed client-side) -->
        <div id="pricing-banner-free-user" class="hidden bg-gradient-to-r from-blue-600 to-indigo-700 text-white rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white/20 border border-white/30 text-white flex items-center justify-center font-bold text-base shrink-0">
              <span id="banner-user-initial">U</span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded-full">Current Plan: Free</span>
                <span id="banner-user-email" class="text-xs text-blue-100 font-medium truncate max-w-[200px] sm:max-w-none">user@example.com</span>
              </div>
              <h4 class="text-sm font-extrabold mt-1">Limited to 10 searches/day • Direct ATS application links locked</h4>
              <p class="text-xs text-blue-100 mt-0.5">Upgrade below to unlock unlimited direct ATS links, cover letter generation & instant alerts.</p>
            </div>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <a href="/account#subscription" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/20 transition-all text-center">
              View Account
            </a>
          </div>
        </div>

        <!-- Logged-in Subscribed Pro User Banner (revealed client-side) -->
        <div id="pricing-banner-pro-user" class="hidden bg-gradient-to-r from-emerald-600 via-teal-600 to-blue-700 text-white rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white/20 border border-white/30 text-white flex items-center justify-center text-xl shrink-0">
              ⭐
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded-full">Active Subscription</span>
                <span id="banner-pro-plan-badge" class="text-xs font-black text-amber-300">Pro Monthly</span>
              </div>
              <h4 class="text-sm font-extrabold mt-1">You have full unlimited access to all verified direct company postings!</h4>
              <p class="text-xs text-emerald-100 mt-0.5">Manage your billing, invoices, or cancellation anytime in your dashboard.</p>
            </div>
          </div>
          <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
            <a href="/account#subscription" class="px-4 py-2.5 rounded-xl bg-white text-emerald-800 font-extrabold text-xs shadow-xs hover:bg-emerald-50 transition-all text-center">
              Manage Subscription →
            </a>
            <a href="/job-search/all" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/20 transition-all text-center">
              Search Jobs
            </a>
          </div>
        </div>
      </div>

      <!-- The 3 Aligned Subscription Cards (matching account#subscription) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch max-w-6xl mx-auto">
        
        <!-- Plan 1: Weekly Pass -->
        <div class="rounded-3xl p-8 border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xl transition-all flex flex-col justify-between h-full relative">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 px-3 py-1 rounded-full">Weekly Pass</span>
            </div>
            <h3 class="text-2xl font-black text-slate-900">Weekly Pass</h3>
            <p class="text-xs text-slate-500 mt-1 min-h-[44px] flex items-center">7-day high-intensity interview sprint with full Pro direct ATS job access.</p>
            
            <div class="mt-6 mb-6 flex items-baseline gap-1 min-h-[64px] border-b border-slate-100 pb-6">
              <span class="text-4xl sm:text-5xl font-black text-slate-900">$9.99</span>
              <span class="text-sm font-semibold text-slate-500">/ week</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 text-xs text-slate-700 min-h-[220px]">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Browse 100,000+ verified direct company postings</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Direct company ATS application links (Greenhouse, Lever)</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>1-Click customized cover letter generator per target job</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>ATS match score & keyword gap analysis calculator</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Ghost Job Detector with risk verdict</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Cancel anytime with 1-click in account dashboard</span>
              </li>
            </ul>
          </div>

          <div class="mt-auto pt-6 border-t border-slate-100 space-y-2">
            <button
              type="button"
              data-trigger-checkout
              data-tier="weekly"
              class="w-full py-4 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-black text-sm tracking-wide shadow-md hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Get Weekly Pass</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
            <p class="text-[11px] text-center text-slate-400 font-medium">Auto-renews at $9.99/week • Cancel anytime</p>
          </div>
        </div>

        <!-- Plan 2: Monthly Pro (Popular - Matches Account Pro Card) -->
        <div class="rounded-3xl p-8 border-2 border-blue-600 bg-blue-600 text-white shadow-xl shadow-blue-600/25 flex flex-col justify-between h-full relative ring-4 ring-blue-100 transform lg:-translate-y-2 transition-all">
          <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-amber-400 text-slate-950 text-[11px] font-black uppercase tracking-widest px-4 py-1 rounded-full shadow-md">
            POPULAR
          </span>

          <div>
            <div class="flex items-center justify-between mb-4 mt-2">
              <span class="text-xs font-black uppercase tracking-wider text-blue-100 bg-white/20 px-3 py-1 rounded-full">Monthly Pro</span>
            </div>
            <h3 class="text-2xl font-black text-white">Monthly Pro</h3>
            <p class="text-xs text-blue-100 mt-1 min-h-[44px] flex items-center">The proven candidate plan to bypass recruiters and land interviews 4.2x faster.</p>
            
            <div class="mt-6 mb-6 flex items-baseline gap-1 min-h-[64px] border-b border-white/20 pb-6">
              <span class="text-4xl sm:text-5xl font-black text-white">$29</span>
              <span class="text-sm font-semibold text-blue-200">/ month</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 text-xs text-blue-50 min-h-[220px]">
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-amber-300 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span><strong>Everything in Weekly Pass</strong></span>
              </li>
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Direct application URLs (Greenhouse, Lever, Ashby, Workday)</span>
              </li>
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Unlimited direct company applications across 390,000+ jobs</span>
              </li>
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Application tracking & status management dashboard</span>
              </li>
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Daily early-bird alerts for unadvertised postings</span>
              </li>
              <li class="flex items-start gap-2.5 font-medium">
                <svg class="w-4 h-4 text-amber-300 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="text-amber-200 font-bold">100% Money-back guarantee for 7 full days</span>
              </li>
            </ul>
          </div>

          <div class="mt-auto pt-6 border-t border-white/20 space-y-2">
            <button
              type="button"
              data-trigger-checkout
              data-tier="monthly"
              class="w-full py-4 px-6 rounded-xl bg-white hover:bg-blue-50 text-blue-700 font-black text-sm tracking-wide shadow-lg hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Go Pro Monthly</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
            <p class="text-[11px] text-center text-blue-100 font-medium">Cancel anytime in 1-click via dashboard</p>
          </div>
        </div>

        <!-- Plan 3: 1-Year Pass (Best Value) -->
        <div class="rounded-3xl p-8 border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xl transition-all flex flex-col justify-between h-full relative">
          <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-emerald-600 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow-sm">
            Save 71% • Annual Pass
          </span>

          <div>
            <div class="flex items-center justify-between mb-4 mt-2">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 px-3 py-1 rounded-full">1-Year Pass</span>
            </div>
            <h3 class="text-2xl font-black text-slate-900">1-Year Pass</h3>
            <p class="text-xs text-slate-500 mt-1 min-h-[44px] flex items-center">365 days of full unlimited access to direct company listings and alerts.</p>
            
            <div class="mt-6 mb-6 flex items-baseline gap-1 min-h-[64px] border-b border-slate-100 pb-6">
              <span class="text-4xl sm:text-5xl font-black text-slate-900">$99</span>
              <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider ml-1">/ year ($8.25/mo)</span>
            </div>

            <!-- Features -->
            <ul class="space-y-3.5 text-xs text-slate-700 min-h-[220px]">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span><strong>365 days of full Pro access across all features</strong></span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Unlimited direct company ATS applications</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Instant real-time alerts for unadvertised postings</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Priority VIP candidate queue for verified employer listings</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>Full access to all new product features for a whole year</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span class="font-bold text-emerald-700">Save $249/yr compared to paying monthly</span>
              </li>
            </ul>
          </div>

          <div class="mt-auto pt-6 border-t border-slate-100 space-y-2">
            <button
              type="button"
              data-trigger-checkout
              data-tier="yearly"
              class="w-full py-4 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-black text-sm tracking-wide shadow-md hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Get 1-Year Pass</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
            <p class="text-[11px] text-center text-slate-400 font-medium">Billed annually at $99 • 7-day money-back guarantee</p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ROI / Value Comparison Section -->
  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-3xl font-black text-slate-900 tracking-tight">Why Career Hound Pays for Itself</h2>
        <p class="text-sm text-slate-600">The average job search takes 5 months and over 200 hours. Here is how Career Hound flips the odds in your favor.</p>
      </div>

