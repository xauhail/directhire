<!-- Client Script to Sync Dynamic User State on Pricing Page -->
<script>
  import { authClient } from "../lib/auth-client.js";

  async function syncPricingUserState() {
    let currentUser: any = null;

    try {
      const { data: session } = await authClient.getSession();
      if (session?.user) {
        currentUser = session.user;
      }
    } catch (_) {}

    if (!currentUser) {
      try {
        const local = localStorage.getItem("ch_user");
        if (local) currentUser = JSON.parse(local);
      } catch (_) {}
    }

    const visitorBanner = document.getElementById("pricing-banner-visitor");
    const freeUserBanner = document.getElementById("pricing-banner-free-user");
    const proUserBanner = document.getElementById("pricing-banner-pro-user");

    if (!currentUser) {
      // Visitor state: keep visitor banner visible
      return;
    }

    const isSubscribed = Boolean(currentUser.isSubscribed || (currentUser.plan && currentUser.plan !== "free"));

    if (isSubscribed) {
      if (visitorBanner) visitorBanner.classList.add("hidden");
      if (freeUserBanner) freeUserBanner.classList.add("hidden");
      if (proUserBanner) {
        proUserBanner.classList.remove("hidden");
        const planBadge = document.getElementById("banner-pro-plan-badge");
        if (planBadge) {
          const p = currentUser.plan || "pro";
          planBadge.textContent = p === "pro_monthly" ? "Pro Monthly" : p === "yearly" ? "1-Year Pass" : "Pro Plan";
        }
      }

      // Highlight active plan button if applicable
      const userPlan = currentUser.plan || "monthly";
      const targetTier = userPlan === "pro_monthly" ? "monthly" : userPlan === "yearly" ? "yearly" : userPlan;
      const activeBtn = document.querySelector(`[data-trigger-checkout][data-tier="${targetTier}"]`);
      if (activeBtn) {
        activeBtn.innerHTML = `<span>✓ Current Active Plan</span>`;
        activeBtn.setAttribute("disabled", "true");
        activeBtn.classList.add("opacity-90", "cursor-default");
      }
    } else {
      // Logged-in Free user
      if (visitorBanner) visitorBanner.classList.add("hidden");
      if (proUserBanner) proUserBanner.classList.add("hidden");
      if (freeUserBanner) {
        freeUserBanner.classList.remove("hidden");
        const emailEl = document.getElementById("banner-user-email");
        const initialEl = document.getElementById("banner-user-initial");
        if (emailEl) emailEl.textContent = currentUser.email || "Active User";
        if (initialEl && (currentUser.name || currentUser.email)) {
          initialEl.textContent = (currentUser.name || currentUser.email)[0].toUpperCase();
        }
      }
    }
  }

  // Run on load and pageshow
  syncPricingUserState();
  window.addEventListener("pageshow", syncPricingUserState);
</script>
