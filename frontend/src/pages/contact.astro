---
import Layout from '../layouts/Layout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Us | Jobs Nation",
  "description": "Get in touch with Jobs Nation support for inquiries on direct-to-company job feeds, subscription billing, or saved jobs.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Jobs Nation",
    "email": "support@jobsnation.co",
    "url": "https://jobsnation.co"
  }
};
---

<Layout
  title="Contact Us | Jobs Nation"
  description="Need help with your Jobs Nation account, billing & subscription, or saved jobs? Our team replies in under 2 hours."
  jsonLd={contactSchema}
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50/60 via-white to-slate-50 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Support Team Online • Average reply time: under 2 hours
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        How can we <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 bg-clip-text text-transparent">help you today?</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Have questions about your direct job search, saved job alerts, or subscription billing? Send us a message or reach out directly.
      </p>
    </div>
  </section>

  <!-- Contact Workspace -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: Quick Contact Info Cards -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Direct Support Channels</h2>
            <p class="text-sm text-slate-500">
              We respond quickly to all customer questions, subscription requests, and bug reports.
            </p>
          </div>

          <!-- Email Support Card -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Customer Support</h3>
              <p class="text-xs text-slate-500 mt-0.5">For general inquiries, account support, and technical questions.</p>
              <a href="mailto:support@jobsnation.co" class="text-sm font-bold text-blue-600 hover:text-blue-700 hover:underline mt-2 inline-block">
                support@jobsnation.co
              </a>
            </div>
          </div>

          <!-- Billing & Payments Card -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <line x1="2" x2="22" y1="10" y2="10"></line>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Billing & Payments Support</h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Payments and subscriptions are securely processed with 256-bit SSL encryption.
              </p>
              <a href="mailto:billing@jobsnation.co" class="text-sm font-bold text-emerald-600 hover:text-emerald-700 hover:underline mt-2 inline-block">
                billing@jobsnation.co
              </a>
            </div>
          </div>

          <!-- Direct Company ATS Feed Card -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="20" x="4" y="2" rx="2" ry="2"></rect>
                <path d="M9 22v-4h6v4"></path>
                <path d="M8 6h.01"></path>
                <path d="M16 6h.01"></path>
                <path d="M12 6h.01"></path>
                <path d="M12 10h.01"></path>
                <path d="M12 14h.01"></path>
                <path d="M16 10h.01"></path>
                <path d="M16 14h.01"></path>
                <path d="M8 10h.01"></path>
                <path d="M8 14h.01"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Employer ATS Indexing</h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Want your Greenhouse, Lever, or Ashby board indexed directly on Jobs Nation?
              </p>
              <a href="mailto:partners@jobsnation.co" class="text-sm font-bold text-purple-600 hover:text-purple-700 hover:underline mt-2 inline-block">
                partners@jobsnation.co
              </a>
            </div>
          </div>

          <!-- 100% Direct Promise Banner -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900 to-indigo-950 text-white shadow-xl space-y-2">
            <span class="px-2.5 py-0.5 rounded-full bg-blue-800 text-blue-200 text-xs font-semibold">
              The Jobs Nation Guarantee
            </span>
            <h4 class="font-bold text-base">100% Direct Applications</h4>
            <p class="text-blue-200 text-xs leading-relaxed">
              Every job link connects directly to official employer career portals. No fake aggregator reposts, no recruiter middlemen.
            </p>
          </div>
        </div>

        <!-- Right: Interactive Contact Form -->
        <div class="lg:col-span-7 bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50 p-8 sm:p-10">
          <div class="mb-6">
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Send us a message</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Fill out the form below and our team will get back to you promptly.</p>
          </div>

          <form id="contactForm" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Name *</label>
                <input
                  type="text"
                  id="name"
                  required
                  placeholder="e.g. Alex Morgan"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Address *</label>
                <input
                  type="email"
                  id="email"
                  required
                  placeholder="you@company.com"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Topic / Inquiry Type</label>
              <select
                id="subject"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="Billing & Subscription">Billing & Subscription</option>
                <option value="Direct ATS Applications & Tracking">Direct ATS Applications & Tracking</option>
                <option value="Job Search Filters & Feeds">Job Search Filters & Feeds</option>
                <option value="Report Inactive / Closed Listing">Report Inactive / Closed Listing</option>
                <option value="General Question / Feature Request">General Question / Feature Request</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Message *</label>
              <textarea
                id="message"
                rows="5"
                required
                placeholder="How can we help? Provide any relevant details, account email, or job links..."
                class="w-full p-4 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 leading-relaxed"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submitContactBtn"
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-sm shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>

          <div id="contactSuccess" class="hidden mt-6 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-center space-y-2 animate-fade-in">
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-lg font-bold">
              ✓
            </div>
            <h4 class="font-bold text-sm">Message Sent Successfully!</h4>
            <p class="text-xs text-emerald-800">
              Thank you for reaching out. A confirmation has been sent to your email, and our team will get back to you shortly.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const btn = document.getElementById('submitContactBtn') as HTMLButtonElement;
  const successBox = document.getElementById('contactSuccess') as HTMLElement;

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.innerHTML = `
        <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
        Sending message...
      `;

      setTimeout(() => {
        form.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');
      }, 700);
    });
  }
</script>
