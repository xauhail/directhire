---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="My Account | Career Hound"
  description="Track your job applications, manage your profile, resume, and Career Hound subscription."
>
  <!-- Auth Guard: redirects to /login if not authenticated (handled client-side) -->
  <div id="auth-loading" class="min-h-[60vh] flex items-center justify-center">
    <div class="flex flex-col items-center gap-3">
      <div
        class="w-10 h-10 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin"
      >
      </div>
      <p class="text-sm text-slate-500 font-medium">Loading your account...</p>
    </div>
  </div>

  <!-- Main Dashboard (shown after auth check) -->
  <div id="dashboard" class="hidden">
    <!-- Dashboard Header Banner -->
    <div
      class="bg-gradient-to-r from-blue-600 via-blue-700 to-indigo-700 text-white"
    >
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
          <div class="flex items-center gap-4">
            <div
              id="user-avatar-wrapper"
              class="w-16 h-16 rounded-2xl bg-white/20 border-2 border-white/30 overflow-hidden flex items-center justify-center text-2xl font-black shrink-0"
            >
              <span id="user-initials">?</span>
            </div>
            <div>
              <h1
                id="user-greeting"
                class="text-2xl font-extrabold tracking-tight"
              >
                Loading...
              </h1>
              <p id="user-email-display" class="text-blue-200 text-sm mt-0.5">
              </p>
              <span
                id="user-plan-badge"
                class="inline-flex items-center gap-1 mt-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-white/20 border border-white/30 text-white"
              >
                Free Plan
              </span>
            </div>
          </div>
          <div class="flex items-center gap-3 flex-wrap">
            <a
              href="/job-search/all"
              class="px-4 py-2 rounded-full bg-white/20 hover:bg-white/30 text-white font-semibold text-sm border border-white/30 transition-all flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span>Search Jobs</span>
            </a>
            <button
              id="btn-logout"
              type="button"
              class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-all"
            >
              Sign Out
            </button>
          </div>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
          <div class="bg-white/10 rounded-2xl p-4 border border-white/20">
            <p
              class="text-xs text-blue-200 font-semibold uppercase tracking-wider"
            >
              Saved Jobs
            </p>
            <p id="stat-saved" class="text-3xl font-black mt-1">0</p>
          </div>
          <div class="bg-white/10 rounded-2xl p-4 border border-white/20">
            <p
              class="text-xs text-blue-200 font-semibold uppercase tracking-wider"
            >
              Applied
            </p>
            <p id="stat-applied" class="text-3xl font-black mt-1">0</p>
          </div>
          <div class="bg-white/10 rounded-2xl p-4 border border-white/20">
            <p
              class="text-xs text-blue-200 font-semibold uppercase tracking-wider"
            >
              Direct ATS
            </p>
            <p class="text-3xl font-black mt-1 text-emerald-300">100%</p>
          </div>
          <div class="bg-white/10 rounded-2xl p-4 border border-white/20">
            <p
              class="text-xs text-blue-200 font-semibold uppercase tracking-wider"
            >
              Plan
            </p>
            <p id="stat-plan" class="text-xl font-black mt-1 truncate">–</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-slate-200 bg-white sticky top-0 z-20 shadow-xs">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav
          class="flex gap-1 overflow-x-auto no-scrollbar -mb-px"
          role="tablist"
        >
          <button
            class="tab-btn active flex items-center gap-2 px-4 py-4 text-sm font-bold border-b-2 border-blue-600 text-blue-600 whitespace-nowrap shrink-0"
            data-tab="applications"
            role="tab"
          >
            Applications
          </button>
          <button
            class="tab-btn flex items-center gap-2 px-4 py-4 text-sm font-semibold border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap shrink-0 transition-colors"
            data-tab="saved"
            role="tab"
          >
            Saved Jobs
          </button>
          <button
            class="tab-btn flex items-center gap-2 px-4 py-4 text-sm font-semibold border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap shrink-0 transition-colors"
            data-tab="profile"
            role="tab"
          >
            Profile
          </button>
          <button
            class="tab-btn flex items-center gap-2 px-4 py-4 text-sm font-semibold border-b-2 border-transparent text-slate-600 hover:text-slate-900 whitespace-nowrap shrink-0 transition-colors"
            data-tab="subscription"
            role="tab"
          >
            Subscription
          </button>
        </nav>
      </div>
    </div>

    <!-- Tab Panels -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-32">
      <!-- ── Applications Tab ── -->
      <div id="tab-applications" class="tab-panel space-y-6">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4"
        >
          <div>
            <h2 class="text-xl font-extrabold text-slate-900">Applied Jobs</h2>
            <p class="text-sm text-slate-500 mt-0.5">
              Every job you've applied to through Career Hound
            </p>
          </div>
          <div class="flex items-center gap-2">
            <select
              id="filter-status"
              class="text-xs px-3 py-2 border border-slate-200 rounded-lg bg-white text-slate-700 font-medium focus:ring-2 focus:ring-blue-500 outline-none"
            >
              <option value="all">All Status</option>
              <option value="APPLIED">Applied</option>
              <option value="QUEUED">Queued</option>
              <option value="FAILED">Failed</option>
            </select>
            <a
              href="/search"
              class="px-4 py-2 text-xs font-bold rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors"
            >
              + Apply to More Jobs
            </a>
          </div>
        </div>

        <!-- Loading skeleton -->
        <div id="apps-loading" class="space-y-3">
          <div class="h-24 rounded-2xl bg-slate-100 animate-pulse"></div>
          <div class="h-24 rounded-2xl bg-slate-100 animate-pulse"></div>
          <div class="h-24 rounded-2xl bg-slate-100 animate-pulse"></div>
        </div>

        <!-- Applications list -->
        <div id="apps-list" class="hidden space-y-3"></div>

        <!-- Empty state -->
        <div
          id="apps-empty"
          class="hidden text-center py-20 bg-white rounded-3xl border border-slate-200"
        >
          <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mx-auto text-slate-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7"></path>
              <path d="M22 13a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2"></path>
              <path d="M6 10h12"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">
            No applications tracked yet
          </h3>
          <p class="text-slate-500 text-sm mt-2 max-w-sm mx-auto">
            When you click "Apply Directly →" on verified company postings, your
            applied jobs will be tracked here.
          </p>
          <a
            href="/search"
            class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-bold rounded-full hover:bg-blue-700 transition-colors"
          >
            Browse Jobs →
          </a>
        </div>
      </div>

      <!-- ── Saved Jobs Tab ── -->
      <div id="tab-saved" class="tab-panel hidden space-y-6">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900">Saved Jobs</h2>
          <p class="text-sm text-slate-500 mt-0.5">
            Jobs you've bookmarked to review later
          </p>
        </div>

        <div id="saved-list" class="space-y-3"></div>

        <div
          id="saved-empty"
          class="text-center py-20 bg-white rounded-3xl border border-slate-200"
        >
          <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mx-auto text-blue-600 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">No saved jobs yet</h3>
          <p class="text-slate-500 text-sm mt-2 max-w-sm mx-auto">
            Bookmark jobs from the search page to save them here for later
            review.
          </p>
          <a
            href="/search"
            class="mt-6 inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-bold rounded-full hover:bg-blue-700 transition-colors"
          >
            Search Jobs →
          </a>
        </div>
      </div>

      <!-- ── Profile Tab ── -->
      <div id="tab-profile" class="tab-panel hidden space-y-6">
        <div>
          <h2 class="text-xl font-extrabold text-slate-900">
            Profile & Preferences
          </h2>
          <p class="text-sm text-slate-500 mt-0.5">
            Your career preferences and contact information
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Profile card -->
          <div
            class="bg-white rounded-3xl border border-slate-200 p-6 space-y-5"
          >
            <div class="flex items-center gap-4">
              <div
                id="profile-avatar"
                class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white text-2xl font-black"
              >
                ?
              </div>
              <div>
                <p
                  id="profile-name"
                  class="font-extrabold text-slate-900 text-lg"
                >
                  –
                </p>
                <p id="profile-email" class="text-sm text-slate-500">–</p>
              </div>
            </div>
            <hr class="border-slate-100" />
            <div class="space-y-3 text-sm">
              <div>
                <label
                  class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1"
                  >Member Since</label
                >
                <p id="profile-created" class="font-semibold text-slate-900">
                  –
                </p>
              </div>
              <div>
                <label
                  class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-1"
                  >Plan</label
                >
                <p id="profile-plan" class="font-semibold text-slate-900">–</p>
              </div>
            </div>
            <a
              href="/onboarding"
              class="block w-full text-center py-2.5 px-4 text-sm font-bold text-blue-600 border border-blue-200 rounded-xl hover:bg-blue-50 transition-colors"
            >
              Update Job Preferences →
            </a>
          </div>

          <!-- Resume section -->
          <div
            class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 space-y-4"
          >
            <div class="flex items-center justify-between">
              <h3 class="font-extrabold text-slate-900">
                Your Resume / Background
              </h3>
              <button
                id="btn-save-resume"
                class="text-xs font-bold px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >Save</button
              >
            </div>
            <p class="text-xs text-slate-500">
              This resume text is used by Career Hound AI when generating your
              cover letters. Keep it updated for the best results.
            </p>
            <textarea
              id="profile-resume-text"
              rows="12"
              placeholder="Paste your resume here... (skills, experience, education, achievements)"
              class="w-full text-sm px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none resize-y bg-slate-50/50"
            ></textarea>
            <p
              id="resume-saved-msg"
              class="hidden text-xs text-emerald-600 font-semibold"
            >
              ✓ Resume saved locally
            </p>
          </div>
        </div>
      </div>

      <!-- ── Subscription Tab ── -->
      <div id="tab-subscription" class="tab-panel hidden space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200/80 pb-5">
          <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">
              Subscription & Billing
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
              Managed securely with 256-bit encryption (PCI-DSS Compliant)
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold shadow-2xs">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              7-Day Money-Back Guarantee
            </span>
          </div>
        </div>

        <!-- Current plan card (Sleek dark gradient with distinct contrast) -->
        <div
          id="sub-current-card"
          class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-7 text-white shadow-md relative overflow-hidden border border-slate-800"
        >
          <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="relative flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-black uppercase tracking-wider bg-white/10 border border-white/10 px-3 py-1 rounded-full text-slate-200">
                  Current Tier
                </span>
                <span id="sub-active-status-dot" class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-400">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active
                </span>
              </div>
              <h3 id="sub-plan-name" class="text-3xl font-black tracking-tight text-white">Free</h3>
              <p id="sub-plan-desc" class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
                Limited access — upgrade below to unlock direct company jobs & ATS applications.
              </p>
            </div>

            <!-- Feature chips aligned to the right -->
            <div class="flex flex-wrap md:flex-col gap-2 shrink-0">
              <div class="bg-white/10 border border-white/10 rounded-xl px-3.5 py-1.5 text-xs font-bold text-slate-200 flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <span>10 searches / day</span>
              </div>
              <div class="bg-white/10 border border-white/10 rounded-xl px-3.5 py-1.5 text-xs font-bold text-slate-200 flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>Direct Apply Locked</span>
              </div>
              <div id="sub-pro-feature" class="hidden bg-emerald-500/20 border border-emerald-400/30 rounded-xl px-3.5 py-1.5 text-xs font-bold text-emerald-300 flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>Unlimited Direct Apply</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Upgrade CTA for free users -->
        <div class="space-y-4">
          <div>
            <h3 class="text-lg font-black text-slate-900 tracking-tight">Available Subscription Plans</h3>
            <p class="text-xs text-slate-500 mt-0.5">Upgrade your account instantly with zero commitment. Cancel anytime in 1-click.</p>
          </div>

          <div id="upgrade-section" class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            <!-- Card 1: Weekly Pass -->
            <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-7 shadow-2xs hover:border-slate-300 hover:shadow-lg transition-all flex flex-col justify-between h-full relative">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-600 bg-slate-100 px-3 py-1 rounded-full">Weekly Pass</span>
                </div>
                <h4 class="text-xl font-black text-slate-900">Weekly Pass</h4>
                <p class="text-xs text-slate-500 mt-1 min-h-[36px] flex items-center">7-day high-intensity sprint with full Pro direct ATS job access.</p>
                
                <div class="my-4 min-h-[56px] flex items-baseline gap-1 border-b border-slate-100 pb-4">
                  <span class="text-3xl sm:text-4xl font-black text-slate-900">$9.99</span>
                  <span class="text-xs font-semibold text-slate-500">/ week</span>
                </div>

                <ul class="space-y-3 text-xs text-slate-700 min-h-[140px]">
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Unlimited direct company job search</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Direct company ATS application links</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>AI cover letter generation</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>ATS match scoring & gap analysis</span>
                  </li>
                </ul>
              </div>

              <div class="mt-auto pt-5 border-t border-slate-100 space-y-1.5">
                <button
                  type="button"
                  onclick="window.triggerCheckout && window.triggerCheckout('weekly', this)"
                  class="w-full py-3.5 px-4 text-sm font-black bg-slate-900 hover:bg-slate-800 text-white rounded-xl shadow-xs hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>Get Weekly Pass</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </button>
                <p class="text-[10px] text-center text-slate-400 font-medium">Auto-renews at $9.99/wk • Cancel anytime</p>
              </div>
            </div>

            <!-- Card 2: Monthly Pro (Popular) -->
            <div class="bg-blue-600 text-white border-2 border-blue-600 rounded-3xl p-6 sm:p-7 shadow-xl shadow-blue-600/20 flex flex-col justify-between h-full relative ring-4 ring-blue-50 transform lg:-translate-y-1 transition-all">
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-[10px] font-black bg-amber-400 text-slate-900 px-3 py-1 rounded-full uppercase tracking-widest shadow-sm">
                POPULAR
              </span>

              <div>
                <div class="flex items-center justify-between mb-3 mt-1">
                  <span class="text-xs font-black uppercase tracking-wider text-blue-100 bg-white/20 px-3 py-1 rounded-full">Monthly Pro</span>
                </div>
                <h4 class="text-xl font-black text-white">Monthly Pro</h4>
                <p class="text-xs text-blue-100 mt-1 min-h-[36px] flex items-center">The proven candidate plan to land interviews 4.2x faster.</p>
                
                <div class="my-4 min-h-[56px] flex items-baseline gap-1 border-b border-white/20 pb-4">
                  <span class="text-3xl sm:text-4xl font-black text-white">$29</span>
                  <span class="text-xs font-semibold text-blue-200">/ month</span>
                </div>

                <ul class="space-y-3 text-xs text-blue-50 min-h-[140px]">
                  <li class="flex items-center gap-2.5 font-medium">
                    <svg class="w-4 h-4 text-amber-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>Everything in Weekly Pass</strong></span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Unlimited direct company ATS applications</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Application tracking & status dashboard</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Priority job listings & daily alerts</span>
                  </li>
                </ul>
              </div>

              <div class="mt-auto pt-5 border-t border-white/20 space-y-1.5">
                <button
                  type="button"
                  onclick="window.triggerCheckout && window.triggerCheckout('monthly', this)"
                  class="w-full py-3.5 px-4 text-sm font-black bg-white text-blue-700 rounded-xl hover:bg-blue-50 shadow-md hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>Go Pro Monthly</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </button>
                <p class="text-[10px] text-center text-blue-100 font-medium">Cancel anytime in 1-click via dashboard</p>
              </div>
            </div>

            <!-- Card 3: 1-Year Pass -->
            <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-7 shadow-2xs hover:border-slate-300 hover:shadow-lg transition-all flex flex-col justify-between h-full relative">
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 text-[10px] font-black bg-emerald-600 text-white px-3 py-1 rounded-full uppercase tracking-widest shadow-sm">
                Save 71% • Annual Pass
              </span>

              <div>
                <div class="flex items-center justify-between mb-3 mt-1">
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-600 bg-slate-100 px-3 py-1 rounded-full">1-Year Pass</span>
                </div>
                <h4 class="text-xl font-black text-slate-900">1-Year Pass</h4>
                <p class="text-xs text-slate-500 mt-1 min-h-[36px] flex items-center">365 days of full Pro access across all features & updates.</p>
                
                <div class="my-4 min-h-[56px] flex items-baseline gap-1 border-b border-slate-100 pb-4">
                  <span class="text-3xl sm:text-4xl font-black text-slate-900">$99</span>
                  <span class="text-xs font-semibold text-emerald-600 uppercase tracking-wider ml-1">/ year ($8.25/mo)</span>
                </div>

                <ul class="space-y-3 text-xs text-slate-700 min-h-[140px]">
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span><strong>365 days of full Pro access</strong></span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>All upcoming platform tools & releases</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span>Priority candidate queue for openings</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    <span class="font-bold text-emerald-700">Save $249/yr compared to paying monthly</span>
                  </li>
                </ul>
              </div>

              <div class="mt-auto pt-5 border-t border-slate-100 space-y-1.5">
                <button
                  type="button"
                  onclick="window.triggerCheckout && window.triggerCheckout('yearly', this)"
                  class="w-full py-3.5 px-4 text-sm font-black bg-slate-900 hover:bg-slate-800 text-white rounded-xl shadow-xs hover:scale-102 active:scale-98 transition-all flex items-center justify-center gap-1.5 cursor-pointer"
                >
                  <span>Get 1-Year Pass</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </button>
                <p class="text-[10px] text-center text-slate-400 font-medium">Billed annually at $99 • 7-day money-back</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Billing info for pro users -->
        <div
          id="billing-section"
          class="hidden bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-xs"
        >
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
              <h3 class="font-black text-slate-900 text-base">Billing & Subscription Details</h3>
              <p class="text-xs text-slate-500 mt-0.5">Manage your active payment cycle and receipts</p>
            </div>
            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold">
              Active Member
            </span>
          </div>

          <div class="space-y-3.5 text-sm text-slate-600 mt-5">
            <div class="flex justify-between items-center py-1.5 border-b border-slate-100">
              <span class="font-medium text-slate-700">Billing Provider</span>
              <span class="font-semibold text-slate-900">Secure Merchant of Record (PCI-DSS)</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-slate-100">
              <span class="font-medium text-slate-700">Cancellation Policy</span>
              <span class="text-slate-800 font-medium">Cancel anytime — retains access until cycle end</span>
            </div>
            <div class="flex justify-between items-center py-1.5">
              <span class="font-medium text-slate-700">Receipts & Invoices</span>
              <span class="text-slate-800">Delivered directly to your registered email</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between flex-wrap gap-3">
            <a
              href="mailto:support@careerhound.io"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-blue-600 hover:text-blue-800 hover:underline"
            >
              <span>Need help with billing or refund? Contact Support →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tab-btn.active {
    @apply border-blue-600 text-blue-600;
  }

  .status-APPLIED {
    @apply bg-emerald-100 text-emerald-800 border-emerald-200;
  }
  .status-QUEUED {
    @apply bg-amber-100 text-amber-800 border-amber-200;
  }
  .status-FAILED {
    @apply bg-red-100 text-red-800 border-red-200;
  }
  .status-MATCHED {
    @apply bg-blue-100 text-blue-800 border-blue-200;
  }
  .status-SKIPPED {
    @apply bg-slate-100 text-slate-600 border-slate-200;
  }
</style>

<script>
  import { authClient } from "../lib/auth-client.js";

  // ───────────────────────────────────────────────
  // AUTH CHECK — Better Auth (cookie session) + localStorage fallback
  // ───────────────────────────────────────────────
  const authLoading = document.getElementById("auth-loading");
  const dashboard = document.getElementById("dashboard");

  async function initAuth() {
    try {
      // 1. Try Better Auth session (httpOnly cookie-based)
      const { data: session } = await authClient.getSession();
      if (session?.user) {
        // Sync to localStorage so Header + other pages see the user
        localStorage.setItem(
          "ch_user",
          JSON.stringify({
            id: session.user.id,
            name: session.user.name,
            email: session.user.email,
            plan: (session.user as any).plan || "free",
            isSubscribed: (session.user as any).isSubscribed || false,
            onboardingCompleted:
              (session.user as any).onboardingCompleted || false,
            createdAt: session.user.createdAt,
          }),
        );
        localStorage.setItem("ch_authenticated", "1");
        if (authLoading) authLoading.classList.add("hidden");
        if (dashboard) dashboard.classList.remove("hidden");
        initDashboard(session.user);
        return;
      }
    } catch (_) {
      /* Better Auth unavailable — fall through to localStorage */
    }

    // 2. Fallback: localStorage session (legacy / demo accounts)
    const userJson = localStorage.getItem("ch_user");
    const authenticated = localStorage.getItem("ch_authenticated");

    if (userJson && authenticated) {
      const user = JSON.parse(userJson);
      if (authLoading) authLoading.classList.add("hidden");
      if (dashboard) dashboard.classList.remove("hidden");
      initDashboard(user);
      return;
    }

    // 3. Not authenticated — redirect
    window.location.href = "/login?next=/account";
  }

  initAuth();

  // ───────────────────────────────────────────────
  // INIT DASHBOARD
  // ───────────────────────────────────────────────
  function initDashboard(user: any) {
    const initials = (user.name || "U")
      .split(" ")
      .map((w: string) => w[0])
      .join("")
      .slice(0, 2)
      .toUpperCase();

    // Header section
    const userInitials = document.getElementById("user-initials");
    const userGreeting = document.getElementById("user-greeting");
    const userEmailDisplay = document.getElementById("user-email-display");
    const userPlanBadge = document.getElementById("user-plan-badge");
    const statPlan = document.getElementById("stat-plan");

    if (userInitials) userInitials.textContent = initials;
    if (userGreeting)
      userGreeting.textContent = `Welcome back, ${user.name?.split(" ")[0] || "there"}`;
    if (userEmailDisplay) userEmailDisplay.textContent = user.email;

    const isSubscribed = user.isSubscribed || user.plan !== "free";
    const planLabel = isSubscribed
      ? user.plan === "weekly"
        ? "Weekly Pass"
        : user.plan === "yearly"
          ? "1-Year Pass"
          : "Pro Monthly"
      : "Free Plan";

    if (userPlanBadge) {
      userPlanBadge.textContent = isSubscribed
        ? `⭐ ${planLabel}`
        : "🆓 Free Plan";
      if (isSubscribed)
        userPlanBadge.classList.add("bg-amber-500/30", "border-amber-400/50");
    }
    if (statPlan) statPlan.textContent = isSubscribed ? planLabel : "Free";

    // Profile tab
    const profileAvatar = document.getElementById("profile-avatar");
    const profileName = document.getElementById("profile-name");
    const profileEmail = document.getElementById("profile-email");
    const profilePlan = document.getElementById("profile-plan");
    const profileCreated = document.getElementById("profile-created");

    if (profileAvatar) profileAvatar.textContent = initials;
    if (profileName) profileName.textContent = user.name;
    if (profileEmail) profileEmail.textContent = user.email;
    if (profilePlan) profilePlan.textContent = planLabel;
    if (profileCreated && user.createdAt) {
      profileCreated.textContent = new Date(user.createdAt).toLocaleDateString(
        "en-US",
        { month: "long", year: "numeric" },
      );
    }

    // Subscription tab
    const subPlanName = document.getElementById("sub-plan-name");
    const subPlanDesc = document.getElementById("sub-plan-desc");
    const upgradeSection = document.getElementById("upgrade-section");
    const billingSection = document.getElementById("billing-section");
    const subProFeature = document.getElementById("sub-pro-feature");

    if (subPlanName)
      subPlanName.textContent = isSubscribed ? planLabel : "Free";
    if (subPlanDesc) {
      subPlanDesc.textContent = isSubscribed
        ? "Full access — unlimited direct ATS job search and priority listing verification"
        : "Limited access — upgrade for full unlimited direct company jobs";
    }
    if (isSubscribed) {
      if (upgradeSection) upgradeSection.classList.add("hidden");
      if (billingSection) billingSection.classList.remove("hidden");
      if (subProFeature) subProFeature.classList.remove("hidden");
    }

    // Load resume from localStorage
    const savedResume = localStorage.getItem("ch_resume_text");
    const resumeTextarea = document.getElementById(
      "profile-resume-text",
    ) as HTMLTextAreaElement;
    if (savedResume && resumeTextarea) resumeTextarea.value = savedResume;

    // Load applications and saved jobs
    loadApplications();
    loadSavedJobs();

    // Check URL hash for tab selection (e.g. #saved)
    const hash =
      window.location.hash.replace("#", "") ||
      new URLSearchParams(window.location.search).get("tab");
    if (
      hash &&
      ["saved", "applications", "profile", "subscription"].includes(hash)
    ) {
      const targetBtn = document.querySelector(
        `.tab-btn[data-tab="${hash}"]`,
      ) as HTMLButtonElement;
      if (targetBtn) targetBtn.click();
    }
  }

  // ───────────────────────────────────────────────
  // APPLICATIONS
  // ───────────────────────────────────────────────
  function loadApplications() {
    const appliedIds: string[] = JSON.parse(
      localStorage.getItem("ch_applied_job_ids") || "[]",
    );
    const savedCache = JSON.parse(
      localStorage.getItem("ch_saved_jobs_cache") || "{}",
    );
    const statApplied = document.getElementById("stat-applied");
    if (statApplied) statApplied.textContent = String(appliedIds.length);

    const appsLoading = document.getElementById("apps-loading");
    const appsList = document.getElementById("apps-list");
    const appsEmpty = document.getElementById("apps-empty");

    if (appsLoading) appsLoading.classList.add("hidden");

    if (appliedIds.length === 0) {
      if (appsList) appsList.classList.add("hidden");
      if (appsEmpty) appsEmpty.classList.remove("hidden");
      return;
    }

    if (appsEmpty) appsEmpty.classList.add("hidden");
    if (appsList) {
      appsList.classList.remove("hidden");
      appsList.innerHTML = appliedIds
        .map((id) => {
          const job = savedCache[id] || {
            id,
            title: "Direct ATS Application",
            company: { name: "Employer" },
            locations: ["Worldwide"],
          };
          const companyName =
            job.company?.name || job.companyName || "Employer";
          const companyLogo =
            job.company?.logo ||
            job.companyLogo ||
            "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=64&q=80";
          const loc = Array.isArray(job.locations)
            ? job.locations.join(" • ")
            : job.locations || "Worldwide";
          const salary = job.salaryBadge || "Competitive Salary";
          const appUrl = job.applicationUrl || job.applyUrl || "#";

          return `
          <article class="bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-md transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4 min-w-0">
              <img src="${companyLogo}" alt="${companyName}" class="w-12 h-12 rounded-xl object-cover border border-slate-100 bg-slate-50 shrink-0" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=64&q=80'" />
              <div class="min-w-0">
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                  <span class="text-xs font-bold text-slate-600">${companyName}</span>
                  <span class="text-[11px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-200">Applied Direct</span>
                </div>
                <h3 class="font-extrabold text-slate-900 text-base truncate">${job.title}</h3>
                <p class="text-xs text-slate-500 mt-0.5">${loc} • <span class="font-semibold text-blue-600">${salary}</span></p>
              </div>
            </div>
            <div class="flex items-center gap-2.5 shrink-0">
              <a href="${appUrl}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold px-4 py-2 rounded-full bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition-colors">
                View Posting →
              </a>
            </div>
          </article>
        `;
        })
        .join("");
    }
  }

  // ───────────────────────────────────────────────
  // SAVED JOBS
  // ───────────────────────────────────────────────
  function loadSavedJobs() {
    const savedIds: string[] = JSON.parse(
      localStorage.getItem("ch_saved_job_ids") || "[]",
    );
    const savedCache = JSON.parse(
      localStorage.getItem("ch_saved_jobs_cache") || "{}",
    );
    const savedList = document.getElementById("saved-list");
    const savedEmpty = document.getElementById("saved-empty");
    const statSaved = document.getElementById("stat-saved");
    if (statSaved) statSaved.textContent = String(savedIds.length);

    if (!savedList || !savedEmpty) return;

    if (savedIds.length === 0) {
      savedList.classList.add("hidden");
      savedEmpty.classList.remove("hidden");
      return;
    }

    savedEmpty.classList.add("hidden");
    savedList.classList.remove("hidden");
    savedList.innerHTML = savedIds
      .map((id) => {
        const job = savedCache[id] || {
          id,
          title: "Direct ATS Job",
          company: { name: "Employer" },
          locations: ["Worldwide"],
        };
        const companyName = job.company?.name || job.companyName || "Employer";
        const companyLogo =
          job.company?.logo ||
          job.companyLogo ||
          "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=64&q=80";
        const loc = Array.isArray(job.locations)
          ? job.locations.join(" • ")
          : job.locations || "Worldwide";
        const salary = job.salaryBadge || "Competitive Salary";
        const appUrl = job.applicationUrl || job.applyUrl || "#";

        return `
        <article class="bg-white rounded-2xl border border-slate-200 p-5 hover:shadow-md transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-4 min-w-0">
            <img src="${companyLogo}" alt="${companyName}" class="w-12 h-12 rounded-xl object-cover border border-slate-100 bg-slate-50 shrink-0" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=64&q=80'" />
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="text-xs font-bold text-slate-600">${companyName}</span>
                <span class="text-[10px] uppercase font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Verified Direct</span>
              </div>
              <h3 class="font-extrabold text-slate-900 text-base truncate">${job.title}</h3>
              <p class="text-xs text-slate-500 mt-0.5">${loc} • <span class="font-semibold text-blue-600">${salary}</span></p>
            </div>
          </div>
          <div class="flex items-center gap-2.5 shrink-0">
            <button type="button" class="btn-remove-saved text-xs font-semibold px-3.5 py-2 rounded-full border border-slate-200 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 text-slate-600 transition-colors cursor-pointer" data-job-id="${id}">
              Remove
            </button>
            <a href="${appUrl}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold px-4 py-2 rounded-full bg-blue-600 hover:bg-blue-700 text-white shadow-xs transition-colors">
              Apply Directly →
            </a>
          </div>
        </article>
      `;
      })
      .join("");

    savedList.querySelectorAll(".btn-remove-saved").forEach((btn) => {
      btn.addEventListener("click", () => {
        const jId = (btn as HTMLElement).dataset.jobId;
        if (jId) {
          let ids: string[] = JSON.parse(
            localStorage.getItem("ch_saved_job_ids") || "[]",
          );
          ids = ids.filter((i) => i !== jId);
          localStorage.setItem("ch_saved_job_ids", JSON.stringify(ids));
          try {
            const cache = JSON.parse(localStorage.getItem("ch_saved_jobs_cache") || "{}");
            delete cache[jId];
            localStorage.setItem("ch_saved_jobs_cache", JSON.stringify(cache));
          } catch (_) {}
          loadSavedJobs();
        }
      });
    });
  }

  // ───────────────────────────────────────────────
  // TABS
  // ───────────────────────────────────────────────
  document.querySelectorAll(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = (btn as HTMLButtonElement).dataset.tab || "";
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("active", "border-blue-600", "text-blue-600");
        b.classList.add("border-transparent", "text-slate-600");
      });
      btn.classList.add("active", "border-blue-600", "text-blue-600");
      btn.classList.remove("border-transparent", "text-slate-600");
      document
        .querySelectorAll(".tab-panel")
        .forEach((p) => p.classList.add("hidden"));
      const panel = document.getElementById(`tab-${tab}`);
      if (panel) panel.classList.remove("hidden");
    });
  });

  // ───────────────────────────────────────────────
  // RESUME SAVE
  // ───────────────────────────────────────────────
  const saveResumeBtn = document.getElementById("btn-save-resume");
  const resumeTextarea = document.getElementById(
    "profile-resume-text",
  ) as HTMLTextAreaElement;
  const resumeSavedMsg = document.getElementById("resume-saved-msg");
  if (saveResumeBtn) {
    saveResumeBtn.addEventListener("click", () => {
      if (resumeTextarea?.value) {
        localStorage.setItem("ch_resume_text", resumeTextarea.value);
        if (resumeSavedMsg) {
          resumeSavedMsg.classList.remove("hidden");
          setTimeout(() => resumeSavedMsg.classList.add("hidden"), 3000);
        }
      }
    });
  }

  // ───────────────────────────────────────────────
  // LOGOUT
  // ───────────────────────────────────────────────
  const logoutBtn = document.getElementById("btn-logout");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", async () => {
      // Sign out from Better Auth (clears httpOnly session cookie)
      try {
        await authClient.signOut();
      } catch (_) {}
      // Clear localStorage
      localStorage.removeItem("ch_token");
      localStorage.removeItem("ch_user");
      localStorage.removeItem("ch_authenticated");
      window.location.href = "/login";
    });
  }
</script>
