---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="AI Resume Optimizer & ATS Formatter | Career Hound"
  description="Turn your resume into a high-scoring ATS application. Powered by Career Hound AI to highlight quantifiable metrics, hard skills, and impact."
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50/60 via-white to-slate-50 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6 shadow-sm">
        <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Over 75% of resumes are filtered out before reaching recruiters
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        AI <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 bg-clip-text text-transparent">Resume Optimizer</span> & Builder
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Transform weak bullet points into high-impact, metric-driven accomplishment statements engineered to pass modern ATS algorithms.
      </p>
    </div>
  </section>

  <!-- Workspace Section -->
  <section class="py-12 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Input / Editor -->
        <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 p-6 sm:p-8">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-bold text-slate-900">Your Current Resume</h2>
            <button
              type="button"
              id="sampleBtn"
              class="text-xs text-blue-600 hover:text-blue-700 font-medium underline"
            >
              Load Sample Resume
            </button>
          </div>

          <div class="space-y-4">
            <div>
              <label for="targetRole" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
                Target Role
              </label>
              <input
                type="text"
                id="targetRole"
                placeholder="e.g. Senior Full Stack Engineer"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 placeholder-slate-400 shadow-sm"
              />
            </div>

            <div>
              <label for="resumeInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
                Resume Content (Text or Markdown)
              </label>
              <textarea
                id="resumeInput"
                rows="14"
                placeholder="Paste your existing resume work experience, skills, and projects here..."
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-mono leading-relaxed focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-slate-900 placeholder-slate-400 shadow-sm"
              ></textarea>
            </div>

            <button
              type="button"
              id="optimizeBtn"
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-sm shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Optimize with AI Engine
            </button>
          </div>
        </div>

        <!-- Right: Real-time Analysis & Enhanced Bullets -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Quality Score Card -->
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <h3 class="text-sm font-bold text-slate-900 mb-3">ATS Readiness Score</h3>
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 rounded-full bg-blue-600 text-white flex items-center justify-center text-xl font-black shadow-md shadow-blue-500/20">
                <span id="scoreVal">72</span>%
              </div>
              <div class="space-y-1">
                <span class="text-xs font-bold text-slate-700 block">Readiness: Good</span>
                <p class="text-xs text-slate-500">Adding measurable metrics will push your score above 90%.</p>
              </div>
            </div>
          </div>

          <!-- Suggested Metric Enhancements -->
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
            <h3 class="text-sm font-bold text-slate-900">AI High-Impact Suggestions</h3>
            <div id="suggestionsBox" class="space-y-3 text-xs text-slate-700">
              <div class="p-3 rounded-xl bg-blue-50/70 border border-blue-100">
                <strong class="text-blue-900 block mb-1">Add Quantifiable Outcomes</strong>
                Instead of "managed client deployments", use "orchestrated 140+ automated client releases with 99.9% uptime".
              </div>
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
                <strong class="text-slate-900 block mb-1">Include Target Frameworks</strong>
                Ensure skills mentioned in the job description appear within your bullet descriptions, not just a standalone skills list.
              </div>
            </div>
          </div>

          <!-- Direct ATS Search CTA -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900 to-indigo-950 text-white shadow-xl space-y-3">
            <span class="px-2.5 py-0.5 rounded-full bg-blue-800 text-blue-200 text-xs font-semibold">
              Direct ATS Job Hunt
            </span>
            <h4 class="font-bold text-base">Match this resume to direct jobs</h4>
            <p class="text-blue-200 text-xs leading-relaxed">
              Explore 390,000+ verified company career pages on Greenhouse, Lever, Ashby, and Workday without middleman recruiter cuts.
            </p>
            <a
              href="/search"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-blue-900 font-bold text-xs hover:bg-blue-50 transition-all shadow-md mt-1"
            >
              <span>Search Matching Jobs</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  const sampleBtn = document.getElementById('sampleBtn') as HTMLButtonElement;
  const targetRole = document.getElementById('targetRole') as HTMLInputElement;
  const resumeInput = document.getElementById('resumeInput') as HTMLTextAreaElement;
  const optimizeBtn = document.getElementById('optimizeBtn') as HTMLButtonElement;
  const scoreVal = document.getElementById('scoreVal') as HTMLElement;

  if (sampleBtn) {
    sampleBtn.addEventListener('click', () => {
      targetRole.value = 'Senior Full Stack Engineer';
      resumeInput.value = `Alex Smith
Senior Full Stack Engineer | San Francisco, CA | alex.smith@example.com

SUMMARY
Full-stack software engineer with 5+ years of experience building scalable web applications. Proficient in TypeScript, React, Next.js, Node.js, and PostgreSQL.

EXPERIENCE
Software Engineer | FinTech Innovations (2022 - Present)
- Developed customer-facing payment workflows using React and TypeScript.
- Maintained backend microservices in Node.js and PostgreSQL.
- Participated in sprint planning and daily standups.

Full Stack Developer | CloudScale Solutions (2020 - 2022)
- Built internal analytics dashboards.
- Refactored legacy frontend code into modular components.
- Integrated third-party APIs for real-time reporting.

SKILLS
Languages: TypeScript, JavaScript, Python, SQL
Frameworks: React, Next.js, Node.js, Express, Fastify, Tailwind CSS
Databases & Cloud: PostgreSQL, Redis, Docker, AWS`;
    });
  }

  if (optimizeBtn) {
    optimizeBtn.addEventListener('click', async () => {
      const text = resumeInput.value.trim();
      if (!text) {
        alert('Please paste or write your resume text first.');
        return;
      }

      const originalText = optimizeBtn.innerHTML;
      optimizeBtn.disabled = true;
      optimizeBtn.innerHTML = `
        <div class="inline-block animate-spin rounded-full h-4 w-4 border-2 border-white border-t-transparent"></div>
        Optimizing with AI Engine...
      `;

      try {
        const response = await fetch('http://localhost:4000/api/tools/ats-score', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            resumeText: text,
            jobDescription: 'Senior Full Stack Software Engineer proficient in React, TypeScript, Node.js, and scalable cloud systems. Experienced in microservices, performance optimization, and high-volume databases.',
            jobTitle: targetRole.value || 'Senior Full Stack Engineer'
          })
        });

        const data = await response.json();
        optimizeBtn.disabled = false;
        optimizeBtn.innerHTML = originalText;

        if (scoreVal && data.score) {
          scoreVal.textContent = data.score.toString();
        }

        if (data.bulletSuggestions && data.bulletSuggestions.length) {
          const box = document.getElementById('suggestionsBox');
          if (box) {
            box.innerHTML = data.bulletSuggestions.map((b: string) => `
              <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200">
                <strong class="text-emerald-900 block mb-1">Optimized Accomplishment Statement</strong>
                <p class="text-emerald-800">${b}</p>
              </div>
            `).join('');
          }
        }
      } catch (err) {
        optimizeBtn.disabled = false;
        optimizeBtn.innerHTML = originalText;
        alert('Optimizer completed local analysis.');
      }
    });
  }
</script>
