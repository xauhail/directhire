    background: #2563eb;
    border-color: #ffffff;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.3), 0 3px 10px rgba(37, 99, 235, 0.5);
  }
  .salary-slider-thumb::-moz-range-thumb {
    pointer-events: auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #2563eb;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(37, 99, 235, 0.15);
    cursor: grab;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .salary-slider-thumb::-moz-range-thumb:hover {
    transform: scale(1.15);
    border-color: #1d4ed8;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.18);
  }
  .salary-slider-thumb::-moz-range-thumb:active {
    cursor: grabbing;
    transform: scale(1.2);
    background: #2563eb;
    border-color: #ffffff;
  }
</style>

<script>
  import { searchJobs } from '../lib/api';

  let currentPage = 1;
  let currentQuery = '';
  let isWorldwideActive = false;

  const container = document.getElementById('jobs-container');
  const countText = document.getElementById('jobs-count-text');
  const skeleton = document.getElementById('skeleton-loader');
  const searchForm = document.getElementById('search-form');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const exactToggle = document.getElementById('exact-search-toggle') as HTMLInputElement;
  const sortSelector = document.getElementById('sort-selector') as HTMLSelectElement;
  const workplaceSelect = document.getElementById('filter-workplace') as HTMLSelectElement;
  const categoryInput = document.getElementById('filter-category') as HTMLInputElement;
  const experienceSelect = document.getElementById('filter-experience') as HTMLSelectElement;

  // Category 2-Column Grid Dropdown Elements
  const categoryDropdownWrapper = document.getElementById('category-dropdown-wrapper');
  const categoryDropdownTrigger = document.getElementById('category-dropdown-trigger');
  const categoryDropdownMenu = document.getElementById('category-dropdown-menu');
  const categoryDropdownLabel = document.getElementById('category-dropdown-label');
  const categoryDropdownArrow = document.getElementById('category-dropdown-arrow');
  const categoryClearBtn = document.getElementById('category-clear-btn');

  // Dual-Thumb Salary Range Slider Elements
  const salaryDropdownWrapper = document.getElementById('salary-dropdown-wrapper');
  const salaryDropdownTrigger = document.getElementById('salary-dropdown-trigger');
  const salaryDropdownMenu = document.getElementById('salary-dropdown-menu');
  const salaryDropdownLabel = document.getElementById('salary-dropdown-label');
  const salaryDropdownArrow = document.getElementById('salary-dropdown-arrow');
  const salarySliderMin = document.getElementById('salary-slider-min') as HTMLInputElement;
  const salarySliderMax = document.getElementById('salary-slider-max') as HTMLInputElement;
  const salarySliderHighlight = document.getElementById('salary-slider-highlight');
  const salaryMinDisplay = document.getElementById('salary-min-display');
  const salaryMaxDisplay = document.getElementById('salary-max-display');
  const salarySliderResetBtn = document.getElementById('salary-slider-reset-btn');

  const modalSalarySelect = document.getElementById('modal-salary-select') as HTMLSelectElement;
  const dateSelect = document.getElementById('filter-date') as HTMLSelectElement;
  const resetBtn = document.getElementById('btn-reset-filters');
  const loadMoreBtn = document.getElementById('btn-load-more');
  const worldwideBtn = document.getElementById('btn-toggle-worldwide');
  const savedFilterBtn = document.getElementById('btn-toggle-saved');
  let isSavedOnlyActive = false;

  const allFiltersModal = document.getElementById('all-filters-modal');
  const openAllFiltersBtn = document.getElementById('btn-all-filters');
  const closeAllFiltersBtn = document.getElementById('close-all-filters');
  const applyModalFiltersBtn = document.getElementById('btn-apply-modal-filters');

  function renderWorldwideBtnState() {
    if (!worldwideBtn) return;
    if (isWorldwideActive) {
      worldwideBtn.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-blue-600 bg-blue-600 text-white font-medium shrink-0 hover:bg-blue-700 hover:text-white hover:border-blue-700 transition-colors cursor-pointer shadow-xs';
    } else {
      worldwideBtn.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-slate-300 bg-white text-slate-700 font-medium shrink-0 hover:border-blue-500 hover:text-blue-600 hover:bg-slate-50 transition-colors cursor-pointer';
    }
  }

  function renderSavedBtnState() {
    if (!savedFilterBtn) return;
    const badge = document.getElementById('saved-counter-badge');
    if (isSavedOnlyActive) {
      savedFilterBtn.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-blue-600 bg-blue-600 text-white font-medium shrink-0 hover:bg-blue-700 hover:text-white hover:border-blue-700 transition-colors cursor-pointer shadow-xs';
      if (badge) {
        badge.className = 'text-[10px] bg-white text-blue-700 px-2 py-0.5 rounded-full font-bold';
      }
    } else {
      savedFilterBtn.className = 'inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-slate-300 bg-white text-slate-700 font-medium shrink-0 hover:border-blue-500 hover:text-blue-600 hover:bg-slate-50 transition-colors cursor-pointer';
      if (badge) {
        badge.className = 'text-[10px] bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full font-bold';
      }
    }
  }

  // ===== Saved Jobs Manager =====
  function getSavedJobIds(): string[] {
    try {
      return JSON.parse(localStorage.getItem('ch_saved_job_ids') || '[]');
    } catch {
      return [];
    }
  }

  function getSavedJobsMap(): Record<string, any> {
    try {
      return JSON.parse(localStorage.getItem('ch_saved_jobs_cache') || '{}');
    } catch {
      return {};
    }
  }

  function saveJobToStorage(jobId: string, jobData?: any) {
    const ids = getSavedJobIds();
    const map = getSavedJobsMap();
    if (!ids.includes(jobId)) {
      ids.unshift(jobId);
      localStorage.setItem('ch_saved_job_ids', JSON.stringify(ids));
    }
    if (jobData) {
      map[jobId] = jobData;
      localStorage.setItem('ch_saved_jobs_cache', JSON.stringify(map));
    }
  }

  function removeJobFromStorage(jobId: string) {
    let ids = getSavedJobIds();
    ids = ids.filter(id => id !== jobId);
    localStorage.setItem('ch_saved_job_ids', JSON.stringify(ids));
    const map = getSavedJobsMap();
    delete map[jobId];
    localStorage.setItem('ch_saved_jobs_cache', JSON.stringify(map));
  }

  function isJobSaved(jobId: string): boolean {
    return getSavedJobIds().includes(jobId);
  }

  let toastTimer: any = null;
  function showSaveToast(msg: string) {
    const toast = document.getElementById('save-toast');
    const toastMsg = document.getElementById('save-toast-msg');
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    toast.classList.remove('hidden');
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
    });
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.classList.add('hidden'), 300);
    }, 2200);
  }

  function toggleSaveJob(jobId: string, jobData?: any) {
    if (!jobId) return;
    const currentlySaved = isJobSaved(jobId);
    if (currentlySaved) {
      removeJobFromStorage(jobId);
      showSaveToast('Job removed from saved list');
    } else {
      let data = jobData;
      if (!data) {
        const btn = document.querySelector(`.btn-view-job[data-job-id="${jobId}"]`) as HTMLElement;
        if (btn) {
          data = {
            id: jobId,
            title: btn.dataset.jobTitle || 'Job',
            company: {
              name: btn.dataset.companyName || 'Company',
              logo: btn.dataset.companyLogo || ''
            },
            locations: (btn.dataset.jobLocations || '').split(' • ').filter(Boolean),
            salaryBadge: btn.dataset.salaryBadge || 'Competitive Salary',
            workArrangement: btn.dataset.workArrangement || 'Remote',
            published: new Date().toISOString(),
            descriptionExcerpt: btn.dataset.jobDescription || '',
            descriptionFull: btn.dataset.jobDescriptionFull || '',
            skills: (btn.dataset.jobSkills || '').split(',').filter(Boolean),
            applicationUrl: btn.dataset.applyUrl || '',
            directApplySource: btn.dataset.directSource || 'Direct ATS'
          };
        }
      }
      saveJobToStorage(jobId, data);
      showSaveToast('Job saved to your list!');
    }

    updateSavedButtonsUI();
    updateSavedFilterBadge();

    if (isSavedOnlyActive) {
      renderSavedJobsFeed();
    }
  }

  function updateSavedButtonsUI() {
    const savedIds = getSavedJobIds();
    document.querySelectorAll('.btn-save-job').forEach(btn => {
      const el = btn as HTMLElement;
      const jId = el.dataset.jobId || '';
      const isSaved = savedIds.includes(jId);
      const svg = el.querySelector('svg');
      if (isSaved) {
        el.className = 'btn-save-job p-2 rounded-xl border border-blue-200 bg-blue-50 text-blue-600 transition-all cursor-pointer shadow-xs';
        el.title = 'Remove from saved';
        if (svg) svg.setAttribute('fill', 'currentColor');
      } else {
        el.className = 'btn-save-job p-2 rounded-xl border border-slate-200 bg-white text-slate-400 hover:text-blue-600 hover:border-blue-300 hover:bg-blue-50 transition-all cursor-pointer shadow-2xs';
        el.title = 'Save Job';
        if (svg) svg.setAttribute('fill', 'none');
      }
    });

    document.querySelectorAll('.btn-save-job-text').forEach(btn => {
      const el = btn as HTMLElement;
      const jId = el.dataset.jobId || '';
      const isSaved = savedIds.includes(jId);
      const svg = el.querySelector('svg');
      const label = el.querySelector('.save-btn-label');
      if (isSaved) {
        el.className = 'text-xs font-bold text-blue-600 flex items-center gap-1.5 btn-save-job-text cursor-pointer transition-colors';
        if (svg) svg.setAttribute('fill', 'currentColor');
        if (label) label.textContent = 'Saved';
      } else {
        el.className = 'text-xs font-semibold text-slate-500 hover:text-blue-600 flex items-center gap-1.5 btn-save-job-text cursor-pointer transition-colors';
        if (svg) svg.setAttribute('fill', 'none');
        if (label) label.textContent = 'Save';
      }
    });

    if (currentViewingJob && currentViewingJob.id) {
      const isSaved = savedIds.includes(currentViewingJob.id);
      const detailSaveBtn = document.getElementById('btn-details-save');
      const detailSaveIcon = document.getElementById('detail-save-icon');
      const detailSaveText = document.getElementById('detail-save-text');
      if (detailSaveBtn && detailSaveIcon && detailSaveText) {
        if (isSaved) {
          detailSaveBtn.className = 'px-3.5 py-2 rounded-full border border-blue-600 bg-blue-50 text-blue-700 font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer shadow-xs';
          detailSaveIcon.setAttribute('fill', 'currentColor');
          detailSaveText.textContent = 'Saved';
        } else {
          detailSaveBtn.className = 'px-3.5 py-2 rounded-full border border-slate-300 bg-white hover:border-blue-500 hover:text-blue-600 text-slate-700 font-bold text-xs transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs';
          detailSaveIcon.setAttribute('fill', 'none');
          detailSaveText.textContent = 'Save Job';
        }
      }
    }
  }

  function updateSavedFilterBadge() {
    const ids = getSavedJobIds();
    const badge = document.getElementById('saved-counter-badge');
    if (badge) {
      badge.textContent = ids.length.toString();
      if (ids.length > 0) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  }

  function renderSavedJobsFeed() {
    if (!container) return;
    const ids = getSavedJobIds();
    const map = getSavedJobsMap();
    const savedJobs = ids.map(id => map[id]).filter(Boolean);

    if (countText) {
      countText.innerHTML = `Showing <span class="text-blue-600 font-extrabold">${savedJobs.length}</span> saved ${savedJobs.length === 1 ? 'job' : 'jobs'}`;
    }

    if (savedJobs.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 space-y-3">
          <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mx-auto mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
          </div>
          <h4 class="font-bold text-slate-900 text-lg">You haven't saved any jobs yet</h4>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">Click the bookmark icon on any job posting to save it here for quick access anytime.</p>
        </div>
      `;
      return;
    }

    renderJobs(savedJobs, false);
  }

  function formatSalaryShort(val: number): string {
    if (val === 0) return '$0';
    if (val >= 1000) return `$${Math.round(val / 1000)}k`;
    return `$${val}`;
  }

  function updateSalarySliderState(isInputEvent = false) {
    if (!salarySliderMin || !salarySliderMax) return;

    let min = parseInt(salarySliderMin.value) || 0;
    let max = parseInt(salarySliderMax.value) || 350000;

    // Keep minimum $10k gap between left and right thumb
    if (min > max - 10000) {
      if (isInputEvent && document.activeElement === salarySliderMin) {
        min = Math.max(0, max - 10000);
        salarySliderMin.value = min.toString();
      } else {
        max = Math.min(350000, min + 10000);
        salarySliderMax.value = max.toString();
      }
    }

    // Update active highlight bar (green fill between left min & right max thumb)
    const minPct = (min / 350000) * 100;
    const maxPct = (max / 350000) * 100;
    if (salarySliderHighlight) {
      salarySliderHighlight.style.left = `${minPct}%`;
      salarySliderHighlight.style.right = `${100 - maxPct}%`;
    }

    // Real-time left (Min) and right (Max) text update
    if (salaryMinDisplay) salaryMinDisplay.textContent = formatSalaryShort(min);
    if (salaryMaxDisplay) {
      salaryMaxDisplay.textContent = max >= 350000 ? '$350k+' : formatSalaryShort(max);
    }

    // Real-time button text update
    if (salaryDropdownLabel) {
      if (min === 0 && max >= 350000) {
        salaryDropdownLabel.textContent = 'Salary: Any';
        salaryDropdownTrigger?.classList.remove('border-blue-500', 'text-blue-700', 'bg-blue-50/50');
        salaryDropdownTrigger?.classList.add('border-slate-300', 'bg-white', 'text-slate-700');
      } else if (max >= 350000) {
        salaryDropdownLabel.textContent = `Salary: ${formatSalaryShort(min)}+`;
        salaryDropdownTrigger?.classList.add('border-blue-500', 'text-blue-700', 'bg-blue-50/50');
        salaryDropdownTrigger?.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
      } else {
        salaryDropdownLabel.textContent = `Salary: ${formatSalaryShort(min)} – ${formatSalaryShort(max)}`;
        salaryDropdownTrigger?.classList.add('border-blue-500', 'text-blue-700', 'bg-blue-50/50');
        salaryDropdownTrigger?.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
      }
    }
  }

  // Bind dual slider thumbs
  if (salarySliderMin && salarySliderMax) {
    salarySliderMin.addEventListener('input', () => updateSalarySliderState(true));
    salarySliderMax.addEventListener('input', () => updateSalarySliderState(true));
    salarySliderMin.addEventListener('change', () => performSearch(1));
    salarySliderMax.addEventListener('change', () => performSearch(1));
  }

  function openSalaryDropdown() {
    if (!salaryDropdownTrigger || !salaryDropdownMenu) return;
    closeCategoryDropdown();
    const rect = salaryDropdownTrigger.getBoundingClientRect();
    salaryDropdownMenu.style.position = 'fixed';
    salaryDropdownMenu.style.top = `${rect.bottom + 8}px`;
    
    const menuWidth = Math.min(340, window.innerWidth - 32);
    let left = rect.left;
    if (left + menuWidth > window.innerWidth - 16) {
      left = Math.max(16, window.innerWidth - menuWidth - 16);
    }
    if (left < 16) left = 16;
    
    salaryDropdownMenu.style.width = `${menuWidth}px`;
    salaryDropdownMenu.style.left = `${left}px`;
    salaryDropdownMenu.style.zIndex = '99999';
    salaryDropdownMenu.style.display = 'block';
    salaryDropdownMenu.classList.remove('hidden');
    if (salaryDropdownArrow) salaryDropdownArrow.style.transform = 'rotate(180deg)';
    updateSalarySliderState(false);
  }

  function closeSalaryDropdown() {
    if (!salaryDropdownMenu) return;
    salaryDropdownMenu.style.display = 'none';
    salaryDropdownMenu.classList.add('hidden');
    if (salaryDropdownArrow) salaryDropdownArrow.style.transform = 'rotate(0deg)';
  }

  // Toggle salary dropdown panel
  if (salaryDropdownTrigger && salaryDropdownMenu) {
    salaryDropdownTrigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isVisible = salaryDropdownMenu.style.display === 'block' && !salaryDropdownMenu.classList.contains('hidden');
      if (isVisible) {
        closeSalaryDropdown();
      } else {
        openSalaryDropdown();
      }
    });
  }

  // ===== Category 2-Column Grid Dropdown Logic =====
  function openCategoryDropdown() {
    if (!categoryDropdownTrigger || !categoryDropdownMenu) return;
    closeSalaryDropdown();
    const rect = categoryDropdownTrigger.getBoundingClientRect();
    categoryDropdownMenu.style.position = 'fixed';
    categoryDropdownMenu.style.top = `${rect.bottom + 8}px`;

    const menuWidth = Math.min(540, window.innerWidth - 32);
    let left = rect.left;
    if (left + menuWidth > window.innerWidth - 16) {
      left = Math.max(16, window.innerWidth - menuWidth - 16);
    }
    if (left < 16) left = 16;

    categoryDropdownMenu.style.left = `${left}px`;
    categoryDropdownMenu.style.width = `${menuWidth}px`;
    categoryDropdownMenu.style.zIndex = '99999';
    categoryDropdownMenu.style.display = 'block';
    categoryDropdownMenu.classList.remove('hidden');
    if (categoryDropdownArrow) categoryDropdownArrow.style.transform = 'rotate(180deg)';
  }

  function closeCategoryDropdown() {
    if (!categoryDropdownMenu) return;
    categoryDropdownMenu.style.display = 'none';
    categoryDropdownMenu.classList.add('hidden');
    if (categoryDropdownArrow) categoryDropdownArrow.style.transform = 'rotate(0deg)';
  }

  function selectCategory(catVal: string, catName: string) {
    if (categoryInput) categoryInput.value = catVal;
    if (categoryDropdownLabel) {
      categoryDropdownLabel.textContent = catVal ? `Category: ${catName}` : 'Category: All (33)';
    }

    if (categoryDropdownTrigger) {
      if (catVal) {
        categoryDropdownTrigger.classList.add('border-blue-500', 'text-blue-700', 'bg-blue-50/50');
        categoryDropdownTrigger.classList.remove('border-slate-300', 'bg-white', 'text-slate-700');
      } else {
        categoryDropdownTrigger.classList.remove('border-blue-500', 'text-blue-700', 'bg-blue-50/50');
        categoryDropdownTrigger.classList.add('border-slate-300', 'bg-white', 'text-slate-700');
      }
    }

    // Update checkmarks and active highlight on pills
    document.querySelectorAll('.cat-pill-btn').forEach(btn => {
      const el = btn as HTMLElement;
      const bCat = el.dataset.cat || '';
      const check = el.querySelector('.cat-check');
      if (bCat === catVal) {
        el.className = 'cat-pill-btn flex items-center justify-between p-2 rounded-xl text-left font-bold transition-all cursor-pointer bg-blue-50 text-blue-700 border border-blue-200';
        if (check) check.classList.remove('hidden');
      } else {
        el.className = 'cat-pill-btn flex items-center justify-between p-2 rounded-xl text-left font-medium transition-all cursor-pointer hover:bg-slate-50 text-slate-700 border border-transparent hover:border-slate-200';
        if (check) check.classList.add('hidden');
      }
    });

    closeCategoryDropdown();
  }

  if (categoryDropdownTrigger && categoryDropdownMenu) {
    categoryDropdownTrigger.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const isVisible = categoryDropdownMenu.style.display === 'block' && !categoryDropdownMenu.classList.contains('hidden');
      if (isVisible) {
        closeCategoryDropdown();
      } else {
        openCategoryDropdown();
      }
    });

    if (categoryClearBtn) {
      categoryClearBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        selectCategory('', 'All (33)');
        performSearch(1);
      });
    }

    document.querySelectorAll('.cat-pill-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const el = btn as HTMLElement;
        const catVal = el.dataset.cat || '';
        const catName = el.dataset.name || el.textContent?.trim() || '';
        selectCategory(catVal, catName);
        performSearch(1);
      });
    });
  }

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (
      salaryDropdownMenu &&
      !salaryDropdownMenu.contains(target) &&
      salaryDropdownTrigger &&
      !salaryDropdownTrigger.contains(target)
    ) {
      closeSalaryDropdown();
    }
    if (
      categoryDropdownMenu &&
      !categoryDropdownMenu.contains(target) &&
      categoryDropdownTrigger &&
      !categoryDropdownTrigger.contains(target)
    ) {
      closeCategoryDropdown();
    }
  });

  // Reposition floating menus on scroll
  window.addEventListener('scroll', () => {
    if (salaryDropdownMenu && salaryDropdownMenu.style.display === 'block' && !salaryDropdownMenu.classList.contains('hidden')) {
      const rect = salaryDropdownTrigger.getBoundingClientRect();
      salaryDropdownMenu.style.top = `${rect.bottom + 8}px`;
    }
    if (categoryDropdownMenu && categoryDropdownMenu.style.display === 'block' && !categoryDropdownMenu.classList.contains('hidden')) {
      const rect = categoryDropdownTrigger.getBoundingClientRect();
      categoryDropdownMenu.style.top = `${rect.bottom + 8}px`;
    }
  }, { passive: true });

  // Optimize dual thumb grabbing so user cursor automatically activates closest thumb
  const sliderTrackContainer = salarySliderMin?.parentElement;
  if (sliderTrackContainer && salarySliderMin && salarySliderMax) {
    sliderTrackContainer.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = sliderTrackContainer.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      const currentVal = ratio * 350000;
      const minVal = parseInt(salarySliderMin.value) || 0;
      const maxVal = parseInt(salarySliderMax.value) || 350000;
      if (Math.abs(currentVal - minVal) < Math.abs(currentVal - maxVal)) {
        salarySliderMin.style.zIndex = '35';
        salarySliderMax.style.zIndex = '25';
      } else {
        salarySliderMax.style.zIndex = '35';
        salarySliderMin.style.zIndex = '25';
      }
    });
  }

  if (salarySliderResetBtn) {
    salarySliderResetBtn.addEventListener('click', () => {
      if (salarySliderMin) salarySliderMin.value = '0';
      if (salarySliderMax) salarySliderMax.value = '350000';
      updateSalarySliderState(false);
      performSearch(1);
    });
  }

  if (openAllFiltersBtn && allFiltersModal) {
    openAllFiltersBtn.addEventListener('click', () => {
      allFiltersModal.classList.remove('hidden');
    });
  }
  if (closeAllFiltersBtn && allFiltersModal) {
    closeAllFiltersBtn.addEventListener('click', () => allFiltersModal.classList.add('hidden'));
  }
  if (applyModalFiltersBtn && allFiltersModal) {
    applyModalFiltersBtn.addEventListener('click', () => {
      // Sync modal taxonomy checkboxes to primary category dropdown if one is picked
      const checkedTax = Array.from(document.querySelectorAll('.modal-tax-cb:checked'))
        .map(cb => (cb as HTMLInputElement).value);
      if (checkedTax.length > 0) {
        const taxVal = checkedTax[0];
        const matchBtn = document.querySelector(`.cat-pill-btn[data-cat="${taxVal}"]`) as HTMLElement;
        const catName = matchBtn?.dataset.name || taxVal;
        selectCategory(taxVal, catName);
      }

      // Sync modal salary if picked
      if (modalSalarySelect && modalSalarySelect.value) {
        const parts = modalSalarySelect.value.split('-');
        if (salarySliderMin) salarySliderMin.value = parts[0] || '0';
        if (salarySliderMax) salarySliderMax.value = (parts[1] === '0' || !parts[1]) ? '350000' : parts[1];
        updateSalarySliderState(false);
      }

      allFiltersModal.classList.add('hidden');
      performSearch(1);
    });
  }

  if (worldwideBtn) {
    worldwideBtn.addEventListener('click', () => {
      isWorldwideActive = !isWorldwideActive;
      renderWorldwideBtnState();
      performSearch(1);
    });
  }

  async function performSearch(page = 1) {
    currentPage = page;
    if (skeleton) skeleton.classList.remove('hidden');

    const query = searchInput ? searchInput.value : '';
    const queryMode = exactToggle?.checked ? 'EXACT' : 'FLEXIBLE';
    const sort = sortSelector?.value || 'RELEVANCE';
    const workplace = workplaceSelect?.value ? [workplaceSelect.value] : [];
    
    // Check both dropdown and modal checkboxes for category
    const category = categoryInput?.value 
      ? [categoryInput.value] 
      : (modalCheckedTax.length > 0 ? modalCheckedTax : []);

    const experience = experienceSelect?.value ? [experienceSelect.value] : [];
    
    // Read salary min and max from dual-thumb slider
    let minSalary = 0;
    let maxSalary = 0;
    if (salarySliderMin && salarySliderMax) {
      const minVal = parseInt(salarySliderMin.value) || 0;
      const maxVal = parseInt(salarySliderMax.value) || 350000;
      if (minVal > 0) minSalary = minVal;
      if (maxVal < 350000) maxSalary = maxVal;
    }
    const datePosted = dateSelect?.value || 'all';

    try {
      const data = await searchJobs({
        page,
        pageSize: 10,
        query,
        queryMode,
        sort,
        filters: {
          workArrangements: workplace,
          taxonomies: category,
          experienceLevels: experience,
          salaryMinimum: minSalary,
          salaryMaximum: maxSalary,
          datePosted,
          worldwide: isWorldwideActive,
        }
      });

      if (skeleton) skeleton.classList.add('hidden');

      if (countText) {
        countText.innerHTML = `Showing <span class="text-blue-600 font-extrabold">${data.totalJobs}</span> verified company jobs`;
      }

      renderJobs(data.items, page > 1);
    } catch (err: any) {
      if (skeleton) skeleton.classList.add('hidden');
      if (countText) countText.textContent = 'Failed to load jobs.';
    }
  }

