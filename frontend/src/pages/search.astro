            <span>Exact match</span>
          </label>

          <button 
            type="submit" 
            class="px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm shadow-sm transition-all"
          >
            Search
