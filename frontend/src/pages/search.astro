  function bindJobActionButtons() {
    // Bind save job triggers
    document.querySelectorAll('.btn-save-job').forEach(btn => {
      (btn as HTMLElement).onclick = (e) => {
        e.stopPropagation();
        const el = btn as HTMLElement;
        const jId = el.dataset.jobId || '';
        toggleSaveJob(jId);
      };
    });

    document.querySelectorAll('.btn-save-job-text').forEach(btn => {
      (btn as HTMLElement).onclick = (e) => {
        e.stopPropagation();
        const el = btn as HTMLElement;
        const jId = el.dataset.jobId || '';
        toggleSaveJob(jId);
      };
    });

    updateSavedButtonsUI();
    updateSavedFilterBadge();

    // Bind apply trigger — opens AI modal with job context
    document.querySelectorAll('.btn-apply').forEach(btn => {
      (btn as HTMLElement).onclick = () => {
        const el = btn as HTMLButtonElement;
        openApplyModal({
          jobId: el.dataset.jobId || '',
          jobTitle: el.dataset.jobTitle || '',
          companyName: el.dataset.companyName || '',
          jobDescription: el.dataset.jobDescription || '',
          jobSkills: (el.dataset.jobSkills || '').split(',').filter(Boolean),
          applyUrl: el.dataset.applyUrl || '',
        });
      };
    });

    // Bind report trigger — opens dedicated report modal
    document.querySelectorAll('.btn-report').forEach(btn => {
      (btn as HTMLElement).onclick = () => {
        const el = btn as HTMLElement;
        openReportModal({
          id: el.dataset.jobId || '',
          title: el.dataset.jobTitle || '',
          company: el.dataset.companyName || '',
        });
      };
    });

    // Bind view description trigger — opens full job description modal
    document.querySelectorAll('.btn-view-job').forEach(btn => {
      (btn as HTMLElement).onclick = (e) => {
        e.stopPropagation();
        const el = btn as HTMLElement;
        openJobDetailsModal({
          id: el.dataset.jobId || '',
          title: el.dataset.jobTitle || '',
          companyName: el.dataset.companyName || '',
          companyLogo: el.dataset.companyLogo || '',
          locations: el.dataset.jobLocations || '',
          salaryBadge: el.dataset.salaryBadge || '',
          workArrangement: el.dataset.workArrangement || '',
          postedLabel: el.dataset.postedLabel || '',
          descriptionExcerpt: el.dataset.jobDescription || '',
          descriptionFull: el.dataset.jobDescriptionFull || el.dataset.jobDescription || '',
          skills: (el.dataset.jobSkills || '').split(',').filter(Boolean),
          applyUrl: el.dataset.applyUrl || '',
          directSource: el.dataset.directSource || 'Direct ATS',
        });
      };
    });
  }

  if (searchForm) {
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (isSavedOnlyActive) {
        isSavedOnlyActive = false;
        renderSavedBtnState();
      }
      performSearch(1);
    });
  }

  [workplaceSelect, experienceSelect, dateSelect, sortSelector].forEach(el => {
    if (el) el.addEventListener('change', () => {
      if (isSavedOnlyActive) {
        isSavedOnlyActive = false;
        renderSavedBtnState();
      }
      performSearch(1);
    });
  });

  if (savedFilterBtn) {
    savedFilterBtn.addEventListener('click', () => {
      isSavedOnlyActive = !isSavedOnlyActive;
      renderSavedBtnState();
      if (isSavedOnlyActive) {
        renderSavedJobsFeed();
      } else {
        performSearch(1);
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (workplaceSelect) workplaceSelect.value = '';
      selectCategory('', 'All (33)');
      if (experienceSelect) experienceSelect.value = '';
      if (salarySliderMin) salarySliderMin.value = '0';
      if (salarySliderMax) salarySliderMax.value = '350000';
      updateSalarySliderState(false);
      if (modalSalarySelect) modalSalarySelect.value = '';
      document.querySelectorAll('.modal-tax-cb').forEach(cb => (cb as HTMLInputElement).checked = false);
      if (dateSelect) dateSelect.value = 'all';
      isWorldwideActive = false;
      renderWorldwideBtnState();
      isSavedOnlyActive = false;
      renderSavedBtnState();
      performSearch(1);
    });
