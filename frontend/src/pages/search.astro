---
import Layout from '../layouts/Layout.astro';
import InFeedCTA from '../components/common/InFeedCTA.astro';

const searchPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Search Hidden Jobs | Career Hound",
  "description": "Discover current open jobs directly from company career portals (Greenhouse, Lever, Ashby, Workday).",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://careerhound.io/" },
      { "@type": "ListItem", "position": 2, "name": "Search Jobs", "item": "https://careerhound.io/search" }
    ]
  }
};

let initialJobs: any[] = [];
let initialTotal = 0;
try {
  const res = await fetch('http://localhost:4000/api/job-search', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ page: 1, pageSize: 10 })
  });
  if (res.ok) {
    const data = await res.json();
    initialJobs = data.items || [];
    initialTotal = data.totalJobs || 0;
  }
} catch (e) {
  // Client script will handle fallback if needed
}

function formatTimeAgo(iso: string): string {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}
---

<Layout 
  title="Search Jobs | Career Hound"
  description="Search 390,000+ current verified jobs posted directly on company websites."
  jsonLd={searchPageSchema}
