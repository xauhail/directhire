    if (jobDetailsModal) jobDetailsModal.classList.remove('hidden');
    updateSavedButtonsUI();
  }

  function closeJobDetailsModal() {
    if (jobDetailsModal) jobDetailsModal.classList.add('hidden');
  }

  if (closeJobDetailsModalBtn) closeJobDetailsModalBtn.addEventListener('click', closeJobDetailsModal);
  if (jobDetailsModal) {
    jobDetailsModal.addEventListener('click', (e) => {
      if (e.target === jobDetailsModal) closeJobDetailsModal();
    });
  }

  const btnDetailsSave = document.getElementById('btn-details-save');
  if (btnDetailsSave) {
    btnDetailsSave.addEventListener('click', (e) => {
      e.stopPropagation();
      if (currentViewingJob && currentViewingJob.id) {
        toggleSaveJob(currentViewingJob.id, currentViewingJob);
      }
    });
  }

  if (btnDetailsApplyDirect) {
    btnDetailsApplyDirect.addEventListener('click', () => {
      if (currentViewingJob?.applyUrl && currentViewingJob.applyUrl !== '#') {
        window.open(currentViewingJob.applyUrl, '_blank', 'noopener,noreferrer');
      } else {
        closeJobDetailsModal();
        if (currentViewingJob) {
          openApplyModal({
            jobId: currentViewingJob.id,
            jobTitle: currentViewingJob.title,
            companyName: currentViewingJob.companyName,
            jobDescription: currentViewingJob.descriptionExcerpt,
            jobSkills: currentViewingJob.skills,
            applyUrl: currentViewingJob.applyUrl,
          });
        }
      }
    });
  }

  if (btnDetailsAiApply) {
    btnDetailsAiApply.addEventListener('click', () => {
      closeJobDetailsModal();
      if (currentViewingJob) {
        openApplyModal({
          jobId: currentViewingJob.id,
          jobTitle: currentViewingJob.title,
          companyName: currentViewingJob.companyName,
          jobDescription: currentViewingJob.descriptionExcerpt,
          jobSkills: currentViewingJob.skills,
          applyUrl: currentViewingJob.applyUrl,
        });
      }
    });
  }

  if (btnDetailsReport) {
    btnDetailsReport.addEventListener('click', () => {
      closeJobDetailsModal();
      if (currentViewingJob) {
        openReportModal({
          id: currentViewingJob.id,
          title: currentViewingJob.title,
          company: currentViewingJob.companyName,
        });
      }
    });
  }

  // ===== Report Job Modal Logic =====
  let currentReportJob = { id: '', title: '', company: '' };

  const reportModal = document.getElementById('report-job-modal');
  const closeReportModalBtn = document.getElementById('close-report-modal');
  const cancelReportBtn = document.getElementById('btn-cancel-report');
  const submitReportBtn = document.getElementById('btn-submit-report');
  const reportFormContainer = document.getElementById('report-form-container');
  const reportFormFooter = document.getElementById('report-form-footer');
  const reportSuccessState = document.getElementById('report-success-state');
  const closeReportSuccessBtn = document.getElementById('btn-close-report-success');
  const reportTargetTitle = document.getElementById('report-target-title');
  const reportTargetCompany = document.getElementById('report-target-company');
  const reportComments = document.getElementById('report-comments') as HTMLTextAreaElement | null;
  const reportUserEmail = document.getElementById('report-user-email') as HTMLInputElement | null;

  function openReportModal(job: { id: string; title: string; company: string }) {
    currentReportJob = job;
    if (reportTargetTitle) reportTargetTitle.textContent = job.title || 'Selected Job';
    if (reportTargetCompany) reportTargetCompany.textContent = job.company || 'Direct ATS Listing';
    if (reportComments) reportComments.value = '';

    try {
      const userStr = localStorage.getItem('ch_user');
      if (userStr && reportUserEmail) {
        const u = JSON.parse(userStr);
        if (u?.email) reportUserEmail.value = u.email;
      }
    } catch (_) {}

    if (reportFormContainer) reportFormContainer.classList.remove('hidden');
    if (reportFormFooter) reportFormFooter.classList.remove('hidden');
    if (reportSuccessState) reportSuccessState.classList.add('hidden');

    if (reportModal) reportModal.classList.remove('hidden');
  }

  function closeReportModal() {
    if (reportModal) reportModal.classList.add('hidden');
  }

  if (closeReportModalBtn) closeReportModalBtn.addEventListener('click', closeReportModal);
  if (cancelReportBtn) cancelReportBtn.addEventListener('click', closeReportModal);
  if (closeReportSuccessBtn) closeReportSuccessBtn.addEventListener('click', closeReportModal);
  if (reportModal) {
    reportModal.addEventListener('click', (e) => {
      if (e.target === reportModal) closeReportModal();
    });
  }

  if (submitReportBtn) {
    submitReportBtn.addEventListener('click', async () => {
      const selectedRadio = document.querySelector('input[name="report-reason"]:checked') as HTMLInputElement | null;
      const reason = selectedRadio ? selectedRadio.value : 'broken_link';
      const comment = reportComments ? reportComments.value.trim() : '';
      const email = reportUserEmail ? reportUserEmail.value.trim() : '';

      const originalBtnHtml = submitReportBtn.innerHTML;
      submitReportBtn.setAttribute('disabled', 'true');
      submitReportBtn.innerHTML = '<span class="inline-flex items-center gap-2"><svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span>Submitting...</span></span>';

      try {
        await fetch('http://localhost:4000/api/job-search/not-relevant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jobId: currentReportJob.id,
            jobTitle: currentReportJob.title,
            companyName: currentReportJob.company,
            reason,
            comment,
            email,
          }),
        });
      } catch (_) {}

      submitReportBtn.removeAttribute('disabled');
      submitReportBtn.innerHTML = originalBtnHtml;

      if (reportFormContainer) reportFormContainer.classList.add('hidden');
      if (reportFormFooter) reportFormFooter.classList.add('hidden');
      if (reportSuccessState) reportSuccessState.classList.remove('hidden');
    });
  }

  // ===== AI Apply Modal Logic =====
  interface ApplyContext {
    jobId: string;
    jobTitle: string;
    companyName: string;
    jobDescription: string;
    jobSkills: string[];
    applyUrl: string;
  }

  let activeJobContext: ApplyContext | null = null;

  const aiModal = document.getElementById('ai-apply-modal');
  const closeAiModalBtn = document.getElementById('close-ai-modal');
  const modalJobTitle = document.getElementById('modal-job-title');
  const modalCompanyName = document.getElementById('modal-company-name');
  const modalMatchBar = document.getElementById('modal-match-bar') as HTMLDivElement;
  const modalMatchPct = document.getElementById('modal-match-pct');
  const modalResumeText = document.getElementById('modal-resume-text') as HTMLTextAreaElement;
  const btnGenerateCover = document.getElementById('btn-generate-cover');
  const coverLetterSection = document.getElementById('cover-letter-section');
  const screeningSection = document.getElementById('screening-section');
  const modalCoverLetter = document.getElementById('modal-cover-letter') as HTMLTextAreaElement;
  const screeningAnswers = document.getElementById('screening-answers');
  const generatingState = document.getElementById('generating-state');
  const generateError = document.getElementById('generate-error');
  const modalApplyLink = document.getElementById('modal-apply-link') as HTMLButtonElement;
  const btnCopyCover = document.getElementById('btn-copy-cover');

  // Track last generated result for Apply tracking
  let lastGeneratedData: any = null;
  let activeApplyUrl = '';

  function formatTimeAgo(iso: string): string {
    if (!iso) return '';
    const diff = Date.now() - new Date(iso).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 60) return `${mins}m ago`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h ago`;
    const days = Math.floor(hrs / 24);
    return `${days}d ago`;
  }

  function openApplyModal(ctx: ApplyContext) {
    activeJobContext = ctx;
    activeApplyUrl = ctx.applyUrl || '';
    lastGeneratedData = null;
    if (modalJobTitle) modalJobTitle.textContent = ctx.jobTitle;
    if (modalCompanyName) modalCompanyName.textContent = ctx.companyName;
    if (modalMatchBar) modalMatchBar.style.width = '0%';
    if (modalMatchPct) modalMatchPct.textContent = '–';
    if (coverLetterSection) coverLetterSection.classList.add('hidden');
    if (screeningSection) screeningSection.classList.add('hidden');
    if (generatingState) generatingState.classList.add('hidden');
    if (generateError) { generateError.classList.add('hidden'); generateError.textContent = ''; }
    if (aiModal) aiModal.classList.remove('hidden');
    // Restore any saved resume text
    const saved = localStorage.getItem('ch_resume_text');
    if (saved && modalResumeText) modalResumeText.value = saved;
  }

  if (closeAiModalBtn && aiModal) {
    closeAiModalBtn.addEventListener('click', () => aiModal.classList.add('hidden'));
    aiModal.addEventListener('click', (e) => {
      if (e.target === aiModal) aiModal.classList.add('hidden');
    });
  }

  // Apply Directly button — tracks application then opens external URL
  if (modalApplyLink) {
    modalApplyLink.addEventListener('click', async () => {
      if (!activeJobContext) return;
      // Track application in backend
      try {
        await fetch('http://localhost:4000/api/auto-apply/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jobId: activeJobContext.jobId,
            jobTitle: activeJobContext.jobTitle,
            companyName: activeJobContext.companyName,
            matchScore: lastGeneratedData?.matchScore || 0,
            screeningAnswers: lastGeneratedData?.screeningAnswers || {},
          }),
        });
      } catch (_) { /* non-blocking */ }
      // Open external application URL
      if (activeApplyUrl && activeApplyUrl !== '#') {
        window.open(activeApplyUrl, '_blank', 'noopener,noreferrer');
      }
      if (aiModal) aiModal.classList.add('hidden');
    });
  }

  if (btnCopyCover) {
    btnCopyCover.addEventListener('click', () => {
      if (modalCoverLetter?.value) {
        navigator.clipboard.writeText(modalCoverLetter.value).then(() => {
          (btnCopyCover as HTMLButtonElement).textContent = 'Copied!';
          setTimeout(() => { (btnCopyCover as HTMLButtonElement).textContent = 'Copy'; }, 2000);
        });
      }
    });
  }

  if (btnGenerateCover) {
    btnGenerateCover.addEventListener('click', async () => {
      const resume = modalResumeText?.value?.trim() || '';
      if (!resume) {
        if (generateError) {
          generateError.textContent = 'Please paste your resume or background text first.';
          generateError.classList.remove('hidden');
        }
        return;
      }
      if (!activeJobContext) return;

      // Save resume text for future use
      localStorage.setItem('ch_resume_text', resume);

      if (generateError) generateError.classList.add('hidden');
      if (coverLetterSection) coverLetterSection.classList.add('hidden');
      if (screeningSection) screeningSection.classList.add('hidden');
      if (generatingState) generatingState.classList.remove('hidden');
      (btnGenerateCover as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('http://localhost:4000/api/auto-apply/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jobId: activeJobContext.jobId,
            jobTitle: activeJobContext.jobTitle,
            companyName: activeJobContext.companyName,
            jobDescription: activeJobContext.jobDescription,
            jobSkills: activeJobContext.jobSkills,
            resumeText: resume,
          }),
        });

        const data = await res.json();

        if (generatingState) generatingState.classList.add('hidden');
        (btnGenerateCover as HTMLButtonElement).disabled = false;

        if (!res.ok || data.error) throw new Error(data.error || 'Generation failed');

        // Store for tracking when Apply is clicked
        lastGeneratedData = data;

        // Show match score
        if (data.matchScore !== undefined) {
          if (modalMatchBar) modalMatchBar.style.width = `${data.matchScore}%`;
          if (modalMatchPct) modalMatchPct.textContent = `${data.matchScore}%`;
        }

        // Show cover letter
        if (data.coverLetter && modalCoverLetter) {
          modalCoverLetter.value = data.coverLetter;
          if (coverLetterSection) coverLetterSection.classList.remove('hidden');
        }

        // Show screening answers
        if (data.screeningAnswers && screeningAnswers && Object.keys(data.screeningAnswers).length) {
          screeningAnswers.innerHTML = Object.entries(data.screeningAnswers).map(([q, a]) => `
            <div class="bg-slate-50 rounded-xl p-3 border border-slate-100">
              <p class="font-semibold text-slate-700 mb-1">${q}</p>
              <p class="text-slate-600">${a}</p>
            </div>
          `).join('');
          if (screeningSection) screeningSection.classList.remove('hidden');
        }

      } catch (err: any) {
        if (generatingState) generatingState.classList.add('hidden');
        (btnGenerateCover as HTMLButtonElement).disabled = false;
        if (generateError) {
          generateError.textContent = err.message || 'Failed to generate. Please try again.';
          generateError.classList.remove('hidden');
        }
      }
    });
  }

  // Initial load: bind SSR-rendered cards immediately and initialize dual-thumb slider
  updateSalarySliderState(false);
  bindJobActionButtons();

  // If there are search query params in the URL, apply them
  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('q') || urlParams.get('query') || urlParams.get('role') || '';
  const categoryParam = urlParams.get('category') || '';
  const workplaceParam = urlParams.get('workplace') || '';
  const savedParam = urlParams.get('saved') === 'true';

  if (savedParam) {
    isSavedOnlyActive = true;
    renderSavedBtnState();
    renderSavedJobsFeed();
  } else if (qParam || categoryParam || workplaceParam) {
    if (qParam && searchInput) searchInput.value = qParam;
    if (categoryParam && categoryInput) {
      categoryInput.value = categoryParam;
      const matchBtn = document.querySelector(`.cat-pill-btn[data-cat="${categoryParam}"]`) as HTMLElement;
      if (matchBtn && categoryDropdownLabel) {
        categoryDropdownLabel.textContent = `Category: ${matchBtn.dataset.name || categoryParam}`;
      }
    }
    if (workplaceParam && workplaceSelect) workplaceSelect.value = workplaceParam;
    performSearch(1);
  }
</script>
