  // ===== Job Details Modal Logic =====
  let currentViewingJob: any = null;

  const jobDetailsModal = document.getElementById('job-details-modal');
  const closeJobDetailsModalBtn = document.getElementById('close-job-details-modal');
  const detailJobLogo = document.getElementById('detail-job-logo') as HTMLImageElement | null;
  const detailJobCompany = document.getElementById('detail-job-company');
  const detailJobPosted = document.getElementById('detail-job-posted');
  const detailJobTitleHeading = document.getElementById('detail-job-title-heading');
  const detailJobLoc = document.getElementById('detail-job-loc');
  const detailJobSalary = document.getElementById('detail-job-salary');
  const detailJobWorkType = document.getElementById('detail-job-work-type');
  const detailJobFullDescription = document.getElementById('detail-job-full-description');
  const detailJobSkillsList = document.getElementById('detail-job-skills-list');
  const btnDetailsApplyDirect = document.getElementById('btn-details-apply-direct');
  const btnDetailsAiApply = document.getElementById('btn-details-ai-apply');
  const btnDetailsReport = document.getElementById('btn-details-report');

  function openJobDetailsModal(data: any) {
    currentViewingJob = data;
    if (detailJobLogo) detailJobLogo.src = data.companyLogo || 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=64&q=80';
    if (detailJobCompany) detailJobCompany.textContent = data.companyName || 'Company';
    if (detailJobPosted) detailJobPosted.textContent = data.postedLabel || 'Recently verified';
    if (detailJobTitleHeading) detailJobTitleHeading.textContent = data.title || 'Job Title';
    if (detailJobLoc) detailJobLoc.textContent = `${data.locations || 'Worldwide'} • ${data.workArrangement || 'Remote'}`;
    if (detailJobSalary) detailJobSalary.textContent = data.salaryBadge || 'Competitive Salary';
    if (detailJobWorkType) detailJobWorkType.textContent = data.workArrangement || 'Direct Hire';

    if (detailJobFullDescription) {
      detailJobFullDescription.textContent = data.descriptionFull || data.descriptionExcerpt || 'Direct ATS verified posting. Check employer portal for full role requirements.';
    }

    if (detailJobSkillsList) {
      detailJobSkillsList.innerHTML = '';
      if (data.skills && data.skills.length > 0) {
        data.skills.forEach((skill: string) => {
          if (!skill.trim()) return;
          const span = document.createElement('span');
          span.className = 'px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700';
          span.textContent = skill.trim();
          detailJobSkillsList.appendChild(span);
        });
      } else {
        detailJobSkillsList.innerHTML = '<span class="text-xs text-slate-400">Direct ATS listing. Check employer portal for complete skill breakdown.</span>';
      }
