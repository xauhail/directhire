---
import Layout from '../../layouts/Layout.astro';

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Free ATS Resume Scanner | Career Hound",
  "applicationCategory": "BusinessApplication",
  "description": "Free ATS resume scanner and keyword matcher powered by Career Hound AI."
};
---

<Layout 
  title="Free ATS Resume Checker & Keyword Matcher | Career Hound"
  description="Scan your resume against any job description for free. Get an instant match score, missing hard skills, and bullet rewrites."
  jsonLd={toolSchema}
>
  <div class="max-w-4xl mx-auto px-4 py-12 sm:py-16 space-y-10">
    
    <!-- Hero Title -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider">
        <span>100% Free • Powered by Career Hound AI</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Free ATS Resume Scanner & Matcher
      </h1>
      <p class="text-xs sm:text-sm text-slate-600">
        Discover if your resume passes applicant tracking systems before you apply. Identifies missing keywords and suggests high-impact bullet improvements.
      </p>
    </div>

    <!-- Input Form Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-card space-y-6">
      <form id="ats-form" class="space-y-6">
        
        <div>
          <label for="job-title-input" class="block text-xs font-bold text-slate-700 mb-1">Target Job Title</label>
          <input 
            type="text" 
            id="job-title-input" 
            required 
            placeholder="e.g. Senior Full Stack Engineer" 
            class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="resume-text" class="block text-xs font-bold text-slate-700 mb-1">Paste Your Resume</label>
            <textarea 
              id="resume-text" 
              rows="9" 
              required
              placeholder="Paste your work experience, summary, and skills here..." 
              class="w-full p-3.5 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"
            ></textarea>
          </div>

          <div>
            <label for="job-desc" class="block text-xs font-bold text-slate-700 mb-1">Paste Target Job Description</label>
            <textarea 
              id="job-desc" 
              rows="9" 
              required
              placeholder="Paste the requirements, duties, and qualifications from the job posting..." 
              class="w-full p-3.5 rounded-xl border border-slate-300 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"
            ></textarea>
          </div>
        </div>

        <button 
          type="submit" 
          id="btn-scan-ats" 
          class="w-full py-4 rounded-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Calculate Free ATS Match Score</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </button>
      </form>
    </div>

    <!-- Results Display Section (Hidden until scanned) -->
    <div id="ats-results" class="hidden bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-card space-y-8 animate-in fade-in duration-300">
      
      <!-- Score Dial & Summary -->
      <div class="flex flex-col sm:flex-row items-center gap-8 pb-8 border-b border-slate-100">
        <div class="relative w-36 h-36 flex items-center justify-center rounded-full bg-blue-50 border-4 border-blue-600 shrink-0">
          <div class="text-center">
            <span id="score-number" class="text-4xl font-black text-blue-600">85%</span>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">ATS Match</span>
          </div>
        </div>

        <div class="space-y-2 text-center sm:text-left">
          <h3 class="text-xl font-bold text-slate-900" id="score-verdict">Strong Match for Interview Shortlisting</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" id="score-rationale">
            Your resume demonstrates solid alignment with core technical requirements. Adding the missing keywords below will push you above the 90th percentile.
          </p>
        </div>
      </div>

      <!-- Keywords Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-2">✓ Matching Hard Skills Found</h4>
          <div class="flex flex-wrap gap-1.5" id="matching-skills-container"></div>
        </div>

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-red-600 mb-2">✕ Missing Keywords to Add</h4>
          <div class="flex flex-wrap gap-1.5" id="missing-skills-container"></div>
        </div>
      </div>

      <!-- Bullet Suggestions -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3">Suggested High-Impact Bullet Rewrites</h4>
        <ul class="space-y-2.5 text-xs text-slate-700" id="bullet-suggestions-container"></ul>
      </div>

      <!-- High-Converting Bridge CTA -->
      <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-700 to-indigo-800 text-white flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="font-bold text-base text-white">Want us to apply to 50+ matching jobs automatically?</h4>
          <p class="text-xs text-blue-100">Career Hound's AI Auto-Apply bot submits verified direct-company applications for you.</p>
        </div>
        <a href="/onboarding" class="px-6 py-3 rounded-full bg-white text-blue-700 hover:bg-blue-50 font-bold text-xs shrink-0 shadow-md">
          Get Started with Auto-Apply →
        </a>
      </div>

    </div>

  </div>
</Layout>

<script>
  import { getAtsScore } from '../../lib/api';

  const form = document.getElementById('ats-form');
  const btn = document.getElementById('btn-scan-ats');
  const resultsCard = document.getElementById('ats-results');
  const scoreNumber = document.getElementById('score-number');
  const scoreRationale = document.getElementById('score-rationale');
  const matchingContainer = document.getElementById('matching-skills-container');
  const missingContainer = document.getElementById('missing-skills-container');
  const bulletsContainer = document.getElementById('bullet-suggestions-container');

  if (form && btn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const resumeText = (document.getElementById('resume-text') as HTMLTextAreaElement)?.value;
      const jobDescription = (document.getElementById('job-desc') as HTMLTextAreaElement)?.value;
      const jobTitle = (document.getElementById('job-title-input') as HTMLInputElement)?.value;

      btn.setAttribute('disabled', 'true');
      btn.innerHTML = '<span>Scanning with Career Hound AI...</span>';

      try {
        const data = await getAtsScore(resumeText, jobDescription, jobTitle);

        if (scoreNumber) scoreNumber.textContent = `${data.score}%`;
        if (scoreRationale) scoreRationale.textContent = data.rationale;

        if (matchingContainer) {
          matchingContainer.innerHTML = (data.matchingSkills || []).map((s: string) => 
            `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-semibold border border-emerald-200">✓ ${s}</span>`
          ).join('');
        }

        if (missingContainer) {
          missingContainer.innerHTML = (data.missingSkills || []).map((s: string) => 
            `<span class="px-2.5 py-1 bg-red-50 text-red-700 rounded-lg text-xs font-semibold border border-red-200">+ ${s}</span>`
          ).join('');
        }

        if (bulletsContainer) {
          bulletsContainer.innerHTML = (data.bulletSuggestions || []).map((b: string) => 
            `<li class="p-3 bg-slate-50 rounded-xl border border-slate-200/80 flex items-start gap-2"><span class="w-1.5 h-1.5 rounded-full bg-blue-600 mt-1.5 shrink-0"></span><span>${b}</span></li>`
          ).join('');
        }

        if (resultsCard) resultsCard.classList.remove('hidden');
        resultsCard?.scrollIntoView({ behavior: 'smooth' });
      } catch (err: any) {
        alert(err.message || 'Failed to scan resume.');
      } finally {
        btn.removeAttribute('disabled');
        btn.innerHTML = '<span>Calculate Free ATS Match Score</span> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>';
      }
    });
  }
</script>
