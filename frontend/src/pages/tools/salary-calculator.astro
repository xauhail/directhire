---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Free Remote & Tech Salary Calculator 2026 | Jobs Nation"
  description="Calculate your true market value across tech, engineering, product, and remote roles. Real-time 25th, 50th, and 90th percentile salary benchmarks."
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-blue-50/60 via-white to-slate-50 border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold mb-6 shadow-sm">
        <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Direct-hire candidates earn 15-20% more than agency submissions
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Free Remote & Tech <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 bg-clip-text text-transparent">Salary Calculator</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Know your worth before entering interviews. Benchmark salaries across roles, years of experience, and global remote markets with verified compensation bands.
      </p>
    </div>
  </section>

  <!-- Calculator Workspace -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Input Card -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 p-6 sm:p-8 mb-12">
        <form id="salaryForm" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label for="role" class="block text-sm font-semibold text-slate-800 mb-1">Target Role *</label>
              <select
                id="role"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm text-slate-900 shadow-sm bg-white"
              >
                <option value="Software Engineer">Software Engineer</option>
                <option value="Frontend Developer">Frontend Developer</option>
                <option value="Backend Engineer">Backend Engineer</option>
                <option value="Full Stack Developer">Full Stack Developer</option>
                <option value="DevOps / Cloud Engineer">DevOps / Cloud Engineer</option>
                <option value="Product Manager">Product Manager</option>
                <option value="Product Designer / UX">Product Designer / UX</option>
                <option value="Data Scientist / AI">Data Scientist / AI</option>
                <option value="Sales / Account Executive">Sales / Account Executive</option>
              </select>
            </div>

            <div>
              <label for="experienceYears" class="block text-sm font-semibold text-slate-800 mb-1">Experience Level</label>
              <select
                id="experienceYears"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm text-slate-900 shadow-sm bg-white"
              >
                <option value="1">Entry Level (0 - 2 Years)</option>
                <option value="4" selected>Mid-Level (3 - 5 Years)</option>
                <option value="7">Senior (6 - 8 Years)</option>
                <option value="10">Staff / Principal (9+ Years)</option>
              </select>
            </div>

            <div>
              <label for="country" class="block text-sm font-semibold text-slate-800 mb-1">Location / Market</label>
              <select
                id="country"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm text-slate-900 shadow-sm bg-white"
              >
                <option value="United States" selected>United States (USD)</option>
                <option value="Canada">Canada (CAD / USD)</option>
                <option value="United Kingdom">United Kingdom (GBP / USD)</option>
                <option value="Germany / Europe">European Union (EUR)</option>
                <option value="Worldwide Remote">Worldwide Remote</option>
                <option value="India">India / APAC (USD equiv)</option>
              </select>
            </div>
          </div>

          <button
            type="submit"
            id="calcBtn"
            class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-base shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            Calculate Compensation Benchmark
          </button>
        </form>

        <!-- Benchmark Results Display -->
        <div id="salaryResults" class="mt-8 pt-8 border-t border-slate-200 space-y-8 animate-fade-in">
          
          <!-- Big Numbers Row -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">25th Percentile</span>
              <div id="p25Display" class="text-2xl sm:text-3xl font-black text-slate-700 mt-1">$102,000</div>
              <span class="text-xs text-slate-500 mt-1 block">Baseline / Starting range</span>
            </div>

            <div class="p-5 rounded-2xl bg-blue-50 border-2 border-blue-500 text-center relative shadow-md shadow-blue-500/10">
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-blue-600 text-white text-[10px] font-extrabold uppercase tracking-wide">
                Market Median
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600">50th Percentile</span>
              <div id="medianDisplay" class="text-3xl sm:text-4xl font-black text-blue-900 mt-1">$125,000</div>
              <span class="text-xs text-blue-700 font-medium mt-1 block">Expected market rate</span>
            </div>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 text-center">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">90th Percentile</span>
              <div id="p90Display" class="text-2xl sm:text-3xl font-black text-emerald-600 mt-1">$168,000</div>
              <span class="text-xs text-slate-500 mt-1 block">Top tier / High equity</span>
            </div>

          </div>

          <!-- Visual Distribution Bar -->
          <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
            <h4 class="text-sm font-bold text-slate-900 mb-4">Salary Distribution Range</h4>
            <div class="relative w-full h-5 rounded-full bg-slate-200 overflow-hidden mb-3">
              <div id="salaryBar" class="h-full bg-gradient-to-r from-blue-400 via-indigo-500 to-emerald-500 rounded-full transition-all duration-700" style="width: 75%;"></div>
            </div>
            <div class="flex justify-between text-xs text-slate-500 font-medium">
              <span>Lower Bound (p25)</span>
              <span>Average (p50)</span>
              <span>Upper Tier (p90)</span>
            </div>
          </div>

          <!-- Direct Hire Advantage Insight -->
          <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-amber-900 mb-1">Direct-to-Company Headcount Advantage</h4>
              <p class="text-xs sm:text-sm text-amber-800 leading-relaxed">
                When you apply via Jobs Nation, you bypass staffing agencies that charge employers 20-30% first-year placement cuts. This allows employers to offer you higher base salaries and signing incentives.
              </p>
            </div>
          </div>

          <!-- Targeted Job Search CTA -->
          <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900 via-indigo-900 to-blue-950 text-white shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-2 text-center sm:text-left">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-800/80 text-blue-200 text-xs font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Transparent Pay Postings
              </div>
              <h3 id="ctaHeading" class="text-lg sm:text-xl font-bold">Find high-paying Software Engineer roles</h3>
              <p class="text-blue-200 text-xs sm:text-sm max-w-md">
                View verified listings with direct company application links and transparent pay ranges.
              </p>
            </div>
            <a
              id="ctaSearchBtn"
              href="/search?keyword=Software+Engineer"
              class="shrink-0 px-6 py-3 rounded-xl bg-white text-blue-900 hover:bg-blue-50 font-bold text-sm shadow-md transition-all flex items-center gap-2"
            >
              Browse Verified Jobs
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>
</Layout>

<script>
  const salaryForm = document.getElementById('salaryForm') as HTMLFormElement;
  const roleSelect = document.getElementById('role') as HTMLSelectElement;
  const expSelect = document.getElementById('experienceYears') as HTMLSelectElement;
  const countrySelect = document.getElementById('country') as HTMLSelectElement;

  async function updateSalary() {
    const role = roleSelect?.value || 'Software Engineer';
    const exp = expSelect?.value || '4';
    const country = countrySelect?.value || 'United States';

    try {
      const baseUrl = (typeof window !== 'undefined' && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'))
        ? 'http://localhost:4000'
        : '';
      const res = await fetch(`${baseUrl}/api/tools/salary-benchmark?role=${encodeURIComponent(role)}&experienceYears=${exp}&country=${encodeURIComponent(country)}`);
      const data = await res.json();

      if (data.percentiles) {
        const { p25, median, p90 } = data.percentiles;
        const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });

        const p25El = document.getElementById('p25Display');
        const medEl = document.getElementById('medianDisplay');
        const p90El = document.getElementById('p90Display');
        const ctaHead = document.getElementById('ctaHeading');
        const ctaBtn = document.getElementById('ctaSearchBtn');

        if (p25El) p25El.textContent = fmt.format(p25);
        if (medEl) medEl.textContent = fmt.format(median);
        if (p90El) p90El.textContent = fmt.format(p90);
        if (ctaHead) ctaHead.textContent = `Find high-paying ${role} roles`;
        if (ctaBtn) ctaBtn.setAttribute('href', `/search?keyword=${encodeURIComponent(role)}`);
      }
    } catch (err) {
      console.warn('Salary benchmark fetch failed:', err);
    }
  }

  if (salaryForm) {
    salaryForm.addEventListener('submit', (e) => {
      e.preventDefault();
      updateSalary();
    });
  }

  // Initial load
  updateSalary();
</script>
