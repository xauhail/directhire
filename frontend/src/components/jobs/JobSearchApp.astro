  // Saved Jobs View Mode
  function renderSavedJobsView() {
    if (!jobsContainer) return;
    const savedIds = getSavedJobIds();
    const cache = getSavedJobsCache();
    const savedJobs = savedIds.map(id => cache[id]).filter(Boolean);

    totalJobs = savedJobs.length;
    if (jobsCountNum) jobsCountNum.textContent = String(totalJobs);

    if (savedJobs.length === 0) {
      jobsContainer.innerHTML = `
        <div class="bg-white rounded-xl border border-slate-200 p-12 text-center space-y-3">
          <div class="w-12 h-12 rounded-full bg-blue-50 flex items-center justify-center mx-auto text-blue-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
            </svg>
          </div>
          <h4 class="text-base font-bold text-slate-900">No saved jobs yet</h4>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            Click the bookmark icon on any job card to save it here for quick access.
          </p>
          <button type="button" id="btn-browse-all-from-saved" class="mt-2 px-5 py-2.5 rounded-full bg-blue-600 text-white text-xs font-bold hover:bg-blue-700 transition-colors cursor-pointer shadow-sm">
            Browse All Jobs
          </button>
        </div>
      `;
      document.getElementById("btn-browse-all-from-saved")?.addEventListener("click", () => {
        toggleSavedMode(false);
      });
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = true;
      if (pageIndicator) pageIndicator.textContent = "Saved Jobs";
      return;
    }

    renderJobs(savedJobs);
    if (prevBtn) prevBtn.disabled = true;
    if (nextBtn) nextBtn.disabled = true;
    if (pageIndicator) pageIndicator.textContent = `${savedJobs.length} Bookmarked`;
  }

  function toggleSavedMode(enable?: boolean) {
    isSavedMode = typeof enable === "boolean" ? enable : !isSavedMode;
    updateSavedCountBadge();
    syncUrl();
    renderActiveChips();

    if (isSavedMode) {
      renderSavedJobsView();
    } else {
      performSearch(1);
    }
  }

  // Execute Search
  async function performSearch(page = 1, scrollToTop = false) {
    if (isSavedMode) {
      renderSavedJobsView();
      return;
    }

    currentPage = page;

    // Smoothly scroll to the top of the jobs results feed when navigating pages
    if (scrollToTop) {
      const anchor = document.getElementById("jobs-count-display") || jobsContainer;
      if (anchor) {
        const topPos = anchor.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top: Math.max(0, topPos), behavior: "smooth" });
      }
    }

    // Modern in-place SPA transition: gently dim container without layout collapse
    if (jobsContainer) {
      jobsContainer.style.opacity = "0.45";
      jobsContainer.style.pointerEvents = "none";
      jobsContainer.style.transition = "opacity 0.15s ease";
    }

    // Disable pagination buttons during request to prevent double-clicks
    if (prevBtn) prevBtn.disabled = true;
    if (nextBtn) nextBtn.disabled = true;

    // Only show big skeleton on initial empty load
    if (page === 1 && allLoadedJobs.length === 0 && jobsSkeleton) {
      jobsSkeleton.classList.remove("hidden");
    }

    const backendFilters: any = {};
    if (activeCategories.size > 0) backendFilters.categories = Array.from(activeCategories);
    if (activeCountries.size > 0) backendFilters.countries = Array.from(activeCountries);
    if (activeRemote === "remote-only") backendFilters.isRemoteOnly = true;
    else if (activeRemote) backendFilters.workArrangements = [activeRemote];
    if (activeSalary === "with-salary") backendFilters.hasCompensation = true;
    else if (activeSalary) backendFilters.salaryMinimum = Number(activeSalary);
    if (activeDate) backendFilters.daysAgo = activeDate;

    const { isLoggedIn, isSubscribed } = getAuthState();
    const effectivePageSize = isSubscribed ? 15 : 5;

    try {
      const res = await searchJobs({
        page: isSubscribed ? page : 1,
        pageSize: effectivePageSize,
        query: currentTitle,
        queryMode: isExactSearch ? "EXACT" : "FLEXIBLE",
        sort: currentSort,
        filters: backendFilters,
      }, isSubscribed, isLoggedIn);

      if (jobsSkeleton) jobsSkeleton.classList.add("hidden");
      totalJobs = res.totalJobs || 0;
      allLoadedJobs = res.items || [];

      if (jobsCountNum) jobsCountNum.textContent = totalJobs.toLocaleString();
      const jobsToDisplay = isSubscribed ? allLoadedJobs : allLoadedJobs.slice(0, 5);
      renderJobs(jobsToDisplay);

      // Restore container opacity & interactivity
      if (jobsContainer) {
        jobsContainer.style.opacity = "1";
        jobsContainer.style.pointerEvents = "auto";
      }

      // Pagination UI calculation (Free plan & guests limited to 5 jobs)
      if (!isSubscribed) {
        if (pageIndicator) pageIndicator.innerHTML = `Page 1 of 1 <span class="text-blue-600 font-bold ml-1">(Free Preview: 5 Jobs)</span>`;
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.innerHTML = `Next →`;
          nextBtn.title = isLoggedIn ? "Upgrade to Pro to unlock page 2" : "Log in or sign up to unlock page 2";
        }
      } else {
        const maxPages = Math.max(1, Math.ceil(totalJobs / 15));
        if (pageIndicator) pageIndicator.textContent = `Page ${page} of ${maxPages}`;
        if (prevBtn) prevBtn.disabled = page <= 1;
        if (nextBtn) {
          nextBtn.disabled = page * 15 >= totalJobs || page >= maxPages;
          nextBtn.innerHTML = `Next →`;
          nextBtn.title = "";
        }
      }

      syncUrl();
      renderActiveChips();
    } catch (err) {
      if (jobsSkeleton) jobsSkeleton.classList.add("hidden");
      if (jobsContainer) {
        jobsContainer.style.opacity = "1";
        jobsContainer.style.pointerEvents = "auto";
      }
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage * 15 >= totalJobs;
      console.error("Failed to search jobs:", err);
    }
  }

  function onFilterChange() {
    if (isSavedMode) {
      toggleSavedMode(false);
      return;
    }
    currentPage = 1;
    performSearch(1, false);
  }

  function resetAllFilters() {
    activeCategories.clear();
    activeCountries.clear();
    activeRemote = "";
    activeSalary = "";
    activeDate = "";
    currentTitle = "";
    isSavedMode = false;
    if (searchInput) searchInput.value = "";
    if (filterRemote) filterRemote.value = "";
    if (filterSalary) filterSalary.value = "";
    if (filterDate) filterDate.value = "";
    renderCategoryPills();
    renderCountryPills();
    renderActiveChips();
    updateSavedCountBadge();
    currentPage = 1;
    performSearch(1, true);
  }

  function parseJobDataFromElement(btn: HTMLElement): any {
    if (btn.dataset.jobJson) {
      try {
        const raw = btn.dataset.jobJson;
        return JSON.parse(raw.startsWith("%") ? decodeURIComponent(raw) : raw);
      } catch (_) {}
    }
    const card = btn.closest(".job-card") as HTMLElement;
    const jId = btn.dataset.jobId || card?.dataset.jobId || "";

    if (jId) {
      const cached = allLoadedJobs.find((j: any) => j.id === jId);
      if (cached) return cached;
    }

    const title = card?.querySelector(".job-title-btn")?.textContent?.trim() || "Verified Direct ATS Job";
    const company = card?.querySelector(".font-semibold.text-slate-700")?.textContent?.trim() || "Direct ATS Employer";
    const appLink = (card?.querySelector(".btn-apply-direct") as HTMLAnchorElement)?.href || "#";
    return {
      id: jId,
      title,
      company: { name: company },
      locations: ["Worldwide"],
      workArrangement: "Verified Direct",
      salaryBadge: "Competitive Salary",
      applicationUrl: appLink
    };
  }

  // Bind Card Button Listeners
  function bindCardActions() {
    // Title & More buttons -> Open Full Job Details Drawer
    document.querySelectorAll(".job-title-btn, .btn-more-jobs").forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = e.currentTarget as HTMLElement;
        const jobData = parseJobDataFromElement(target);
        openJobDetailsDrawer(jobData);
      });
    });

    // Save job bookmark
    document.querySelectorAll(".btn-save-job").forEach(btn => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const { isLoggedIn } = getAuthState();
        if (!isLoggedIn) {
          openAuthGateModal("Sign in or create a free account to bookmark jobs to your personal tracker.");
          return;
        }

        const target = e.currentTarget as HTMLElement;
        const jId = target.dataset.jobId;
        if (!jId) return;

        let saved: string[] = getSavedJobIds();
        const cache = getSavedJobsCache();

        if (saved.includes(jId)) {
          // Remove from bookmarks
          saved = saved.filter(id => id !== jId);
          delete cache[jId];
          localStorage.setItem("ch_saved_job_ids", JSON.stringify(saved));
          localStorage.setItem("ch_saved_jobs_cache", JSON.stringify(cache));

          showToast("Job removed from bookmarks", false);
          updateAllBookmarkIcons();

          if (isSavedMode) {
            renderSavedJobsView();
          }
        } else {
          // Save to bookmarks
          saved.push(jId);
          const jobData = parseJobDataFromElement(target);
          cache[jId] = jobData;
          localStorage.setItem("ch_saved_job_ids", JSON.stringify(saved));
          localStorage.setItem("ch_saved_jobs_cache", JSON.stringify(cache));

          showToast("Job saved to your bookmarks!", true, "/account#saved", "View in Account");
          updateAllBookmarkIcons();
        }
      });
    });

    // Apply Directly Button - Track Application
    document.querySelectorAll(".btn-apply-direct").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLAnchorElement;
        const { isLoggedIn } = getAuthState();
        const appUrl = target.getAttribute("href") || target.dataset.url;
        if (!isLoggedIn && (!appUrl || appUrl === "#" || !appUrl.startsWith("http"))) {
          e.preventDefault();
          openAuthGateModal("Sign in or create a free account to access direct ATS application links.");
          return;
        }

        if (!appUrl || appUrl === "#" || !appUrl.startsWith("http")) {
          e.preventDefault();
          showToast("Direct application link is currently undergoing live verification.", false);
          return;
        }

        const jId = target.dataset.jobId;
        if (!jId) return;

        // Cache job data for My Applications in /account
        const jobData = parseJobDataFromElement(target);
        const cache = getSavedJobsCache();
        cache[jId] = jobData;
        localStorage.setItem("ch_saved_jobs_cache", JSON.stringify(cache));

        let applied: string[] = JSON.parse(localStorage.getItem("ch_applied_job_ids") || "[]");
        if (!applied.includes(jId)) {
          applied.unshift(jId);
          localStorage.setItem("ch_applied_job_ids", JSON.stringify(applied));
        }

        showToast("Application tracked to your account!", true, "/account#applications", "View Applications");
      });
    });

    // Report
    document.querySelectorAll(".btn-report-job").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const modal = document.getElementById("report-modal");
        if (modal) modal.classList.remove("hidden");
      });
    });
  }

  // Unescape entity-encoded HTML strings (handles &lt;, &gt;, &amp;, etc. including multi-encoded strings)
  function unescapeHtml(text: string): string {
    if (!text) return "";
    let decoded = text;
    for (let i = 0; i < 3; i++) {
      if (!/&(?:amp|lt|gt|quot|#39|#38|nbsp);/i.test(decoded)) break;
      decoded = decoded
        .replace(/&lt;/gi, "<")
        .replace(/&gt;/gi, ">")
        .replace(/&quot;/gi, '"')
        .replace(/&#39;/gi, "'")
        .replace(/&amp;/gi, "&")
        .replace(/&#38;/gi, "&")
        .replace(/&nbsp;/gi, " ");
    }
    return decoded;
  }

  // Helper to format full job description text with clean paragraph/list HTML
  function formatJobDescription(rawDesc: string): string {
    if (!rawDesc || !rawDesc.trim()) {
      return "<p class='text-slate-500 italic'>No detailed job description provided for this listing.</p>";
    }
    const desc = unescapeHtml(rawDesc.trim());
    if (/<(?:h[1-6]|p|ul|ol|li|div|section|article|table|blockquote|strong|b|em|span|a)[\s>]/i.test(desc)) {
      return `<div class="job-html-content space-y-4 leading-relaxed">${desc}</div>`;
    }
    return `<div class="job-html-content space-y-4 leading-relaxed">` + desc
      .split(/\n{2,}/)
      .map(block => {
        const trimmed = block.trim();
        if (!trimmed) return "";
        const lines = trimmed.split(/\n/);
        const isBulletList = lines.every(l => /^[-*•\d+.]\s+/.test(l.trim()));
        if (isBulletList) {
          const listItems = lines.map(l => `<li class="ml-4 list-disc">${l.replace(/^[-*•\d+.]\s+/, "").trim()}</li>`).join("");
          return `<ul class="my-2 space-y-1 text-slate-700">${listItems}</ul>`;
        }
        return `<p class="mb-3 text-slate-700 leading-relaxed">${trimmed.replace(/\n/g, "<br/>")}</p>`;
      })
      .filter(Boolean)
      .join("") + `</div>`;
  }

  // Job Details Drawer State
  let activeDetailsJob: any = null;

  function openJobDetailsDrawer(job: any) {
    if (!job) return;
    activeDetailsJob = job;

    const drawer = document.getElementById("job-details-drawer");
    if (!drawer) return;

    // Company logo
    const logoEl = document.getElementById("details-company-logo") as HTMLImageElement;
    if (logoEl) {
      const realLogo = getCompanyRealLogo(job.company?.name || "Company", job.company?.websiteUrl, job.company?.slug, job.company?.logo, job.applicationUrl);
      logoEl.src = realLogo;
      logoEl.alt = job.company?.name || "Company Logo";
      logoEl.onerror = () => {
        logoEl.onerror = null;
        logoEl.src = getCompanyInitialsSvg(job.company?.name || "Company");
      };
    }

    // Company name
    const compNameEl = document.getElementById("details-company-name");
    if (compNameEl) compNameEl.textContent = job.company?.name || "Direct ATS Employer";

    // Industry
    const industryEl = document.getElementById("details-industry");
    if (industryEl) industryEl.textContent = job.company?.industry || "Technology";

    // Job Title
    const titleEl = document.getElementById("details-job-title");
    if (titleEl) titleEl.textContent = job.title || "Job Details";

    // Location
    const locEl = document.getElementById("details-location");
    const locStr = Array.isArray(job.locations) ? job.locations.join(" • ") : (job.locations || "Worldwide");
    if (locEl) locEl.textContent = locStr;

    // Work arrangement
    const workEl = document.getElementById("details-work-arrangement");
    if (workEl) workEl.textContent = job.workArrangement || "Verified Direct";

    // Salary
    const salaryEl = document.getElementById("details-salary");
    let salaryText = job.salaryBadge || "Direct ATS Rate";
    if (job.salary?.max) {
      salaryText = `${job.salary.currency || "$"}${job.salary.min ? `${job.salary.min.toLocaleString()} - ` : ""}${job.salary.max.toLocaleString()} / yr`;
    }
    if (salaryEl) salaryEl.textContent = salaryText;

    // Employment type
    const empEl = document.getElementById("details-employment-type");
    if (empEl) {
      const empType = Array.isArray(job.employmentTypes) && job.employmentTypes.length > 0
        ? job.employmentTypes.map((t: string) => t.charAt(0).toUpperCase() + t.slice(1)).join(", ")
        : "Full-time";
      empEl.textContent = empType;
    }

    // Experience
    const expEl = document.getElementById("details-experience");
    if (expEl) {
      expEl.textContent = job.experienceLevel ? `${job.experienceLevel} years` : "Mid-Senior Level";
    }

    // Date
    const dateEl = document.getElementById("details-date");
    if (dateEl) {
      const dateInfo = formatJobDate(job.published);
      dateEl.textContent = `${dateInfo.fullDate} (${dateInfo.relative})`;
    }

    // Skills
    const skillsList = document.getElementById("details-skills-list");
    const skillsSec = document.getElementById("details-skills-section");
    if (skillsList && skillsSec) {
      const skillsArr = Array.isArray(job.skills) ? job.skills : [];
      if (skillsArr.length > 0) {
        skillsSec.classList.remove("hidden");
        skillsList.innerHTML = skillsArr.map((s: string) => `
          <span class="px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-700 text-xs font-medium">
            ${s}
          </span>
        `).join("");
      } else {
        skillsSec.classList.add("hidden");
      }
    }

    // Full description
    const descEl = document.getElementById("details-description");
    if (descEl) {
      const fullDesc = job.descriptionFull || job.descriptionExcerpt || "";
      descEl.innerHTML = formatJobDescription(fullDesc);
    }

    // AI Apply Button
    const applyBtn = document.getElementById("details-btn-apply") as HTMLAnchorElement;
    if (applyBtn) {
      const hasHttp = job.applicationUrl && job.applicationUrl.startsWith("http");
      applyBtn.href = hasHttp ? job.applicationUrl : "#";
      applyBtn.setAttribute("data-job-id", job.id || "");
      applyBtn.setAttribute("data-url", job.applicationUrl || "#");
    }

    // Update bookmark state in drawer
    updateDrawerSaveButtonState();

    drawer.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeJobDetailsDrawer() {
    const drawer = document.getElementById("job-details-drawer");
    drawer?.classList.add("hidden");
    document.body.style.overflow = "";
    activeDetailsJob = null;
  }

  function updateDrawerSaveButtonState() {
    if (!activeDetailsJob || !activeDetailsJob.id) return;
    const savedIds = getSavedJobIds();
    const isSaved = savedIds.includes(activeDetailsJob.id);
    const saveBtn = document.getElementById("details-btn-save");
    const label = document.getElementById("details-save-label");
    if (saveBtn && label) {
      if (isSaved) {
        saveBtn.classList.add("bg-blue-50", "border-blue-300", "text-blue-600");
        saveBtn.classList.remove("bg-white", "border-slate-300", "text-slate-700");
        label.textContent = "Saved";
      } else {
        saveBtn.classList.remove("bg-blue-50", "border-blue-300", "text-blue-600");
        saveBtn.classList.add("bg-white", "border-slate-300", "text-slate-700");
        label.textContent = "Save";
      }
    }
  }

