  });
  document.getElementById("btn-cancel-report")?.addEventListener("click", () => {
    document.getElementById("report-modal")?.classList.add("hidden");
  });
  document.getElementById("btn-submit-report")?.addEventListener("click", () => {
    alert("Report received! Our team will verify the direct application URL within 4 hours.");
    document.getElementById("report-modal")?.classList.add("hidden");
  });

  // Mobile Drawer
  const mobileDrawer = document.getElementById("mobile-filter-drawer");
  const filtersContainer = document.getElementById("filters-container");
  const desktopSidebar = document.getElementById("desktop-filters-sidebar");
  const mobileContent = document.getElementById("mobile-drawer-content");

  function openMobileDrawer() {
    if (filtersContainer && mobileContent && filtersContainer.parentElement !== mobileContent) {
      mobileContent.appendChild(filtersContainer);
    }
    mobileDrawer?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeMobileDrawer() {
    mobileDrawer?.classList.add("hidden");
    document.body.style.overflow = "";
    if (window.innerWidth >= 1024 && filtersContainer && desktopSidebar && filtersContainer.parentElement !== desktopSidebar) {
      desktopSidebar.appendChild(filtersContainer);
    }
  }

  document.getElementById("btn-mobile-filters")?.addEventListener("click", openMobileDrawer);
  document.getElementById("btn-close-mobile-drawer")?.addEventListener("click", closeMobileDrawer);
  document.getElementById("mobile-drawer-backdrop")?.addEventListener("click", closeMobileDrawer);

  document.getElementById("btn-mobile-apply")?.addEventListener("click", () => {
    closeMobileDrawer();
    onFilterChange();
  });

  document.getElementById("btn-mobile-clear-all")?.addEventListener("click", () => {
    resetAllFilters();
    closeMobileDrawer();
  });

  // Restore filtersContainer to desktop sidebar when resized to desktop (>= 1024px)
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      if (filtersContainer && desktopSidebar && filtersContainer.parentElement !== desktopSidebar) {
        desktopSidebar.appendChild(filtersContainer);
      }
      mobileDrawer?.classList.add("hidden");
      document.body.style.overflow = "";
    }
  });

  // History PopState (Browser Back/Forward without page reload)
  window.addEventListener("popstate", () => {
    parseUrlParams();
    renderCategoryPills();
    renderCountryPills();
    renderActiveChips();
    performSearch(currentPage, false);
  });
</script>
