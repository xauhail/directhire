---
import Layout from "../../layouts/Layout.astro";
import InFeedCTA from "../common/InFeedCTA.astro";

interface Props {
  initialSlug?: string;
}

const { initialSlug = "all" } = Astro.props;

// Schema for SEO
const searchPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Search Verified Jobs Directly on Company Websites | Career Hound",
  description:
    "Discover current open jobs directly from company career portals (Greenhouse, Lever, Ashby, Workday).",
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://careerhound.io/" },
      { "@type": "ListItem", position: 2, name: "Job Search", item: "https://careerhound.io/job-search/all" },
    ],
  },
};

// 33 Canonical CareerHound Categories
const CATEGORY_OPTIONS = [
  { label: "Engineering", value: "engineering" },
  { label: "Software", value: "software" },
  { label: "Technology", value: "technology" },
  { label: "Data & Analytics", value: "data-and-analytics" },
  { label: "Art & Design", value: "art-and-design" },
  { label: "Creative & Media", value: "creative-and-media" },
  { label: "Management & Leadership", value: "management-and-leadership" },
  { label: "Consulting", value: "consulting" },
  { label: "Administrative", value: "administrative" },
  { label: "Legal", value: "legal" },
  { label: "Finance & Accounting", value: "finance-and-accounting" },
  { label: "Human Resources", value: "human-resources" },
  { label: "Manufacturing", value: "manufacturing" },
  { label: "Environmental & Sustainability", value: "environmental-and-sustainability" },
  { label: "Security & Safety", value: "security-and-safety" },
  { label: "Science & Research", value: "science-and-research" },
  { label: "Food & Beverage", value: "food-and-beverage" },
  { label: "Hospitality", value: "hospitality" },
  { label: "Sales", value: "sales" },
  { label: "Marketing", value: "marketing" },
  { label: "Government & Public Sector", value: "government-and-public-sector" },
  { label: "Healthcare", value: "healthcare" },
  { label: "Agriculture", value: "agriculture" },
  { label: "Education", value: "education" },
  { label: "Customer Service & Support", value: "customer-service-and-support" },
  { label: "Social Services", value: "social-services" },
  { label: "Construction", value: "construction" },
  { label: "Trades", value: "trades" },
  { label: "Transportation", value: "transportation" },
  { label: "Logistics", value: "logistics" },
  { label: "Retail", value: "retail" },
  { label: "Energy", value: "energy" },
  { label: "Sports & Recreation", value: "sports-and-recreation" }
];

const COUNTRY_OPTIONS = [
  { label: "Worldwide (Anywhere)", value: "Worldwide" },
  { label: "United States", value: "United States" },
  { label: "United Kingdom", value: "United Kingdom" },
  { label: "Canada", value: "Canada" },
  { label: "Australia", value: "Australia" },
  { label: "Germany", value: "Germany" },
  { label: "India", value: "India" },
  { label: "Singapore", value: "Singapore" },
  { label: "Switzerland", value: "Switzerland" },
  { label: "United Arab Emirates", value: "United Arab Emirates" }
];

// Parse initial SSR search parameters
const searchParams = Astro.url.searchParams;
const initialTitle = searchParams.get("title") || searchParams.get("query") || searchParams.get("q") || "";

// Extract categories from URL
const rawCategories = searchParams.getAll("categories").concat(
  searchParams.get("categories")?.split(",") || []
).concat(
  searchParams.get("category")?.split(",") || []
).map(c => c.trim().toLowerCase()).filter(Boolean);

// If slug is a specific category (not "all"), add it
if (initialSlug && initialSlug !== "all" && !rawCategories.includes(initialSlug)) {
  rawCategories.push(initialSlug.toLowerCase());
}

const initialCategories = Array.from(new Set(rawCategories));

// Countries
const rawCountries = searchParams.getAll("countries").concat(
  searchParams.get("countries")?.split(",") || []
).concat(
  searchParams.get("country")?.split(",") || []
).map(c => c.trim()).filter(Boolean);
const initialCountries = Array.from(new Set(rawCountries));

// Workplace / Remote
const initialRemote = searchParams.get("remote") || searchParams.get("workplace") || "";
const initialIsRemoteOnly = searchParams.get("isRemoteOnly") === "true" || initialRemote === "remote-only";

// Salary
const initialSalary = searchParams.get("salary") || "";
const initialHasCompensation = searchParams.get("hasCompensation") === "true" || initialSalary === "with-salary";
const initialSalaryMin = Number(searchParams.get("salaryMinimum") || searchParams.get("minSalary") || 0);

// Date
const initialDaysAgo = searchParams.get("daysAgo") || searchParams.get("datePosted") || searchParams.get("date") || "";

// Fetch initial jobs for SSR
let initialJobs: any[] = [];
let initialTotal = 0;

try {
  const backendFilters: any = {};
  if (initialCategories.length > 0) backendFilters.categories = initialCategories;
  if (initialCountries.length > 0) backendFilters.countries = initialCountries;
  if (initialIsRemoteOnly) backendFilters.isRemoteOnly = true;
  else if (initialRemote && initialRemote !== "all") backendFilters.workArrangements = [initialRemote];
  if (initialHasCompensation) backendFilters.hasCompensation = true;
  if (initialSalaryMin > 0) backendFilters.salaryMinimum = initialSalaryMin;
  if (initialDaysAgo && initialDaysAgo !== "all") backendFilters.daysAgo = initialDaysAgo;

  const res = await fetch("http://localhost:4000/api/job-search", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      page: 1,
      pageSize: 15,
      query: initialTitle,
      filters: backendFilters,
    }),
  });

  if (res.ok) {
    const data = await res.json();
    initialJobs = data.items || [];
    initialTotal = data.totalJobs || 0;
  }
} catch (e) {
  // Client script will fetch gracefully
}

function formatJobDateSSR(iso: string): { relative: string; fullDate: string } {
  if (!iso) return { relative: "Recently", fullDate: "Recently" };
  const d = new Date(iso);
  if (isNaN(d.getTime())) return { relative: "Recently", fullDate: "Recently" };
  const diff = Date.now() - d.getTime();
  const mins = Math.floor(diff / 60000);
  const hrs = Math.floor(mins / 60);
  const days = Math.floor(hrs / 24);
  let relative = "";
  if (mins < 60) relative = `${Math.max(1, mins)}m ago`;
  else if (hrs < 24) relative = `${hrs}h ago`;
  else if (days === 1) relative = "Yesterday";
  else if (days < 30) relative = `${days}d ago`;
  else relative = `${Math.floor(days / 30)}mo ago`;

  const fullDate = d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  return { relative, fullDate };
}

function formatTimeAgo(iso: string): string {
  return formatJobDateSSR(iso).relative;
}
---

<Layout
  title={initialCategories.length > 0 
    ? `${CATEGORY_OPTIONS.find(c => c.value === initialCategories[0])?.label || "Category"} Jobs | Career Hound`
    : "Search Jobs | Career Hound"}
  description="Search verified jobs posted directly on company career portals. No LinkedIn or Indeed middlemen."
  jsonLd={searchPageSchema}
>
  <!-- Top Navigation Subheader: Search Job Title Bar -->
  <section class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
      <form id="search-form" class="flex flex-col sm:flex-row items-center gap-3">
        <!-- Search Input -->
        <div class="relative w-full sm:flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="text"
            id="search-input"
            name="title"
            value={initialTitle}
            placeholder="Search job title... (Exact search)"
            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 bg-white placeholder:text-slate-400 font-medium"
          />
        </div>

        <!-- Search Controls -->
        <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
          <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-slate-700 select-none">
            <input type="checkbox" id="exact-search-toggle" class="sr-only peer" />
            <div class="w-8 h-4 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-blue-600 relative"></div>
            <span>Exact search</span>
          </label>

          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-xs transition-colors shrink-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Search</span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Main Content Layout (Left Sidebar + Right Job Feed) -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-8">
    <div class="lg:flex lg:gap-8 items-start">
      
      <!-- ─── LEFT SIDEBAR FILTERS (Desktop) ─── -->
      <aside class="hidden lg:block w-[300px] shrink-0 sticky top-24 space-y-4">
        <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-5 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Filters</h2>
            <button
              type="button"
              id="btn-reset-filters"
              class="text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors"
            >
              Reset all
            </button>
          </div>

          <!-- 1. Category Multi-Select Filter -->
          <div class="space-y-1.5" id="category-filter-group">
            <label class="text-xs font-bold text-slate-700 block">Category</label>
            <div class="relative">
              <!-- Trigger Box (React-Select Style) -->
              <div
                id="category-select-box"
                class="min-h-[38px] p-1.5 rounded-md border border-slate-300 bg-white flex flex-wrap items-center gap-1.5 cursor-pointer hover:border-slate-400 focus-within:ring-2 focus-within:ring-blue-500 transition-all text-xs"
              >
                <!-- Selected category pills dynamically placed here -->
                <div id="category-selected-pills" class="flex flex-wrap gap-1.5 items-center"></div>
                <input
                  type="text"
                  id="category-search-input"
                  placeholder="Category..."
                  class="flex-1 min-w-[80px] bg-transparent outline-none text-xs text-slate-800 placeholder:text-slate-400 py-1 px-1"
                />
              </div>

              <!-- Category Dropdown List -->
              <div
                id="category-dropdown-menu"
                class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-xl max-h-60 overflow-y-auto z-50 p-1.5 space-y-0.5 text-xs"
              >
                {CATEGORY_OPTIONS.map((cat) => (
                  <label
                    class="category-option flex items-center justify-between px-3 py-2 rounded-md hover:bg-blue-50 cursor-pointer text-slate-700 select-none transition-colors"
                    data-value={cat.value}
                    data-label={cat.label}
                  >
                    <span class="category-name font-medium">{cat.label}</span>
                    <input
                      type="checkbox"
                      class="category-checkbox h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                      value={cat.value}
                      checked={initialCategories.includes(cat.value)}
                    />
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- 2. Country Multi-Select Filter -->
          <div class="space-y-1.5" id="country-filter-group">
            <label class="text-xs font-bold text-slate-700 block">Country</label>
            <div class="relative">
              <div
                id="country-select-box"
                class="min-h-[38px] p-1.5 rounded-md border border-slate-300 bg-white flex flex-wrap items-center gap-1.5 cursor-pointer hover:border-slate-400 focus-within:ring-2 focus-within:ring-blue-500 transition-all text-xs"
              >
                <div id="country-selected-pills" class="flex flex-wrap gap-1.5 items-center"></div>
                <input
                  type="text"
                  id="country-search-input"
                  placeholder="Country..."
                  class="flex-1 min-w-[70px] bg-transparent outline-none text-xs text-slate-800 placeholder:text-slate-400 py-1 px-1"
                />
              </div>

              <div
                id="country-dropdown-menu"
                class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-xl max-h-60 overflow-y-auto z-50 p-1.5 space-y-0.5 text-xs"
              >
                {COUNTRY_OPTIONS.map((country) => (
                  <label
                    class="country-option flex items-center justify-between px-3 py-2 rounded-md hover:bg-blue-50 cursor-pointer text-slate-700 select-none transition-colors"
                    data-value={country.value}
                    data-label={country.label}
                  >
                    <span class="country-name font-medium">{country.label}</span>
                    <input
                      type="checkbox"
                      class="country-checkbox h-3.5 w-3.5 rounded border-slate-300 text-blue-600 focus:ring-blue-500"
                      value={country.value}
                      checked={initialCountries.includes(country.value)}
                    />
                  </label>
                ))}
              </div>
            </div>
          </div>

          <!-- 3. Remote Filter Dropdown -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 block">Remote</label>
            <select
              id="filter-remote"
              class="w-full px-3 py-2 rounded-md border border-slate-300 bg-white text-xs font-medium text-slate-700 hover:border-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer"
            >
              <option value="">Remote...</option>
              <option value="remote-only" selected={initialIsRemoteOnly}>Remote Only</option>
              <option value="remote-solely" selected={initialRemote === "remote-solely"}>Remote Solely (No office)</option>
              <option value="remote-ok" selected={initialRemote === "remote-ok"}>Remote OK (Office available)</option>
              <option value="hybrid" selected={initialRemote === "hybrid"}>Hybrid</option>
              <option value="on-site" selected={initialRemote === "on-site"}>On-site</option>
            </select>
          </div>

          <!-- 4. Salary Filter Dropdown -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 block">Salary</label>
            <select
              id="filter-salary"
              class="w-full px-3 py-2 rounded-md border border-slate-300 bg-white text-xs font-medium text-slate-700 hover:border-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer"
            >
              <option value="">Salary...</option>
              <option value="with-salary" selected={initialHasCompensation}>With Salary Specified</option>
              <option value="50000" selected={initialSalaryMin === 50000}>$50,000+ USD</option>
              <option value="100000" selected={initialSalaryMin === 100000}>$100,000+ USD</option>
              <option value="150000" selected={initialSalaryMin === 150000}>$150,000+ USD</option>
              <option value="200000" selected={initialSalaryMin === 200000}>$200,000+ USD</option>
            </select>
          </div>

          <!-- 5. Date Filter Dropdown -->
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700 block">Date</label>
            <select
              id="filter-date"
              class="w-full px-3 py-2 rounded-md border border-slate-300 bg-white text-xs font-medium text-slate-700 hover:border-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer"
            >
              <option value="">Date...</option>
              <option value="1" selected={initialDaysAgo === "1"}>Past 24 hours</option>
              <option value="3" selected={initialDaysAgo === "3"}>Past 3 days</option>
              <option value="7" selected={initialDaysAgo === "7"}>Past 7 days (1 week)</option>
              <option value="14" selected={initialDaysAgo === "14"}>Past 14 days (2 weeks)</option>
              <option value="30" selected={initialDaysAgo === "30"}>Past 30 days (1 month)</option>
            </select>
          </div>
        </div>

        <!-- Direct ATS Guarantee Card -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-xl p-4 text-xs space-y-2">
          <div class="flex items-center gap-1.5 font-bold text-blue-900">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>100% Direct-From-Source</span>
          </div>
          <p class="text-slate-600 leading-relaxed text-[11px]">
            Every job links directly to company applicant tracking systems (Greenhouse, Lever, Ashby, Workday). Zero third-party aggregator spam.
          </p>
        </div>
      </aside>

      <!-- ─── RIGHT CONTENT: JOB FEED ─── -->
      <div class="flex-1 min-w-0">
        <!-- Results Bar: Count + Active Filter Tags + Mobile Filter Trigger -->
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-xl border border-slate-200 shadow-xs">
          <div class="flex items-center gap-3">
            <p class="text-sm sm:text-base font-bold text-slate-800" id="jobs-count-display">
              <span id="jobs-count-number" class="text-blue-600 font-extrabold">{initialTotal.toLocaleString()}</span> jobs
            </p>
            <!-- Active Filter Chips -->
            <div id="active-filter-chips" class="hidden sm:flex flex-wrap items-center gap-1.5 text-xs"></div>
          </div>

          <div class="flex items-center gap-2">
            <!-- Saved Jobs Quick Toggle -->
            <button
              type="button"
              id="btn-toggle-saved"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-xs transition-all cursor-pointer"
              title="Filter by saved jobs"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500">
                <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
              </svg>
              <span>Saved</span>
              <span id="saved-count-badge" class="px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px] font-bold">0</span>
            </button>

            <!-- Mobile Filter Modal Button -->
            <button
              type="button"
              id="btn-mobile-filters"
              class="lg:hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 font-semibold text-xs shadow-xs hover:bg-slate-50 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="21" x2="4" y2="14"></line>
                <line x1="4" y1="10" x2="4" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12" y2="3"></line>
                <line x1="20" y1="21" x2="20" y2="16"></line>
                <line x1="20" y1="12" x2="20" y2="3"></line>
                <line x1="1" y1="14" x2="7" y2="14"></line>
                <line x1="9" y1="8" x2="15" y2="8"></line>
                <line x1="17" y1="16" x2="23" y2="16"></line>
              </svg>
              <span>Filters</span>
              <span id="mobile-filter-badge" class="hidden px-1.5 py-0.2 bg-blue-600 text-white rounded-full text-[10px] font-bold">0</span>
            </button>

            <!-- Sort Select -->
            <select
              id="sort-select"
              class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:border-slate-400 focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer"
            >
              <option value="RELEVANCE">Most Relevant</option>
              <option value="NEWEST">Newest First</option>
            </select>
          </div>
        </div>

        <!-- InFeed Marketing CTA Banner -->
        <div class="mb-5">
          <InFeedCTA />
        </div>

        <!-- Job Feed Container -->
        <div id="jobs-container" class="space-y-4">
          {initialJobs.slice(0, 5).map((job) => {
            const companyName = job.company?.name || "Direct ATS Employer";
            const companyLogo = job.company?.logo || "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=128&q=80";
            const locationStr = Array.isArray(job.locations) ? job.locations.join(" • ") : (job.locations || "Worldwide");
            const salaryBadge = job.salary?.max 
              ? `${job.salary.currency || "$"}${job.salary.min ? job.salary.min.toLocaleString() + " - " : ""}${job.salary.max.toLocaleString()} (${job.salary.currency || "USD"})`
              : (job.salary?.min ? `${job.salary.currency || "$"}${job.salary.min.toLocaleString()}+` : "");

            return (
              <div class="job-card bg-white rounded-xl border border-slate-200 shadow-xs hover:shadow-md transition-all p-5 space-y-4" data-job-id={job.id}>
                <!-- Card Header -->
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-3.5 min-w-0">
                    <img
                      src={companyLogo}
                      alt={companyName}
                      class="w-12 h-12 rounded-lg object-cover border border-slate-100 bg-slate-50 shrink-0"
                      onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=128&q=80'"
                    />
                    <div class="min-w-0">
                      <h3 class="text-base sm:text-lg font-bold text-slate-900 hover:text-blue-600 transition-colors cursor-pointer truncate job-title-btn" data-job-id={job.id}>
                        {job.title}
                      </h3>
                      <div class="flex flex-wrap items-center gap-2 mt-1 text-xs text-slate-500">
                        <span class="font-semibold text-slate-700">{companyName}</span>
                        <span>•</span>
                        <span>{locationStr}</span>
                        {job.workArrangement && (
                          <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-medium text-[11px]">
                            {job.workArrangement}
                          </span>
                        )}
                        <span class="text-slate-400">• Posted: <strong class="text-slate-600 font-semibold">{formatJobDateSSR(job.published).fullDate}</strong> ({formatJobDateSSR(job.published).relative})</span>
                      </div>
                    </div>
                  </div>

                  <!-- Save Bookmark Button -->
                  <button
                    type="button"
