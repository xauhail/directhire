            >
              <span>Apply Directly</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
        `;
      }).join("");

      if (!isLoggedIn && compJobs.length > 3) {
        const lockedCount = compJobs.length - 3;
        listEl.innerHTML += `
          <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/70 text-center space-y-2 mt-2">
            <div class="inline-flex items-center gap-1.5 text-blue-700 font-bold text-xs uppercase tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>+${lockedCount} More Openings Locked</span>
            </div>
            <p class="text-xs text-slate-600">Create a free account or sign in to browse all verified direct ATS jobs at ${name}.</p>
            <a href="/login?tab=signup&next=/job-search/all" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-xs transition-colors">
              <span>Unlock All Openings</span>
            </a>
          </div>
        `;
      }
    } catch (err) {
      console.warn("Company drawer fetch failed, checking local jobs cache:", err);
      const fallbackJobs = allLoadedJobs.filter(
        (j: any) =>
          (slug && j.company?.slug === slug) ||
          (name && (j.company?.name || "").toLowerCase().includes(name.toLowerCase()))
      );

      if (fallbackJobs.length > 0) {
        if (nameEl) nameEl.textContent = `${name} (${fallbackJobs.length} Verified ${fallbackJobs.length === 1 ? 'Opening' : 'Openings'})`;
        listEl.innerHTML = fallbackJobs.map((j: any) => {
          const dateInfo = formatJobDate(j.published);
          const locStr = Array.isArray(j.locations) ? j.locations.join(" • ") : (j.locations || "Worldwide");
          const isCurrent = currentJobId && j.id === currentJobId;
          return `
            <div class="p-4 rounded-xl border ${isCurrent ? 'border-blue-300 bg-blue-50/30 ring-1 ring-blue-200' : 'border-slate-200 bg-white'} space-y-2.5 shadow-2xs hover:border-slate-300 transition-all">
              <div class="flex items-start justify-between gap-3">
                <h4 class="font-bold text-sm text-slate-900 leading-snug">${j.title}</h4>
                ${j.workArrangement ? `<span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-semibold shrink-0">${j.workArrangement}</span>` : ""}
              </div>
              <div class="flex flex-wrap items-center gap-2 pt-0.5">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-blue-50/90 border border-blue-200/80 text-blue-900 text-[11px] font-semibold">
                  <span>Posted: <strong class="font-bold text-blue-950">${dateInfo.fullDate}</strong> (${dateInfo.relative})</span>
                </div>
              </div>
              <div class="text-xs text-slate-500">${locStr}</div>
              <div class="pt-2 flex items-center justify-between border-t border-slate-100">
                <span class="text-xs font-bold text-emerald-600">${j.salary?.max ? `${j.salary.currency || "$"}${j.salary.max.toLocaleString()}` : "Direct ATS"}</span>
                <a href="${j.applicationUrl || '#'}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition-colors">Apply Directly</a>
              </div>
            </div>
          `;
        }).join("");
      } else {
        listEl.innerHTML = `<div class="p-8 text-center text-xs text-rose-500 font-medium">Failed to load company openings. Please check your connection and try again.</div>`;
      }
    }
  }

  // Initialize
  btnToggleSaved?.addEventListener("click", () => {
    const { isLoggedIn } = getAuthState();
    if (!isLoggedIn) {
      openAuthGateModal("Sign in or create a free account to access saved job tracking.");
      return;
    }
    toggleSavedMode();
  });

  parseUrlParams();
  renderCategoryPills();
  renderCountryPills();
  renderActiveChips();
  bindCardActions();
  updateAllBookmarkIcons();
  updateSavedCountBadge();

  // Client hydration check
  const initialAuth = getAuthState();
  if (initialAuth.isLoggedIn) {
    // Authenticated user: remove SSR paywalls & blurred teasers, fetch full 15 jobs
    document.getElementById("ssr-paywall-card")?.remove();
    document.getElementById("ssr-blurred-teasers")?.remove();
    performSearch(currentPage, false);
  } else {
    // Guest user: setup preview pagination state
    if (pageIndicator) pageIndicator.innerHTML = `Page 1 of 1 <span class="text-blue-600 font-bold ml-1">(Free Preview: 5 Jobs)</span>`;
    if (prevBtn) prevBtn.disabled = true;
    if (nextBtn) {
      nextBtn.disabled = false;
      nextBtn.innerHTML = `Next →`;
      nextBtn.title = "Log in or sign up to unlock page 2";
    }
  }

  if (isSavedMode) {
    renderSavedJobsView();
  }

  // Search Form Submit
  searchForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    currentTitle = searchInput?.value.trim() || "";
    isExactSearch = exactToggle?.checked || false;
    onFilterChange();
  });

  // Sort Change
  sortSelect?.addEventListener("change", () => {
    currentSort = sortSelect.value;
    onFilterChange();
  });

  // Remote Change
  filterRemote?.addEventListener("change", () => {
    activeRemote = filterRemote.value;
    onFilterChange();
  });

  // Salary Change
  filterSalary?.addEventListener("change", () => {
    activeSalary = filterSalary.value;
    onFilterChange();
  });

  // Date Change
  filterDate?.addEventListener("change", () => {
    activeDate = filterDate.value;
    onFilterChange();
  });

  // Reset Filters
  btnReset?.addEventListener("click", resetAllFilters);

  // Pagination (SPA in-place without page reload)
  prevBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (currentPage > 1) {
      performSearch(currentPage - 1, true);
    }
  });
  nextBtn?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    const { isLoggedIn } = getAuthState();
    if (!isLoggedIn) {
      openAuthGateModal("Sign in or create a free account to unlock Page 2 and all 100,000+ jobs.");
      return;
    }
    performSearch(currentPage + 1, true);
  });

  // Category Dropdown Toggle
  catSelectBox?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("remove-cat-btn")) {
      const val = target.dataset.cat;
      if (val) {
        activeCategories.delete(val);
        renderCategoryPills();
        onFilterChange();
      }
      return;
    }
    catDropdown?.classList.toggle("hidden");
  });

  // Category Checkbox Toggle
  document.querySelectorAll(".category-checkbox").forEach(cb => {
    cb.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.checked) {
        activeCategories.add(input.value);
      } else {
        activeCategories.delete(input.value);
      }
      renderCategoryPills();
      onFilterChange();
    });
  });

  // Category Search Filter in dropdown
  catSearchInput?.addEventListener("input", () => {
    const q = catSearchInput.value.toLowerCase().trim();
    document.querySelectorAll(".category-option").forEach(opt => {
      const el = opt as HTMLElement;
      const label = el.dataset.label?.toLowerCase() || "";
      if (label.includes(q)) {
        el.classList.remove("hidden");
      } else {
        el.classList.add("hidden");
      }
    });
  });

  // Country Dropdown Toggle
  countrySelectBox?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("remove-country-btn")) {
      const val = target.dataset.country;
      if (val) {
        activeCountries.delete(val);
        renderCountryPills();
        onFilterChange();
      }
      return;
    }
    countryDropdown?.classList.toggle("hidden");
  });

  document.querySelectorAll(".country-checkbox").forEach(cb => {
    cb.addEventListener("change", (e) => {
      const input = e.target as HTMLInputElement;
      if (input.checked) {
        activeCountries.add(input.value);
      } else {
        activeCountries.delete(input.value);
      }
      renderCountryPills();
      onFilterChange();
    });
  });

  countrySearchInput?.addEventListener("input", () => {
    const q = countrySearchInput.value.toLowerCase().trim();
    document.querySelectorAll(".country-option").forEach(opt => {
      const el = opt as HTMLElement;
      const label = el.dataset.label?.toLowerCase() || "";
      if (label.includes(q)) {
        el.classList.remove("hidden");
      } else {
        el.classList.add("hidden");
      }
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!catSelectBox?.contains(target) && !catDropdown?.contains(target)) {
      catDropdown?.classList.add("hidden");
    }
    if (!countrySelectBox?.contains(target) && !countryDropdown?.contains(target)) {
      countryDropdown?.classList.add("hidden");
    }
  });

  // Close Company Drawer
  document.getElementById("btn-close-company-drawer")?.addEventListener("click", () => {
    document.getElementById("company-drawer")?.classList.add("hidden");
  });
  document.getElementById("company-drawer-backdrop")?.addEventListener("click", () => {
    document.getElementById("company-drawer")?.classList.add("hidden");
  });

  // Report Modal
  document.getElementById("btn-close-report")?.addEventListener("click", () => {
    document.getElementById("report-modal")?.classList.add("hidden");
  });
  document.getElementById("btn-cancel-report")?.addEventListener("click", () => {
    document.getElementById("report-modal")?.classList.add("hidden");
  });
  document.getElementById("btn-submit-report")?.addEventListener("click", () => {
    alert("Report received! Our team will verify the direct application URL within 4 hours.");
    document.getElementById("report-modal")?.classList.add("hidden");
  });

  // Mobile Drawer
  const mobileDrawer = document.getElementById("mobile-filter-drawer");
  document.getElementById("btn-mobile-filters")?.addEventListener("click", () => {
    const content = document.getElementById("mobile-drawer-content");
    const sidebar = document.querySelector("aside > div");
    if (content && sidebar) {
      content.innerHTML = sidebar.innerHTML;
    }
    mobileDrawer?.classList.remove("hidden");
  });
  document.getElementById("btn-close-mobile-drawer")?.addEventListener("click", () => {
    mobileDrawer?.classList.add("hidden");
  });
  document.getElementById("mobile-drawer-backdrop")?.addEventListener("click", () => {
    mobileDrawer?.classList.add("hidden");
  });
  document.getElementById("btn-mobile-apply")?.addEventListener("click", () => {
    mobileDrawer?.classList.add("hidden");
    onFilterChange();
  });
  document.getElementById("btn-mobile-clear-all")?.addEventListener("click", () => {
    resetAllFilters();
    mobileDrawer?.classList.add("hidden");
  });

  // History PopState (Browser Back/Forward without page reload)
  window.addEventListener("popstate", () => {
    parseUrlParams();
    renderCategoryPills();
    renderCountryPills();
    renderActiveChips();
    performSearch(currentPage, false);
  });
</script>
