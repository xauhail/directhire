  authClient.getSession().then((sessionRes: any) => {
    if (sessionRes?.data?.user) {
      const u = sessionRes.data.user;
      let cached: any = {};
      try { cached = JSON.parse(localStorage.getItem('ch_user') || '{}'); } catch (_) {}
      const mergedUser = {
        ...cached,
        id: u.id,
        name: u.name || cached.name,
        email: u.email || cached.email,
        emailVerified: u.emailVerified ?? cached.emailVerified ?? false,
        plan: (u as any).plan || cached.plan || 'free',
        isSubscribed: (u as any).isSubscribed ?? cached.isSubscribed ?? false,
      };
      localStorage.setItem('ch_user', JSON.stringify(mergedUser));
      localStorage.setItem('ch_token', u.id);
      localStorage.setItem('ch_authenticated', '1');

      if (mergedUser.isSubscribed) {
        document.getElementById("ssr-paywall-card")?.remove();
        document.getElementById("ssr-blurred-teasers")?.remove();
        performSearch(currentPage, false);
      } else {
        updatePaywallUI();
        if (nextBtn) nextBtn.title = "Upgrade to Pro to unlock page 2";
