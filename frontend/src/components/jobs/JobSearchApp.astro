              <span id="details-salary" class="font-bold text-emerald-600">Competitive Salary</span>
            </div>
            <div>
              <span class="text-slate-400 text-[11px] uppercase tracking-wider font-semibold block mb-0.5">Job Type</span>
              <span id="details-employment-type" class="font-bold text-slate-800">Full-time</span>
