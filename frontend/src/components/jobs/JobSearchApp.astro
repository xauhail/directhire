  // Render Active Filter Chips on Top Results Bar
  function renderActiveChips() {
    if (!activeChips) return;
    activeChips.innerHTML = "";

    activeCategories.forEach(catVal => {
      const label = CATEGORIES.find(c => c.value === catVal)?.label || catVal;
      addChip(label, () => {
        activeCategories.delete(catVal);
        renderCategoryPills();
        onFilterChange();
      });
    });

    activeCountries.forEach(country => {
      addChip(country, () => {
        activeCountries.delete(country);
        renderCountryPills();
        onFilterChange();
      });
    });

    if (activeRemote) {
      const label = activeRemote === "remote-only" ? "Remote Only" : activeRemote;
      addChip(label, () => {
        activeRemote = "";
        if (filterRemote) filterRemote.value = "";
        onFilterChange();
      });
    }

    if (activeSalary) {
      const label = activeSalary === "with-salary" ? "With Salary" : `$${parseInt(activeSalary).toLocaleString()}+`;
      addChip(label, () => {
        activeSalary = "";
        if (filterSalary) filterSalary.value = "";
        onFilterChange();
      });
    }

    if (activeDate) {
      addChip(`Past ${activeDate} days`, () => {
        activeDate = "";
        if (filterDate) filterDate.value = "";
        onFilterChange();
      });
    }

    if (isSavedMode) {
      addChip(`Saved Jobs (${getSavedJobIds().length})`, () => {
