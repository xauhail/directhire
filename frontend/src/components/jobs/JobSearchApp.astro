          <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/70 text-xs text-slate-700 space-y-1.5">
            <div class="flex items-center gap-2 font-bold text-blue-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Verified Direct-to-Company ATS Listing</span>
