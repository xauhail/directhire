      <div class="w-full sm:w-[600px] md:w-[680px] bg-white shadow-2xl flex flex-col h-full relative z-10">
        <!-- Drawer Header -->
        <div class="flex items-start justify-between p-5 sm:p-6 border-b border-slate-200 bg-slate-50/90 gap-4 shrink-0">
          <div class="flex items-start gap-3.5 min-w-0 flex-1">
            <img
              id="details-company-logo"
              src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='80' fill='%230f172a'><rect width='80' height='80' rx='18'/></svg>"
              alt="Company Logo"
