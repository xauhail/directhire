  // Parse URL on init
  function parseUrlParams() {
    const params = new URLSearchParams(window.location.search);
    currentTitle = params.get("title") || params.get("query") || params.get("q") || "";
    if (searchInput) searchInput.value = currentTitle;

    isExactSearch = params.get("exact") === "true";
    if (exactToggle) exactToggle.checked = isExactSearch;

    // Categories
    activeCategories.clear();
    const catParam = params.get("categories") || params.get("category");
    if (catParam) {
      catParam.split(",").map(c => c.trim().toLowerCase()).filter(Boolean).forEach(c => activeCategories.add(c));
    }

    // Check slug from pathname: e.g. /job-search/finance-and-accounting
    const pathParts = window.location.pathname.split("/").filter(Boolean);
    if (pathParts[0] === "job-search" && pathParts[1] && pathParts[1] !== "all") {
      activeCategories.add(pathParts[1].toLowerCase());
    }

    // Countries
    activeCountries.clear();
    const countryParam = params.get("countries") || params.get("country");
    if (countryParam) {
      countryParam.split(",").map(c => c.trim()).filter(Boolean).forEach(c => activeCountries.add(c));
    }

    // Remote
    activeRemote = params.get("remote") || params.get("workplace") || "";
    if (params.get("isRemoteOnly") === "true") activeRemote = "remote-only";
    if (filterRemote) filterRemote.value = activeRemote;

    // Salary
    activeSalary = params.get("salary") || "";
    if (params.get("hasCompensation") === "true") activeSalary = "with-salary";
    if (filterSalary) filterSalary.value = activeSalary;

    // Date
    activeDate = params.get("daysAgo") || params.get("date") || "";
    if (filterDate) filterDate.value = activeDate;

    // Page
    currentPage = parseInt(params.get("page") || "1", 10);
  }

  // Update URL Query String with History API (No full page reload)
  function syncUrl() {
    const params = new URLSearchParams();
    if (currentTitle) params.set("title", currentTitle);
    if (activeCategories.size > 0) {
      params.set("categories", Array.from(activeCategories).join(","));
    }
    if (activeCountries.size > 0) {
      params.set("countries", Array.from(activeCountries).join(","));
    }
    if (activeRemote === "remote-only") {
      params.set("isRemoteOnly", "true");
    } else if (activeRemote) {
      params.set("remote", activeRemote);
    }
    if (activeSalary === "with-salary") {
      params.set("hasCompensation", "true");
    } else if (activeSalary) {
      params.set("salaryMinimum", activeSalary);
    }
    if (activeDate) params.set("daysAgo", activeDate);
    if (currentPage > 1) params.set("page", String(currentPage));
    if (isExactSearch) params.set("exact", "true");

    const qs = params.toString();
    const currentPath = window.location.pathname;
    const targetPath = currentPath.startsWith("/job-search") ? currentPath : "/job-search/all";
    const newUrl = qs ? `${targetPath}?${qs}` : targetPath;
    
    if (window.location.pathname + window.location.search !== newUrl) {
      window.history.pushState({ page: currentPage }, "", newUrl);
    }
  }

