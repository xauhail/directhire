<script>
  import { searchJobs } from "../../lib/api.js";
  import { authClient } from "../../lib/auth-client.js";

  // Auth State Detector
  function getAuthState() {
    const token = localStorage.getItem("ch_token");
    const userJson = localStorage.getItem("ch_user");
    let user: any = null;
    if (userJson) {
      try { user = JSON.parse(userJson); } catch (_) {}
    }
    const isLoggedIn = !!(token || user);
    const isSubscribed = !!(user?.isSubscribed || (user?.plan && user?.plan !== "free"));
    return { isLoggedIn, isSubscribed, user };
  }

  // Auth Gate Modal helpers
  const authGateModal = document.getElementById("auth-gate-modal");
  const authGateReason = document.getElementById("auth-gate-reason");
  const btnCloseAuthGate = document.getElementById("btn-close-auth-gate");

  function openAuthGateModal(reason?: string) {
    if (authGateReason && reason) {
      authGateReason.textContent = reason;
    }
    if (authGateModal) {
      authGateModal.classList.remove("hidden");
    }
  }

  function closeAuthGateModal() {
    if (authGateModal) {
      authGateModal.classList.add("hidden");
