    const jobUrl = activeDetailsJob.applicationUrl?.startsWith("http") ? activeDetailsJob.applicationUrl : window.location.href;
    const shareData = {
      title: `${activeDetailsJob.title} at ${activeDetailsJob.company?.name || 'Direct Employer'}`,
      text: `Check out this verified opening: ${activeDetailsJob.title}`,
      url: jobUrl,
    };
    if (navigator.share) {
      try {
        await navigator.share(shareData);
        return;
      } catch (err) {}
    }
    if (navigator.clipboard) {
      await navigator.clipboard.writeText(jobUrl);
      showToast("Job link copied to clipboard!", false);
    }
  });

