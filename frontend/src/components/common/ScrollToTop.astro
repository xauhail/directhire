---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<!-- Floating Circular Interactive Scroll-To-Top Button -->
<div
  id="scroll-to-top-container"
  class={`fixed bottom-6 right-6 z-40 opacity-0 pointer-events-none translate-y-4 transition-all duration-300 ease-out ${className}`}
>
  <button
    type="button"
    id="scroll-to-top-btn"
    class="relative w-12 h-12 rounded-full flex items-center justify-center bg-white/95 hover:bg-white text-slate-700 hover:text-blue-600 shadow-lg shadow-slate-900/10 hover:shadow-xl hover:shadow-blue-500/20 border border-slate-200/90 hover:border-blue-300 backdrop-blur-md cursor-pointer group hover:scale-110 active:scale-95 transition-all duration-200 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
    aria-label="Scroll to top of page"
  >
    <!-- SVG Circular Scroll Progress Ring -->
    <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 48 48">
      <!-- Background Track Circle -->
      <circle
        cx="24"
        cy="24"
        r="20"
        fill="none"
        stroke="currentColor"
        class="text-slate-100"
        stroke-width="2.5"
      />
      <!-- Dynamic Progress Stroke -->
      <circle
        id="scroll-progress-ring"
        cx="24"
        cy="24"
        r="20"
        fill="none"
        stroke="url(#scroll-gradient)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-dasharray="125.66"
        stroke-dashoffset="125.66"
        class="transition-[stroke-dashoffset] duration-150 ease-out"
      />
      <!-- Gradient Definition -->
      <defs>
        <linearGradient id="scroll-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#2563eb" />
        </linearGradient>
      </defs>
    </svg>

    <!-- Upward Arrow Icon with Hover Bounce -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="relative z-10 transition-transform duration-200 group-hover:-translate-y-1 text-slate-700 group-hover:text-blue-600"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>

    <!-- Hover Tooltip -->
    <span
      class="absolute -top-9 left-1/2 -translate-x-1/2 px-2.5 py-1 rounded-md bg-slate-900 text-white text-[11px] font-semibold tracking-wide whitespace-nowrap shadow-lg border border-slate-800 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none"
    >
      Top
      <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></span>
    </span>
  </button>
</div>

<script>
  function setupScrollToTop() {
    const container = document.getElementById("scroll-to-top-container");
    const btn = document.getElementById("scroll-to-top-btn");
    const progressRing = document.getElementById("scroll-progress-ring") as SVGCircleElement | null;
    if (!container || !btn) return;

    const circumference = 2 * Math.PI * 20; // ~125.66
    let ticking = false;

    function updateScrollState() {
      const scrollY = window.scrollY;
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;

      // Visibility toggle (show after 250px)
      if (scrollY > 250) {
        container?.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
        container?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      } else {
        container?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
        container?.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      }

      // Update circular progress fill
      if (progressRing && scrollHeight > 0) {
        const progress = Math.min(Math.max(scrollY / scrollHeight, 0), 1);
        const offset = circumference - progress * circumference;
        progressRing.style.strokeDashoffset = String(offset);
      }

      ticking = false;
    }

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollState);
          ticking = true;
        }
      },
      { passive: true }
    );

    btn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });

    // Check initial position on mount
    updateScrollState();
  }

  setupScrollToTop();
  document.addEventListener("astro:page-load", setupScrollToTop);
</script>
