---
interface Props {
  variant?: 'light' | 'transparent';
}

const { variant = 'light' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class={`w-full z-40 transition-all ${variant === 'transparent' ? 'bg-transparent text-white' : 'bg-white border-b border-slate-200 text-slate-900'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dog">
            <path d="M11.25 16.25h1.5L12 17z"></path>
            <path d="M16 14v.5"></path>
            <path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309"></path>
            <path d="M8 14v.5"></path>
            <path d="M8.5 8.5c-.384 1.05-1.083 2.028-2.344 2.5-1.931.722-3.576-.297-3.656-1-.113-.994 1.177-6.53 4-7 1.923-.321 3.651.845 3.651 2.235A7.497 7.497 0 0 1 14 5.277c0-1.39 1.844-2.598 3.767-2.277 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.855-1.45-2.239-2.5"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-extrabold tracking-tight">Career Hound</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a 
          href="/job-search/all" 
          class={`transition-colors hover:text-blue-600 ${currentPath.startsWith('/job-search') || currentPath === '/search' ? 'text-blue-600 font-semibold' : ''}`}
        >
          Search Jobs
        </a>
        
        <a 
          href="/tools" 
          class={`flex items-center gap-1.5 transition-colors hover:text-blue-600 ${currentPath.startsWith('/tools') ? 'text-blue-600 font-semibold' : ''}`}
        >
          <span>Free Tools</span>
          <span class="text-[10px] uppercase font-bold bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded-full border border-amber-200">Free</span>
        </a>

        <a 
          href="/pricing" 
          class={`transition-colors hover:text-blue-600 ${currentPath === '/pricing' ? 'text-blue-600 font-semibold' : ''}`}
        >
          Pricing
        </a>

        <a 
          href="/contact" 
          class={`transition-colors hover:text-blue-600 ${currentPath === '/contact' ? 'text-blue-600 font-semibold' : ''}`}
        >
          Contact
        </a>
      </nav>

      <!-- CTA Actions -->
      <div class="flex items-center gap-3">

        <!-- Guest state (default, swapped by JS if logged in) -->
        <div id="header-guest" class="flex items-center gap-3">
          <a 
            href="/onboarding" 
            class="hidden sm:inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs md:text-sm font-bold rounded-full bg-blue-600 text-white hover:bg-blue-700 shadow-sm hover:shadow transition-all"
          >
            <span>Get Started</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a 
            href="/login" 
            class={`text-sm font-semibold px-3 py-1.5 rounded-md hover:opacity-80 transition-opacity ${variant === 'transparent' ? 'border border-white/40 text-white' : 'text-slate-700 hover:text-blue-600'}`}
          >
            Sign In
          </a>
        </div>

        <!-- Auth state (shown by JS when logged in) -->
        <div id="header-auth" class="hidden items-center gap-3 relative">
          <!-- Account avatar + dropdown trigger -->
          <button
            id="header-avatar-btn"
            type="button"
            class="flex items-center gap-2 group focus:outline-none"
            aria-label="Account menu"
          >
            <div id="header-avatar" class="w-9 h-9 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white text-sm font-black ring-2 ring-white shadow-sm group-hover:ring-blue-400 transition-all">
              U
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 group-hover:text-slate-600 transition-colors">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <!-- Dropdown menu -->
          <div
            id="header-dropdown"
            class="hidden absolute right-0 top-12 w-60 bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden z-50"
          >
            <!-- User info header -->
            <div class="px-4 py-3 border-b border-slate-100 bg-slate-50">
              <p id="dropdown-name" class="text-sm font-extrabold text-slate-900 truncate">Loading...</p>
              <p id="dropdown-email" class="text-xs text-slate-500 truncate mt-0.5"></p>
              <span id="dropdown-plan" class="inline-flex mt-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">Free</span>
            </div>
            <!-- Menu links -->
            <div class="py-1">
              <a href="/account" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 font-medium transition-colors">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                My Applications
              </a>
              <a href="/job-search/all?saved=true" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 font-medium transition-colors">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                <span>Saved Jobs</span>
              </a>
              <a href="/account#profile" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 font-medium transition-colors">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Profile & Resume
              </a>
              <a href="/account#subscription" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 font-medium transition-colors">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                Subscription
              </a>
              <a href="/job-search/all" class="flex items-center gap-3 px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 font-medium transition-colors">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                Search Jobs
              </a>
            </div>
            <div class="py-1 border-t border-slate-100">
              <button
                type="button"
                id="header-logout-btn"
                class="flex items-center gap-3 w-full px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 font-medium transition-colors text-left"
              >
                <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                Sign Out
              </button>
            </div>
          </div>
        </div>

        <!-- Mobile Menu Toggle -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="md:hidden p-2 text-slate-600 hover:text-slate-900 rounded-md focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-2 text-slate-900">
    <a href="/job-search/all" class="block px-3 py-2 rounded-md font-medium hover:bg-slate-50">Search Jobs</a>
    <a href="/tools" class="flex items-center justify-between px-3 py-2 rounded-md font-medium hover:bg-slate-50">
      <span>Free Growth Tools</span>
      <span class="text-[10px] font-bold bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded">Free</span>
    </a>
    <a href="/pricing" class="block px-3 py-2 rounded-md font-medium hover:bg-slate-50">Pricing & Plans</a>
    <a href="/contact" class="block px-3 py-2 rounded-md font-medium hover:bg-slate-50">Contact Us</a>
    <div id="mobile-auth-links" class="pt-2 space-y-2">
      <!-- Filled by JS -->
      <a href="/onboarding" class="block w-full text-center py-2.5 px-4 font-bold text-sm bg-blue-600 text-white rounded-lg shadow">Get Started</a>
      <a href="/login" class="block w-full text-center py-2.5 px-4 font-bold text-sm border border-slate-200 text-slate-700 rounded-lg">Sign In</a>
    </div>
  </div>
</header>

<script>
  import { authClient } from '../../lib/auth-client.js';

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => menu.classList.toggle('hidden'));
  }

  // Avatar dropdown toggle
  const avatarBtn = document.getElementById('header-avatar-btn');
  const dropdown = document.getElementById('header-dropdown');
  if (avatarBtn && dropdown) {
    avatarBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });
    document.addEventListener('click', () => dropdown.classList.add('hidden'));
  }

  // Logout
  async function doLogout() {
    try { await authClient.signOut(); } catch (_) {}
    localStorage.removeItem('ch_token');
    localStorage.removeItem('ch_user');
    localStorage.removeItem('ch_authenticated');
    window.location.href = '/login';
  }

  document.getElementById('header-logout-btn')?.addEventListener('click', doLogout);

  // Auth state detection
  const token = localStorage.getItem('ch_token');
  const userJson = localStorage.getItem('ch_user');

  const headerGuest = document.getElementById('header-guest');
  const headerAuth = document.getElementById('header-auth');
  const headerAvatar = document.getElementById('header-avatar');
  const dropdownName = document.getElementById('dropdown-name');
  const dropdownEmail = document.getElementById('dropdown-email');
  const dropdownPlan = document.getElementById('dropdown-plan');
  const mobileAuthLinks = document.getElementById('mobile-auth-links');

  if (token && userJson) {
    const user = JSON.parse(userJson);
    const initials = (user.name || 'U').split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
    const isSubscribed = user.isSubscribed || (user.plan && user.plan !== 'free');
    const planLabel = isSubscribed ? (user.plan === 'pro_monthly' ? 'Pro Monthly' : 'Pro') : 'Free';

    // Swap guest → auth
    if (headerGuest) headerGuest.classList.add('hidden');
    if (headerAuth) headerAuth.classList.remove('hidden');
    if (headerAuth) headerAuth.style.display = 'flex';

    // Fill avatar + dropdown
    if (headerAvatar) headerAvatar.textContent = initials;
    if (dropdownName) dropdownName.textContent = user.name || 'Account';
    if (dropdownEmail) dropdownEmail.textContent = user.email || '';
    if (dropdownPlan) {
      dropdownPlan.textContent = isSubscribed ? planLabel : 'Free';
      if (isSubscribed) dropdownPlan.className = 'inline-flex mt-1.5 text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700';
    }

    // Mobile: swap links
    if (mobileAuthLinks) {
      mobileAuthLinks.innerHTML = `
        <a href="/account" class="block w-full text-center py-2.5 px-4 font-bold text-sm bg-blue-600 text-white rounded-lg shadow">My Account</a>
        <button id="mobile-logout" type="button" class="block w-full text-center py-2.5 px-4 font-bold text-sm border border-slate-200 text-red-600 rounded-lg">Sign Out</button>
      `;
      document.getElementById('mobile-logout')?.addEventListener('click', () => {
        localStorage.removeItem('ch_token');
        localStorage.removeItem('ch_user');
        window.location.href = '/login';
      });
    }
  }
</script>
