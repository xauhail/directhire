---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Column 1: Brand & Story -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11.25 16.25h1.5L12 17z"></path>
              <path d="M16 14v.5"></path>
              <path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309"></path>
              <path d="M8 14v.5"></path>
              <path d="M8.5 8.5c-.384 1.05-1.083 2.028-2.344 2.5-1.931.722-3.576-.297-3.656-1-.113-.994 1.177-6.53 4-7 1.923-.321 3.651.845 3.651 2.235A7.497 7.497 0 0 1 14 5.277c0-1.39 1.844-2.598 3.767-2.277 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.855-1.45-2.239-2.5"></path>
            </svg>
          </div>
          <span class="text-xl font-extrabold tracking-tight text-white">Career Hound</span>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          We find jobs posted directly on company websites. Skip recruiter fees, 200+ applicant queues, and fake ghost jobs. Apply directly to hiring teams worldwide.
        </p>
        <div class="flex items-center gap-4 text-xs text-slate-400 pt-2">
          <span>Rated 4.9/5 by 8,573+ job seekers</span>
          <span>•</span>
          <span>4.5M+ hidden jobs indexed</span>
        </div>
      </div>

      <!-- Column 2: Job Search & Directory -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Job Board</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/job-search/all" class="hover:text-blue-400 transition-colors">Search All Jobs</a></li>
          <li><a href="/pricing" class="hover:text-blue-400 transition-colors font-semibold text-blue-300">Pricing & Plans</a></li>
          <li><a href="/onboarding" class="hover:text-blue-400 transition-colors">Personalized Job Match</a></li>
          <li><a href="/resumes" class="hover:text-blue-400 transition-colors">AI Resume Builder</a></li>
        </ul>
      </div>

      <!-- Column 3: Free Traffic Tools -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Free Tools</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/tools/ats-checker" class="hover:text-blue-400 transition-colors">Free ATS Resume Scanner</a></li>
          <li><a href="/tools/ghost-job-detector" class="hover:text-blue-400 transition-colors">Ghost Job Detector</a></li>
          <li><a href="/tools/recruiter-outreach" class="hover:text-blue-400 transition-colors">Recruiter Cold DM Generator</a></li>
          <li><a href="/tools/salary-calculator" class="hover:text-blue-400 transition-colors">Remote Salary Calculator</a></li>
          <li><a href="/tools" class="text-blue-400 font-semibold hover:underline">All Free Tools →</a></li>
        </ul>
      </div>

      <!-- Column 4: Legal & Social -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Connect & Legal</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/contact" class="hover:text-blue-400 font-semibold text-blue-300 transition-colors">Contact Us</a></li>
          <li><a href="/login" class="hover:text-blue-400 transition-colors">Sign In</a></li>
          <li><a href="/privacy-policy" class="hover:text-blue-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions" class="hover:text-blue-400 transition-colors">Terms & Conditions</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} Career Hound Inc. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/contact" class="hover:text-slate-300 transition-colors">Support & Contact</a>
        <a href="/privacy-policy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-slate-300 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
